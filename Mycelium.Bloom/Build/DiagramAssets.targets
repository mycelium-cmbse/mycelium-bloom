<Project>
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);**/node_modules/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <Content Remove="Build/DiagramAssets/**" />
    </ItemGroup>
    <Target Name="RegenerateDiagramAssets">
        <Exec Command="node Build/DiagramAssets/generate.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>
    <Target Name="VerifyDiagramAssets">
        <Exec Command="node Build/DiagramAssets/generate.mjs --verify" WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>
</Project>
