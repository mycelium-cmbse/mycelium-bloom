<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <AssemblyName>Mycelium.Bloom</AssemblyName>
        <RootNamespace>Mycelium.Bloom</RootNamespace>
        <LangVersion>14.0</LangVersion>
        <Company>Starion Group S.A.</Company>
        <Authors>Sam Gerene, Antoine Théate, Régis André, Tanase-Marius Manafu, Omrane Haj Mohamed</Authors>
        <Description>Mycelium Bloom web application for collaborative model-based systems engineering with SysML v2 support</Description>
        <Copyright>Copyright © Starion Group S.A.</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mycelium-cmbse/mycelium-bloom</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <Content Update="Resources\**\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="..\NOTICE" Link="NOTICE">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Components\Core\" />
        <Folder Include="Components\Features\Auth\" />
        <Folder Include="Components\Features\Dashboard\" />
        <Folder Include="Components\Features\Projects\" />
        <Folder Include="Components\UI\Shared\" />
        <Folder Include="Components\UI\Templates\" />
        <Folder Include="wwwroot\css\" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Blueprint Components 3.16.0 compatibility boundaries are deliberately narrow:
          SelectInput bridges verified keyboard, ARIA, and Tab-order limitations; SplitButton bridges the verified
          Enter-key limitation. TextArea and Checkbox remain native because Blueprint cannot preserve their required
          contracts. Direct Primitive TabsList and TabsTrigger use remains localized to the Design System.
          Bloom has no production Tooltip implementation because Escape dismissal and description relationships are
          incomplete. Reassess only these exceptions after upgrading Blueprint.
        -->
        <PackageReference Include="BlazorBlueprint.Components" Version="3.16.0" />
        <!--
          Intentionally direct: Bloom renders LucideIcon components in production markup and therefore compiles
          against this package's public API.
        -->
        <PackageReference Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />
        <PackageReference Include="DynamicData" Version="9.4.33" />
        <!-- Intentionally direct: selects reviewed HtmlSanitizer 9.2.1039 used with Blueprint Components, preserves the accepted AngleSharp resolution, and must be reassessed when either dependency is upgraded. -->
        <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
        <PackageReference Include="OpenTelemetry" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageReference Include="ReactiveUI.Blazor" Version="24.2.0" />
        <PackageReference Include="SysML2.NET.Dal" Version="0.23.0" />
        <PackageReference Include="SysML2.NET.Serializer.Json" Version="0.23.0" />
    </ItemGroup>

    <Target Name="BuildMyceliumStyles" BeforeTargets="PrepareForBuild"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(MyceliumCssPrebuilt)' != 'true'">
        <Exec Command="node Scripts/build-css.mjs"
              WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>

    <Target Name="VerifyMyceliumStyles" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildMyceliumStyles"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="!Exists('wwwroot/css/tokens.css') or !Exists('Styles/Generated/MyceliumTokens/theme.css') or !Exists('wwwroot/css/app.css')"
               Text="Generated Bloom styles are missing. Restore the checked-in token artifacts and run pnpm css:build before using MyceliumCssPrebuilt." />
        <ItemGroup>
            <Content Include="wwwroot\css\tokens.css;wwwroot\css\app.css" Exclude="@(Content)" />
        </ItemGroup>
    </Target>

</Project>
