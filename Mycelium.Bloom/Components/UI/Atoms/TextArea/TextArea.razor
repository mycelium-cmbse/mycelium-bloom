<div class="@(this.GetCssClass())">
    @if (this.HasLabel())
    {
        <label class="mb-text-area__label" for="@(this.GetTextAreaId())">
            <span>@(this.Label)</span>

            @if (this.Required)
            {
                <span class="mb-text-area__required" aria-hidden="true">*</span>
            }
        </label>
    }

    <textarea
        @attributes="this.AdditionalAttributes"
        id="@(this.GetTextAreaId())"
        name="@(this.GetTextAreaName())"
        class="mb-text-area__field"
        value="@(this.Value)"
        placeholder="@(this.Placeholder)"
        disabled="@(this.Disabled)"
        required="@(this.Required)"
        readonly="@(this.ReadOnly)"
        rows="@(this.Rows)"
        maxlength="@(this.GetMaxLength())"
        aria-invalid="@(this.GetAriaInvalid())"
        aria-describedby="@(this.GetDescriptionId())"
        @oninput="this.HandleInputAsync"></textarea>

    @if (this.HasFooter())
    {
        <div class="mb-text-area__footer">
            @if (this.HasError())
            {
                <p id="@(this.GetErrorId())" class="mb-text-area__error">
                    @(this.ErrorText)
                </p>
            }
            else if (this.HasHelpText())
            {
                <p id="@(this.GetHelpId())" class="mb-text-area__help">
                    @(this.HelpText)
                </p>
            }

            @if (this.ShouldShowCharacterCount())
            {
                <span id="@(this.GetCharacterCountId())" class="mb-text-area__count">
                    @(this.GetCurrentLength()) / @(this.MaxLength)
                </span>
            }
        </div>
    }
</div>
