@inherits BloomFieldComponentBase

<FieldShell
    ControlId="@(this.FieldId)"
    Label="@(this.Label)"
    HelpText="@(this.HelpText)"
    HelpTextId="@(this.HelpTextId)"
    ErrorText="@(this.ErrorText)"
    ErrorTextId="@(this.ErrorTextId)"
    Disabled="@(this.Disabled)"
    Required="@(this.Required)"
    ReadOnly="@(this.ReadOnly)"
    Class="@(this.GetCssClass())">
    <div class="mb-text-input__control mb-field-control mb-field-control--single-line">
        @if (this.LeadingContent is not null)
        {
            <span class="mb-text-input__leading">@(this.LeadingContent)</span>
        }

        <input
            @attributes="this.AdditionalAttributes"
            id="@(this.FieldId)"
            name="@(this.FieldName)"
            class="mb-text-input__field mb-field-control__native"
            type="@(this.GetInputType())"
            value="@(this.Value)"
            placeholder="@(this.Placeholder)"
            autocomplete="@(this.GetAutocomplete())"
            maxlength="@(this.GetMaxLength())"
            disabled="@(this.Disabled)"
            required="@(this.Required)"
            readonly="@(this.ReadOnly)"
            aria-invalid="@(this.AriaInvalid)"
            aria-describedby="@(this.DescribedBy)"
            @oninput="this.HandleInputAsync" />

        @if (this.TrailingContent is not null)
        {
            <span class="mb-text-input__trailing">@(this.TrailingContent)</span>
        }
    </div>
</FieldShell>
