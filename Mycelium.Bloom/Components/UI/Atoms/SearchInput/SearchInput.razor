@inherits BloomFieldComponentBase

@using BlazorBlueprint.Icons.Lucide.Components

@inject IJSRuntime JsRuntime

<div @ref="this.rootReference"
     id="@(this.TriggerContext?.TriggerId)"
     class="@(this.GetCssClass())">
    <BbInputGroup Class="mb-search-input__control">
        <BbInputGroupAddon
            Align="BlazorBlueprint.Components.InputGroupAlign.InlineStart"
            Class="mb-search-input__icon"
            aria-hidden="true">
            @if (this.StartIcon is not null)
            {
                @(this.StartIcon)
            }
            else
            {
                <LucideIcon Name="search"
                            Size="14"
                            StrokeWidth="1.75"
                            role="presentation"
                            aria-hidden="true"
                            focusable="false" />
            }
        </BbInputGroupAddon>

        @if (this.InlineContent is not null)
        {
            <CascadingValue
                TValue="BlazorBlueprint.Primitives.Utilities.TriggerContext"
                Value="@(default(BlazorBlueprint.Primitives.Utilities.TriggerContext))"
                Name="TriggerContext"
                IsFixed="true">
                <div class="mb-search-input__inline-content">
                    @(this.InlineContent)
                </div>
            </CascadingValue>
        }

        <BbInputGroupInput
            @ref="this.inputReference"
            @attributes="this.AdditionalAttributes"
            Id="@(this.FieldId)"
            Class="mb-search-input__field"
            Type="@(this.InputType)"
            Value="@(this.Value)"
            ValueChanged="this.HandleValueChangedAsync"
            Placeholder="@(this.Placeholder)"
            Disabled="@(this.Disabled)"
            AriaLabel="@(this.GetAccessibleName())"
            UpdateTiming="BlazorBlueprint.Components.UpdateTiming.Immediate"
            @onkeydown="this.HandleKeyDownAsync"
            @onfocus="this.GetFocusEventCallback()"
            @onblur="this.HandleBlurAsync" />

        @if (this.ShouldShowShortcut())
        {
            <BbInputGroupAddon
                Align="BlazorBlueprint.Components.InputGroupAlign.InlineEnd"
                Class="mb-search-input__shortcut-addon">
                <kbd class="mb-search-input__shortcut" aria-hidden="true">
                    @(this.ShortcutText)
                </kbd>
            </BbInputGroupAddon>
        }
    </BbInputGroup>
</div>
