@inherits BloomFieldComponentBase

@using BlazorBlueprint.Icons.Lucide.Components

@inject IJSRuntime JsRuntime

<div class="@(this.GetCssClass())">
    <BbInputGroup Class="mb-search-input__control">
        <BbInputGroupAddon
            Align="BlazorBlueprint.Components.InputGroupAlign.InlineStart"
            Class="mb-search-input__icon"
            aria-hidden="true">
            @if (this.StartIcon is not null)
            {
                @(this.StartIcon)
            }
            else
            {
                <LucideIcon Name="search"
                            Size="14"
                            StrokeWidth="1.75"
                            role="presentation"
                            aria-hidden="true"
                            focusable="false" />
            }
        </BbInputGroupAddon>

        <BbInputGroupInput
            @attributes="this.AdditionalAttributes"
            Id="@(this.FieldId)"
            Class="mb-search-input__field"
            Type="BlazorBlueprint.Components.InputType.Search"
            Value="@(this.Value)"
            ValueChanged="this.HandleValueChangedAsync"
            Placeholder="@(this.Placeholder)"
            Disabled="@(this.Disabled)"
            AriaLabel="@(this.GetAccessibleName())"
            UpdateTiming="BlazorBlueprint.Components.UpdateTiming.Immediate"
            @onkeydown="this.HandleKeyDownAsync" />

        @if (this.ShouldShowShortcut())
        {
            <BbInputGroupAddon
                Align="BlazorBlueprint.Components.InputGroupAlign.InlineEnd"
                Class="mb-search-input__shortcut-addon">
                <kbd class="mb-search-input__shortcut" aria-hidden="true">
                    @(this.ShortcutText)
                </kbd>
            </BbInputGroupAddon>
        }
    </BbInputGroup>
</div>
