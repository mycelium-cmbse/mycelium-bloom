@inherits BloomComponentBase

<label class="@(this.GetCssClass())" for="@(this.GetToggleId())">
    <input
        @attributes="this.AdditionalAttributes"
        id="@(this.GetToggleId())"
        name="@(this.GetToggleName())"
        class="mb-toggle__input"
        type="checkbox"
        role="switch"
        checked="@(this.Checked)"
        disabled="@(this.Disabled)"
        aria-checked="@(this.GetAriaChecked())"
        aria-describedby="@(this.GetDescriptionId())"
        @onchange="this.HandleCheckedChangedAsync" />

    <span class="mb-toggle__track" aria-hidden="true">
        <span class="mb-toggle__thumb"></span>
    </span>

    @if (this.ShouldShowStateText())
    {
        <span class="mb-toggle__state-text" aria-hidden="true">@(this.GetStateText())</span>
    }

    @if (this.HasContent())
    {
        <span class="mb-toggle__content">
            @if (this.HasLabel())
            {
                <span class="mb-toggle__label">@(this.Label)</span>
            }

            @if (this.HasDescription())
            {
                <span id="@(this.GetDescriptionId())" class="mb-toggle__description">@(this.Description)</span>
            }
        </span>
    }
</label>
