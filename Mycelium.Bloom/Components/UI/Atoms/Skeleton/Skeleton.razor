@inherits BloomComponentBase

<div class="@(this.GetCssClass())"
     aria-busy="true"
     aria-label="Loading content"
     @attributes="this.AdditionalAttributes">
    @for (var lineIndex = 0; lineIndex < this.GetLineCount(); lineIndex++)
    {
        <span class="mb-skeleton__item" style="@(this.GetItemStyle())" aria-hidden="true"></span>
    }
</div>
