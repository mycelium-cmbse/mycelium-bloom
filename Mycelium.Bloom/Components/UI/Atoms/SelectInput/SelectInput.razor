@using BlazorBlueprint.Primitives

@inherits BloomFieldComponentBase

<FieldShell
    ControlId="@(this.FieldId)"
    Label="@(this.Label)"
    HelpText="@(this.HelpText)"
    HelpTextId="@(this.HelpTextId)"
    ErrorText="@(this.ErrorText)"
    ErrorTextId="@(this.ErrorTextId)"
    Disabled="@(this.Disabled)"
    Required="@(this.Required)"
    Class="@(this.GetCssClass())">
    <div class="mb-select-input__control">
        <BlazorBlueprint.Primitives.Select.BbSelect TValue="string"
                  Value="@(this.Value)"
                  ValueChanged="this.HandleValueChangedAsync"
                  Open="@(this.IsOpen)"
                  OpenChanged="this.HandleOpenChanged"
                  Disabled="@(this.Disabled)"
                  Required="@(this.Required)"
                  DisplayTextSelector="this.GetDisplayTextForValue">
            <BlazorBlueprint.Primitives.Select.BbSelectTrigger
                @attributes="this.AdditionalAttributes"
                id="@(this.FieldId)"
                class="mb-select-input__trigger mb-field-control mb-field-control--single-line"
                aria-haspopup="listbox"
                aria-expanded="@(this.IsOpen ? "true" : "false")"
                aria-invalid="@(this.GetAriaInvalid())"
                aria-required="@(this.Required ? "true" : "false")"
                aria-describedby="@(this.DescribedBy)">
                <BlazorBlueprint.Primitives.Select.BbSelectValue Placeholder="@(this.Placeholder)"
                                                                 class="@(this.GetValueCssClass())"
                                                                 title="@(this.GetDisplayTextForValue(this.Value))" />
                <ChevronIcon Class="mb-select-input__chevron" />
            </BlazorBlueprint.Primitives.Select.BbSelectTrigger>

            <BlazorBlueprint.Primitives.Select.BbSelectContent class="mb-select-input__listbox"
                                                               Side="PopoverSide.Bottom"
                                                               Align="PopoverAlign.Start"
                                                               Offset="6"
                                                               MatchTriggerWidth="true">
                @foreach (var option in this.optionList)
                {
                    <BlazorBlueprint.Primitives.Select.BbSelectItem Value="@(option.Value)"
                                                                    Text="@(option.Label)"
                                                                    Disabled="@(option.Disabled)"
                                                                    class="mb-select-input__option"
                                                                    aria-selected="@(this.IsOptionSelected(option))"
                                                                    aria-disabled="@(option.Disabled ? "true" : null)">
                        <span class="mb-select-input__option-label" title="@(option.Label)">
                            @(option.Label)
                        </span>
                    </BlazorBlueprint.Primitives.Select.BbSelectItem>
                }
            </BlazorBlueprint.Primitives.Select.BbSelectContent>
        </BlazorBlueprint.Primitives.Select.BbSelect>

        @if (!this.Disabled && !string.IsNullOrWhiteSpace(this.FieldName))
        {
            <input id="@(this.GetFormValueId())"
                   type="hidden"
                   name="@(this.FieldName)"
                   value="@(this.Value)" />
        }
    </div>
</FieldShell>
