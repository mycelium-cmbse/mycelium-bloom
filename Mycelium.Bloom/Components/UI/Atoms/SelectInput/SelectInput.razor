@inherits BloomFieldComponentBase

@inject IJSRuntime JsRuntime

<FieldShell
    ControlId="@(this.FieldId)"
    Label="@(this.Label)"
    HelpText="@(this.HelpText)"
    HelpTextId="@(this.HelpTextId)"
    ErrorText="@(this.ErrorText)"
    ErrorTextId="@(this.ErrorTextId)"
    Disabled="@(this.Disabled)"
    Required="@(this.Required)"
    Class="@(this.GetCssClass())">
    <div @ref="this.popupRootElement" class="mb-select-input__control">
        <button
            @ref="this.triggerElement"
            @attributes="this.AdditionalAttributes"
            id="@(this.FieldId)"
            type="button"
            class="mb-select-input__trigger mb-field-control mb-field-control--single-line"
            disabled="@(this.Disabled)"
            role="combobox"
            aria-haspopup="listbox"
            aria-expanded="@(this.IsOpen ? "true" : "false")"
            aria-controls="@(this.ListboxId)"
            aria-activedescendant="@(this.GetActiveOptionId())"
            aria-invalid="@(this.GetAriaInvalid())"
            aria-required="@(this.Required ? "true" : "false")"
            aria-describedby="@(this.DescribedBy)"
            @onclick="this.ToggleMenu"
            @onkeydown="this.HandleKeyDownAsync">
            <span class="@(this.GetValueCssClass())" title="@(this.GetDisplayText())">
                @(this.GetDisplayText())
            </span>

            <ChevronIcon Class="mb-select-input__chevron" />
        </button>

        @if (this.IsOpen)
        {
            <div id="@(this.ListboxId)"
                 class="mb-select-input__listbox"
                 role="listbox"
                 aria-labelledby="@(this.FieldId)">
                @for (var index = 0; index < this.optionList.Count; index++)
                {
                    var optionIndex = index;
                    var option = this.optionList[optionIndex];

                    <button id="@(this.GetOptionId(optionIndex))"
                            type="button"
                            class="@(this.GetOptionCssClass(optionIndex))"
                            role="option"
                            aria-selected="@(this.IsSelected(option) ? "true" : "false")"
                            aria-disabled="@(option.Disabled ? "true" : "false")"
                            disabled="@(option.Disabled)"
                            tabindex="-1"
                            @onclick="() => this.SelectOptionAsync(optionIndex)">
                        <span class="mb-select-input__option-label" title="@(option.Label)">@(option.Label)</span>
                    </button>
                }
            </div>
        }

        @if (!this.Disabled && !string.IsNullOrWhiteSpace(this.FieldName))
        {
            <input id="@(this.GetFormValueId())"
                   type="hidden"
                   name="@(this.FieldName)"
                   value="@(this.Value)" />
        }
    </div>
</FieldShell>
