<button
    type="@(this.Type)"
    class="@(this.GetCssClass())"
    disabled="@(this.Disabled)"
    aria-label="@(this.AriaLabel)"
    title="@(this.Title)"
    @onclick="this.OnClick"
    @attributes="this.AdditionalAttributes">

    @(this.ChildContent)
</button>
