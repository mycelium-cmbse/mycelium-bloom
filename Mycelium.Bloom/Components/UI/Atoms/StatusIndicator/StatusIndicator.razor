<span class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    <span class="mb-status-indicator__dot" aria-hidden="true"></span>

    @if (this.ShowLabel)
    {
        <span class="mb-status-indicator__label">
            @(this.Label)
        </span>
    }
</span>
