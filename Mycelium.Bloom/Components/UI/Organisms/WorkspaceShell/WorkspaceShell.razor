@inherits BloomComponentBase

<section @attributes="this.AdditionalAttributes"
         @ref="this.rootElement"
         class="@(this.GetCssClass())"
         aria-label="@(this.AriaLabel)"
         data-navigation-collapsed="@(this.LeftPanelCollapsed ? "true" : "false")">
    @if (this.Header is not null)
    {
        <div class="mb-workspace-shell__header" role="region" aria-label="@(this.HeaderAriaLabel)">
            @(this.Header)
        </div>
    }

    @if (this.ShouldRenderPaneSwitcher())
    {
        <div class="mb-workspace-shell__pane-switcher"
             role="group"
             aria-label="Workspace regions">
            @if (this.ShouldRenderLeftPanel())
            {
                <button type="button"
                        class="@(this.GetPaneButtonCssClass(NarrowPane.Left))"
                        aria-pressed="@(this.GetPaneAriaPressed(NarrowPane.Left))"
                        aria-controls="@(this.leftPanelId)"
                        @onclick="() => this.SelectNarrowPane(NarrowPane.Left)">
                    @(this.CompactLeftPanelLabel)
                </button>
            }

            <button type="button"
                    class="@(this.GetPaneButtonCssClass(NarrowPane.Main))"
                    aria-pressed="@(this.GetPaneAriaPressed(NarrowPane.Main))"
                    aria-controls="@(this.mainContentId)"
                    @onclick="() => this.SelectNarrowPane(NarrowPane.Main)">
                @(this.CompactMainContentLabel)
            </button>

            @if (this.ShouldRenderRightPanel() && !this.RightPanelCollapsed)
            {
                <button type="button"
                        class="@(this.GetPaneButtonCssClass(NarrowPane.Right))"
                        aria-pressed="@(this.GetPaneAriaPressed(NarrowPane.Right))"
                        aria-controls="@(this.rightPanelId)"
                        @onclick="() => this.SelectNarrowPane(NarrowPane.Right)">
                    @(this.CompactRightPanelLabel)
                </button>
            }
        </div>
    }

    <div class="mb-workspace-shell__body"
         style="@(this.RightPanelResizable ? FormattableString.Invariant($"--workspace-shell-preferred-right-width: {this.RightPanelWidth}px;") : null)">
        @if (this.ShouldRenderLeftPanel())
        {
            <aside id="@(this.leftPanelId)"
                   class="mb-workspace-shell__left-panel"
                   aria-label="@(this.LeftPanelAriaLabel)"
                   data-collapsed="@(this.LeftPanelCollapsed ? "true" : "false")"
                   data-narrow-active="@(this.GetPaneAriaPressed(NarrowPane.Left))">
                @(this.LeftPanel)
            </aside>
        }

        <div id="@(this.mainContentId)"
             class="mb-workspace-shell__main"
             role="region"
             tabindex="-1"
             aria-label="@(this.MainContentAriaLabel)"
             data-narrow-active="@(this.GetPaneAriaPressed(NarrowPane.Main))">
            @(this.MainContent)
        </div>

        @if (this.ShouldRenderRightPanel())
        {
            @if (this.RightPanelResizable && !this.RightPanelCollapsed)
            {
                <div class="mb-workspace-shell__right-splitter"
                     role="separator" tabindex="0"
                     data-testid="workspace-right-splitter"
                     aria-label="@this.RightPanelResizeLabel"
                     aria-orientation="vertical" aria-controls="@this.rightPanelId"
                     aria-valuemin="@this.RightPanelMinimumWidth" aria-valuemax="@this.RightPanelMaximumWidth"
                     aria-valuenow="@this.RightPanelWidth">
                </div>
            }
            <aside id="@(this.rightPanelId)"
                   class="mb-workspace-shell__right-panel"
                   aria-label="@(this.RightPanelAriaLabel)"
                   data-testid="@this.RightPanelTestId"
                   hidden="@this.RightPanelCollapsed"
                   inert="@(this.RightPanelCollapsed ? string.Empty : null)"
                   aria-hidden="@(this.RightPanelCollapsed ? "true" : "false")"
                   tabindex="-1"
                   data-narrow-active="@(this.GetPaneAriaPressed(NarrowPane.Right))">
                @(this.RightPanel)
            </aside>
        }
    </div>

    @if (this.StatusBar is not null)
    {
        <div class="mb-workspace-shell__status" role="region" aria-label="@(this.StatusBarAriaLabel)">
            @(this.StatusBar)
        </div>
    }

    @if (this.OverlayContent is not null)
    {
        <div class="mb-workspace-shell__overlay">
            @(this.OverlayContent)
        </div>
    }
</section>
