@inherits BloomComponentBase

<footer class="@(this.GetCssClass())" aria-label="@(this.AriaLabel)" @attributes="this.AdditionalAttributes">
    @if (this.LeadingContent is not null)
    {
        <div class="mb-status-bar__leading">
            @(this.LeadingContent)
        </div>
    }

    @if (this.ChildContent is not null)
    {
        <div class="mb-status-bar__content">
            @(this.ChildContent)
        </div>
    }

    @if (this.TrailingContent is not null)
    {
        <div class="mb-status-bar__trailing">
            @(this.TrailingContent)
        </div>
    }
</footer>
