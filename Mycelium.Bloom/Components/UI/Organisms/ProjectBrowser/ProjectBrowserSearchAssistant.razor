@using BlazorBlueprint.Icons.Lucide.Components

<div class="mb-project-browser-search-assistant">
    <BbPopover Open="@(this.IsOpen)"
               OpenChanged="this.HandleOpenChanged"
               Modal="false"
               RestoreFocusOnClose="false">
        <BbPopoverTrigger AsChild="true"
                          CustomClickHandling="true">
            <SearchInput
                @ref="this.searchInputReference"
                Value="@(this.draftSearchText)"
                ValueChanged="this.HandleDraftSearchTextChangedAsync"
                InputType="BlazorBlueprint.Components.InputType.Text"
                FullWidth="true"
                Placeholder="Search elements..."
                AriaLabel="Filter project browser by name or qualified name"
                EnableShortcut="false"
                ShowShortcut="false"
                ForwardTriggerKeyDown="false"
                ForwardTriggerFocus="false"
                OnBlur="this.HandleSearchBlurAsync"
                OnKeyDown="this.HandleSearchKeyDownAsync"
                role="combobox"
                aria-autocomplete="list"
                aria-haspopup="listbox"
                aria-expanded="@(this.IsOpen ? "true" : "false")"
                aria-controls="@(this.suggestionListId)"
                autocomplete="off"
                spellcheck="false">
                <InlineContent>
                    @if (this.HasCommittedCriteria())
                    {
                        <div class="mb-project-browser-search-assistant__criteria"
                             role="group"
                             aria-label="Active project browser search criteria">
                            @if (!string.IsNullOrWhiteSpace(this.CommittedFilterText))
                            {
                                <BbBadge Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                                         Class="mb-project-browser-search-assistant__criterion">
                                    <span class="mb-project-browser-search-assistant__criterion-label">
                                        Contains &quot;@(this.CommittedFilterText.Trim())&quot;
                                    </span>
                                    <BbButton
                                        Class="mb-project-browser-search-assistant__criterion-remove"
                                        Type="BlazorBlueprint.Components.ButtonType.Button"
                                        Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                        Size="BlazorBlueprint.Components.ButtonSize.Small"
                                        OnClick="this.HandleContainsRemovedAsync"
                                        title="@(this.GetContainsRemovalLabel())"
                                        aria-label="@(this.GetContainsRemovalLabel())">
                                        <LucideIcon Name="x"
                                                    Size="12"
                                                    StrokeWidth="2"
                                                    role="presentation"
                                                    aria-hidden="true"
                                                    focusable="false" />
                                    </BbButton>
                                </BbBadge>
                            }

                            @foreach (var elementKind in this.GetSelectedElementKinds())
                            {
                                <BbBadge @key="elementKind"
                                         Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                                         Class="mb-project-browser-search-assistant__criterion mb-project-browser-search-assistant__criterion--type">
                                    <span class="mb-project-browser-search-assistant__criterion-label">
                                        Type @(ProjectBrowser.GetElementKindLabel(elementKind))
                                    </span>
                                    <BbButton
                                        Class="mb-project-browser-search-assistant__criterion-remove"
                                        Type="BlazorBlueprint.Components.ButtonType.Button"
                                        Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                        Size="BlazorBlueprint.Components.ButtonSize.Small"
                                        OnClick="_ => this.HandleElementKindRemovedAsync(elementKind)"
                                        title="@(GetElementKindRemovalLabel(elementKind))"
                                        aria-label="@(GetElementKindRemovalLabel(elementKind))">
                                        <LucideIcon Name="x"
                                                    Size="12"
                                                    StrokeWidth="2"
                                                    role="presentation"
                                                    aria-hidden="true"
                                                    focusable="false" />
                                    </BbButton>
                                </BbBadge>
                            }
                        </div>
                    }
                </InlineContent>
            </SearchInput>
        </BbPopoverTrigger>

        <BbPopoverContent Class="mb-project-browser__search-assistant-popover"
                          Side="BlazorBlueprint.Primitives.PopoverSide.Bottom"
                          Align="BlazorBlueprint.Primitives.PopoverAlign.Start"
                          Offset="4"
                          MatchTriggerWidth="true"
                          CloseOnEscape="true"
                          CloseOnClickOutside="true"
                          OnEscapeKeyDown="this.HandleEscapeAsync"
                          role="region"
                          aria-label="Project browser search suggestions">
            <section class="mb-project-browser-search-assistant__surface"
                     aria-label="Search suggestions">
                <header class="mb-project-browser-search-assistant__header">
                    Search suggestions
                </header>

                <BbCommand Id="@(this.suggestionListId)"
                           Class="mb-project-browser-search-assistant__command"
                           SearchQuery="@(this.Query)"
                           FilterFunction="ProjectBrowserSearchSuggestionList.ShouldIncludeSuggestion"
                           CloseOnSelect="false"
                           aria-label="Search suggestions">
                    <ProjectBrowserSearchSuggestionList
                        @ref="this.suggestionListReference"
                        SelectedElementKinds="@(this.SelectedElementKinds)"
                        Query="@(this.Query)"
                        ElementKindOptions="@(this.ElementKindOptions)"
                        ContainsAccepted="this.HandleContainsAcceptedAsync"
                        ElementKindAccepted="this.HandleElementKindAcceptedAsync" />
                </BbCommand>
            </section>
        </BbPopoverContent>
    </BbPopover>
</div>
