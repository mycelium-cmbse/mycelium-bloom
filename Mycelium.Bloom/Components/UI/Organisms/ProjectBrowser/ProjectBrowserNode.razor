@inherits BloomReactiveComponentBase<ProjectBrowserNodeViewModel>
@using BlazorBlueprint.Icons.Lucide.Components

@if (this.ViewModel is { } viewModel)
{
    var nodePresentation = this.GetNodePresentation();

    <div @attributes="this.AdditionalAttributes"
         class="@(this.BuildRootCssClass("mb-project-browser-node"))"
         role="treeitem" aria-expanded="@(GetAriaExpanded(nodePresentation))"
         data-element-id="@viewModel.ElementId"
         aria-selected="@(this.GetAriaSelected())">
        <div class="mb-project-browser-node__line">
            <span class="mb-project-browser-node__indent" style="@(this.GetIndentStyle())" aria-hidden="true"></span>
            <button
                type="button"
                class="@(this.GetNodeCssClass())"
                title="@(this.GetTooltip())"
                @onclick="this.SelectNodeAsync">
                @if (nodePresentation.HasVisibleChildren)
                {
                    <span class="mb-project-browser-node__toggle"
                          data-expanded="@(nodePresentation.IsExpanded ? "true" : "false")"
                          aria-hidden="true"></span>
                }
                else
                {
                    <span class="mb-project-browser-node__toggle-spacer"></span>
                }

                @if (viewModel.Presentation.IconName is { } iconName)
                {
                    <span class="mb-project-browser-node__element-icon"
                          style="@($"--project-browser-node-icon: url('icons/project-browser/{iconName}.svg');")"
                          aria-hidden="true"></span>
                }
                else
                {
                    <span class="mb-project-browser-node__fallback-icon" aria-hidden="true">
                        <LucideIcon Name="file" Size="12" StrokeWidth="2" aria-hidden="true" focusable="false" />
                    </span>
                }

                <span class="mb-project-browser-node__title">
                    @(viewModel.DisplayName)
                </span>
                @if (viewModel.Multiplicity is { } multiplicity)
                {
                    <span class="mb-project-browser-node__multiplicity">@multiplicity</span>
                }
            </button>
        </div>

        @if (nodePresentation.IsExpanded)
        {
            <div class="mb-project-browser-node__children" role="group">
                @foreach (var child in nodePresentation.VisibleChildren)
                {
                    <ProjectBrowserNode
                        ViewModel="child"
                        SelectedNode="this.SelectedNode"
                        Depth="@(this.Depth + 1)"
                        FilterPresentation="this.FilterPresentation"
                        OnNodeSelected="this.OnNodeSelected"/>
                }
            </div>
        }
    </div>
}
