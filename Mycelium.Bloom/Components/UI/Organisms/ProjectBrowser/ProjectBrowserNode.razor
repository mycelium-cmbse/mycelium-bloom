@inherits BloomReactiveComponentBase<ProjectBrowserNodeViewModel>

@if (this.ViewModel is { } viewModel)
{
    <div @attributes="this.AdditionalAttributes"
         class="@(this.BuildRootCssClass("mb-project-browser-node"))"
         role="treeitem" aria-expanded="@(this.GetAriaExpanded())"
         aria-selected="@(this.GetAriaSelected())">
        <button
            type="button"
            class="@(this.GetNodeCssClass())"
            style="@(this.GetNodeStyle())"
            title="@(this.GetTooltip())"
            @onclick="this.SelectNodeAsync">
            <span class="mb-project-browser-node__indent" style="@(this.GetIndentStyle())"></span>

            @if (viewModel.HasChildren)
            {
                <span class="mb-project-browser-node__toggle" aria-hidden="true">
                    @(viewModel.IsExpanded ? "v" : ">")
                </span>
            }
            else
            {
                <span class="mb-project-browser-node__toggle-spacer"></span>
            }

            <span class="mb-project-browser-node__element-icon" aria-hidden="true"></span>

            @if (!string.IsNullOrWhiteSpace(this.GetStereotype()))
            {
                <span class="mb-project-browser-node__stereotype">
                    @(this.GetStereotype())
                </span>
            }

            <span class="mb-project-browser-node__title">
                @(viewModel.DisplayName)
            </span>
        </button>

        @if (viewModel.IsExpanded)
        {
            <div class="mb-project-browser-node__children" role="group">
                @foreach (var child in viewModel.Children)
                {
                    <ProjectBrowserNode
                        ViewModel="child"
                        Depth="@(this.Depth + 1)"
                        OnNodeSelected="this.OnNodeSelected"/>
                }
            </div>
        }
    </div>
}
