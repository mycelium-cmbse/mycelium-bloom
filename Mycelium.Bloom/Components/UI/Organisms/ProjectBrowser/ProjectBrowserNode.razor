@if (this.Node != null)
{
    <div class="mb-project-browser-node" role="treeitem" aria-expanded="@(this.GetAriaExpanded())"
         aria-selected="@(this.GetAriaSelected())">
        <TreeNode
            Title="@(this.Node.DisplayName)"
            Tooltip="@(this.GetTooltip())"
            Stereotype="@(this.GetStereotype())"
            IsActive="@(this.Node.IsSelected)"
            HasChildren="@(this.Node.HasChildren)"
            IsExpanded="@(this.Node.IsExpanded)"
            IndentLevel="@(this.Depth)"
            ElementColor="@(this.GetElementColor())"
            OnClick="this.SelectNodeAsync"/>

        @if (this.Node.IsExpanded)
        {
            <div class="mb-project-browser-node__children" role="group">
                @foreach (var child in this.Node.Children)
                {
                    <ProjectBrowserNode
                        Node="child"
                        ViewModel="this.ViewModel"
                        Depth="@(this.Depth + 1)"
                        OnStateChanged="this.OnStateChanged"
                        OnNodeSelected="this.OnNodeSelected"/>
                }
            </div>
        }
    </div>
}
