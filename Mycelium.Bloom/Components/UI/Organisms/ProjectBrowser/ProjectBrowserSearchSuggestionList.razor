@using BlazorBlueprint.Icons.Lucide.Components

<div class="mb-project-browser-search-suggestion-list" role="presentation">
    @if (!string.IsNullOrWhiteSpace(this.Query))
    {
        <BbCommandGroup Class="mb-project-browser-search-suggestion-list__group"
                        Heading="SEARCH">
            <BbCommandItem
                Class="mb-project-browser-search-suggestion-list__item"
                Value="@(ContainsSuggestionValue)"
                SearchText="@(this.Query)"
                OnSelect="this.ContainsAccepted">
                <span class="mb-project-browser-search-suggestion-list__item-icon"
                      aria-hidden="true">
                    <LucideIcon Name="search"
                                Size="14"
                                StrokeWidth="1.75"
                                role="presentation"
                                aria-hidden="true"
                                focusable="false" />
                </span>
                <span class="mb-project-browser-search-suggestion-list__item-label">
                    Contains &quot;@(this.Query)&quot;
                </span>
            </BbCommandItem>
        </BbCommandGroup>
    }

    <BbCommandGroup Class="mb-project-browser-search-suggestion-list__group"
                    Heading="TYPE">
        @foreach (var elementType in this.ElementTypeOptions)
        {
            var isSelected = this.SelectedElementTypes.Contains(elementType);

            <BbCommandItem
                @key="elementType"
                Class="@(GetTypeSuggestionCssClass(isSelected))"
                Value="@(GetTypeSuggestionValue(elementType))"
                SearchText="@(GetElementTypeSearchText(elementType))"
                OnSelect="() => this.ElementTypeAccepted.InvokeAsync(elementType)">
                <span class="mb-project-browser-search-suggestion-list__item-icon"
                      data-filter-selected="@(isSelected ? "true" : "false")"
                      aria-hidden="true">
                    @if (isSelected)
                    {
                        <LucideIcon Name="check"
                                    Size="14"
                                    StrokeWidth="2"
                                    role="presentation"
                                    aria-hidden="true"
                                    focusable="false" />
                    }
                    else
                    {
                        <LucideIcon Name="shapes"
                                    Size="13"
                                    StrokeWidth="1.75"
                                    role="presentation"
                                    aria-hidden="true"
                                    focusable="false" />
                    }
                </span>
                <span class="mb-project-browser-search-suggestion-list__item-label">
                    <span>Type:</span>
                    <span class="mb-project-browser-search-suggestion-list__kind-label">
                        @(ProjectBrowser.GetElementTypeLabel(elementType))
                    </span>
                    @if (isSelected)
                    {
                        <span class="sr-only">Selected type filter</span>
                    }
                </span>
            </BbCommandItem>
        }
    </BbCommandGroup>
</div>
