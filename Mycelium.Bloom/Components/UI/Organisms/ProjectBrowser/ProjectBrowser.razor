<div class="@(this.GetCssClass())" role="tree" aria-label="Project browser" @attributes="this.AdditionalAttributes">
    @if (this.ViewModel.RootNodes.Count == 0)
    {
        <div class="mb-project-browser__empty">
            No model elements available.
        </div>
    }
    else
    {
        @foreach (var node in this.ViewModel.RootNodes)
        {
            <ProjectBrowserNode
                Node="node"
                ViewModel="this.ViewModel"
                Depth="0"
                OnStateChanged="this.HandleStateChangedAsync"
                OnNodeSelected="this.HandleNodeSelectedAsync" />
        }
    }
</div>
