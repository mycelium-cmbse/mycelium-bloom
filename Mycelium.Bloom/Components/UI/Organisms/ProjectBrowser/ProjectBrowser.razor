@inherits BloomReactiveInjectableComponentBase<IProjectBrowserViewModel>

<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    @if (this.ShouldShowLoadingState())
    {
        <div class="mb-project-browser__tree">
            <div class="mb-project-browser__state" role="status" aria-live="polite">
                <strong class="mb-project-browser__state-title">
                    Loading Quantities model
                </strong>
                <p class="mb-project-browser__state-description">
                    Preparing the SysML project browser...
                </p>
            </div>
        </div>
    }
    else if (this.ShouldShowErrorState())
    {
        <div class="mb-project-browser__tree">
            <div class="mb-project-browser__state mb-project-browser__state--error" role="alert" aria-live="assertive">
                <strong class="mb-project-browser__state-title">
                    Unable to load project browser
                </strong>

                @if (!string.IsNullOrWhiteSpace(this.RequiredViewModel.ErrorMessage))
                {
                    <p class="mb-project-browser__state-description">
                        @(this.RequiredViewModel.ErrorMessage)
                    </p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="mb-project-browser__tree" role="tree" aria-label="Project browser">
            @if (this.RequiredViewModel.RootNodes.Count == 0)
            {
                <div class="mb-project-browser__empty">
                    No model elements available.
                </div>
            }
            else
            {
                @foreach (var node in this.RequiredViewModel.RootNodes)
                {
                    <ProjectBrowserNode
                        ViewModel="node"
                        Depth="0"
                        OnNodeSelected="this.HandleNodeSelectedAsync"/>
                }
            }
        </div>
    }
</div>
