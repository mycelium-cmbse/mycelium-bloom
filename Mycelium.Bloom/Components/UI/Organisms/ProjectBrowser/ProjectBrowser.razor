@inherits BloomReactiveComponentBase<IProjectBrowserViewModel>

@using BlazorBlueprint.Icons.Lucide.Components

<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    @if (this.ShouldShowLoadingState())
    {
        <div class="mb-project-browser__tree-viewport">
            <div class="mb-project-browser__tree">
                <div class="mb-project-browser__state" role="status" aria-live="polite">
                    <strong class="mb-project-browser__state-title">
                        Loading Quantities model
                    </strong>
                    <p class="mb-project-browser__state-description">
                        Preparing the SysML project browser...
                    </p>
                </div>
            </div>
        </div>
    }
    else if (this.ShouldShowErrorState())
    {
        <div class="mb-project-browser__tree-viewport">
            <div class="mb-project-browser__tree">
                <div class="mb-project-browser__state mb-project-browser__state--error" role="alert" aria-live="assertive">
                    <strong class="mb-project-browser__state-title">
                        Unable to load project browser
                    </strong>

                    @if (!string.IsNullOrWhiteSpace(this.RequiredViewModel.ErrorMessage))
                    {
                        <p class="mb-project-browser__state-description">
                            @(this.RequiredViewModel.ErrorMessage)
                        </p>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        var filterPresentation = this.RequiredViewModel.FilterPresentation;
        var visibleRootNodes = this.GetVisibleRootNodes(filterPresentation);

        var activeDrawerFilterCount = this.GetActiveDrawerFilterCount();

        <div class="mb-project-browser__toolbar"
             role="search"
             aria-label="Project browser filters">
            <div class="mb-project-browser__search">
                <ProjectBrowserSearchAssistant
                    CommittedFilterText="@(this.RequiredViewModel.FilterText)"
                    SelectedElementKinds="@(this.RequiredViewModel.SelectedElementKinds)"
                    ElementKindOptions="elementKindOptions"
                    IsOpen="@(this.isSearchAssistantOpen)"
                    DraftResetVersion="@(this.searchAssistantDraftResetVersion)"
                    IsOpenChanged="this.HandleSearchAssistantOpenChanged"
                    ContainsCommitted="this.HandleContainsCommittedAsync"
                    ContainsRemoved="this.HandleContainsRemovedAsync"
                    ElementKindToggled="this.HandleElementKindFilterToggledAsync" />
            </div>

            <div class="mb-project-browser__filter-trigger-host">
                <BbPopover Open="@(this.isFilterDrawerOpen)"
                           OpenChanged="this.HandleFilterDrawerOpenChanged"
                           RestoreFocusOnClose="true">
                    <BbPopoverTrigger AsChild="true"
                                      OnClick="this.HandleFilterDrawerTriggerClickAsync">
                        <BbButton
                            Class="mb-project-browser__filter-trigger"
                            Type="BlazorBlueprint.Components.ButtonType.Button"
                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                            Size="BlazorBlueprint.Components.ButtonSize.Small"
                            title="Open project browser filters"
                            aria-label="Open project browser filters"
                            data-filter-active="@(activeDrawerFilterCount > 0 ? "true" : "false")">
                            <LucideIcon Name="funnel"
                                        Size="15"
                                        StrokeWidth="1.75"
                                        role="presentation"
                                        aria-hidden="true"
                                        focusable="false" />

                            @if (activeDrawerFilterCount > 0)
                            {
                                <span class="mb-project-browser__filter-trigger-indicator"
                                      aria-hidden="true"></span>
                                <span class="sr-only">
                                    @(activeDrawerFilterCount) type filters active
                                </span>
                            }
                        </BbButton>
                    </BbPopoverTrigger>

                    <BbPopoverContent Class="mb-project-browser__filter-popover"
                                      Side="BlazorBlueprint.Primitives.PopoverSide.Bottom"
                                      Align="BlazorBlueprint.Primitives.PopoverAlign.End"
                                      Offset="6"
                                      MatchTriggerWidth="false"
                                      CloseOnEscape="true"
                                      CloseOnClickOutside="true"
                                      OnContentReady="this.HandleFilterDrawerContentReadyAsync"
                                      Role="dialog"
                                      aria-labelledby="@(this.filterDrawerHeadingId)">
                        <section @ref="this.filterDrawerReference"
                                 class="mb-project-browser__filter-drawer"
                                 tabindex="-1"
                                 aria-labelledby="@(this.filterDrawerHeadingId)">
                            <header class="mb-project-browser__filter-drawer-header">
                                <span class="mb-project-browser__filter-heading-dot"
                                      aria-hidden="true"></span>
                                <h2 id="@(this.filterDrawerHeadingId)"
                                    class="mb-project-browser__filter-drawer-title">
                                    FILTERS
                                </h2>

                                <span class="mb-project-browser__filter-heading-spacer"></span>

                                @if (activeDrawerFilterCount > 0)
                                {
                                    <span class="mb-project-browser__filter-active-count">
                                        @(activeDrawerFilterCount) active
                                    </span>
                                }

                                <BbButton
                                    Class="mb-project-browser__filter-close"
                                    Type="BlazorBlueprint.Components.ButtonType.Button"
                                    Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                    Size="BlazorBlueprint.Components.ButtonSize.Small"
                                    OnClick="this.HandleFilterDrawerCloseAsync"
                                    title="Close project browser filters"
                                    aria-label="Close project browser filters">
                                    <LucideIcon Name="x"
                                                Size="14"
                                                StrokeWidth="1.75"
                                                role="presentation"
                                                aria-hidden="true"
                                                focusable="false" />
                                </BbButton>
                            </header>

                            <div class="mb-project-browser__filter-view-label">
                                BROWSER VIEW
                            </div>

                            <div class="mb-project-browser__filter-drawer-body">
                                <section class="mb-project-browser__filter-section"
                                         aria-labelledby="@(this.typeFilterHeadingId)">
                                    <div class="mb-project-browser__filter-section-header">
                                        <h3 id="@(this.typeFilterHeadingId)"
                                            class="mb-project-browser__filter-section-title">
                                            TYPE
                                        </h3>
                                        <span class="mb-project-browser__filter-section-count">
                                            @(activeDrawerFilterCount) selected
                                        </span>
                                    </div>

                                    <div class="mb-project-browser__type-chips">
                                        @foreach (var elementKind in elementKindOptions)
                                        {
                                            var isSelected = this.IsElementKindSelected(elementKind);

                                            <BbButton
                                                Class="mb-project-browser__type-chip"
                                                Type="BlazorBlueprint.Components.ButtonType.Button"
                                                Variant="BlazorBlueprint.Components.ButtonVariant.Outline"
                                                Size="BlazorBlueprint.Components.ButtonSize.Small"
                                                OnClick="_ => this.HandleElementKindFilterToggledAsync(elementKind)"
                                                aria-pressed="@(isSelected ? "true" : "false")">
                                                @if (isSelected)
                                                {
                                                    <LucideIcon Name="check"
                                                                Size="12"
                                                                StrokeWidth="2"
                                                                role="presentation"
                                                                aria-hidden="true"
                                                                focusable="false" />
                                                }
                                                <span>@(GetElementKindLabel(elementKind))</span>
                                            </BbButton>
                                        }
                                    </div>
                                </section>
                            </div>

                            <footer class="mb-project-browser__filter-drawer-footer">
                                <BbButton
                                    Class="mb-project-browser__clear-all"
                                    Type="BlazorBlueprint.Components.ButtonType.Button"
                                    Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                    Size="BlazorBlueprint.Components.ButtonSize.Small"
                                    Disabled="@(!filterPresentation.IsActive)"
                                    OnClick="this.HandleClearFilterAsync">
                                    Clear all
                                </BbButton>
                            </footer>
                        </section>
                    </BbPopoverContent>
                </BbPopover>
            </div>
        </div>

        <div class="mb-project-browser__tree-viewport">
            <div class="mb-project-browser__tree" role="tree" aria-label="Project browser">
                @if (this.RequiredViewModel.RootNodes.Count == 0)
                {
                    <div class="mb-project-browser__empty">
                        No model elements available.
                    </div>
                }
                else if (filterPresentation.IsActive && visibleRootNodes.Count == 0)
                {
                    <div class="mb-project-browser__empty" role="status" aria-live="polite">
                        No model elements match the current filters.
                    </div>
                }
                else
                {
                    @foreach (var node in visibleRootNodes)
                    {
                        <ProjectBrowserNode
                            ViewModel="node"
                            Depth="0"
                            FilterPresentation="filterPresentation"
                            OnNodeSelected="this.HandleNodeSelectedAsync"/>
                    }
                }
            </div>
        </div>
    }
</div>
