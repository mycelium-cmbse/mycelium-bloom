<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    @if (this.Items.Count == 0)
    {
        <div class="mb-model-tree__empty">
            No model elements available.
        </div>
    }
    else
    {
        @(this.RenderItems(this.Items, 0))
    }
</div>
