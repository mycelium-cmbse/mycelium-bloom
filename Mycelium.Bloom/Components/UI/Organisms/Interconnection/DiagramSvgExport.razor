@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams
@using Blazor.Diagrams.Core.PathGenerators
@using Mycelium.Bloom.Model.Diagram
@implements IDisposable

<svg xmlns="http://www.w3.org/2000/svg" viewBox="@FormattableString.Invariant($"{this.Bounds.Left - 24} {this.Bounds.Top - 24} {this.Bounds.Width + 48} {this.Bounds.Height + 48}")"
     width="@FormattableString.Invariant($"{this.Bounds.Width + 48}")" height="@FormattableString.Invariant($"{this.Bounds.Height + 48}")">
    @foreach (var node in this.Nodes.OrderBy(node => node.Group is not null))
    {
        <g transform="@FormattableString.Invariant($"translate({node.Position.X} {node.Position.Y})")"><PartSvg Node="node" /></g>
    }
    @foreach (var link in this.Links)
    {
        <ConnectionSvg Link="link" Export="true" />
    }
</svg>

@code {
    private BlazorDiagram detached;

    /// <summary>Gets or sets a complete presentation for detached model creation.</summary>
    [Parameter] public DiagramPresentationState State { get; set; }

    /// <summary>Gets or sets all details fetched at the export's immutable source revision.</summary>
    [Parameter] public DiagramProjection Projection { get; set; }

    /// <summary>Builds export-only models without mounting the complete live diagram.</summary>
    protected override void OnParametersSet()
    {
        if (this.State is null || this.detached is not null) return;
        this.detached = new BlazorDiagram(registerDefaultBehaviors: false);
        this.detached.Options.Links.DefaultPathGenerator = new StraightPathGenerator();
        var alignments = Interconnection.GetPortAlignments(this.State);
        var nodes = new Dictionary<Guid, NodeModel>();
        foreach (var occurrence in this.State.Occurrences.OrderBy(node => node.ParentId.HasValue))
        {
            var part = this.Projection.Parts[occurrence.ElementId];
            if (string.IsNullOrEmpty(part.Name)) throw new InvalidDataException("Export requires complete model details.");
            var node = new DiagramNodeModel(occurrence, part);
            this.detached.Nodes.Add(node);
            nodes.Add(occurrence.Id, node);
            foreach (var port in part.Ports)
                node.AddPort(new PortModel(port.ElementId, node, alignments.GetValueOrDefault((occurrence.Id, port.ElementId), PortAlignment.Right), size: new Size(8, 8)) { Initialized = true });
            Interconnection.UpdatePorts(node);
        }
        foreach (var route in this.State.Routes)
        {
            var link = new DiagramLinkModel(route, this.Projection.Connections[route.ElementId],
                nodes[route.SourceId].Ports.Single(port => port.Id == route.SourcePortId),
                nodes[route.TargetId].Ports.Single(port => port.Id == route.TargetPortId));
            this.detached.Links.Add(link);
            link.Refresh();
        }
        this.Nodes = nodes.Values.ToArray();
        this.Links = this.detached.Links.Cast<BaseLinkModel>().ToArray();
        this.Bounds = this.Nodes.Select(node => node.GetBounds()).Concat(this.Links.Select(link => link.GetBounds()))
            .Where(bounds => bounds is not null).DefaultIfEmpty(Rectangle.Zero).Aggregate((left, right) => left.Union(right));
    }

    /// <summary>Releases the operation-owned graph after success or failed rendering.</summary>
    public void Dispose()
    {
        this.detached?.Links.Clear();
        this.detached?.Nodes.Clear();
        this.detached = null;
    }

    /// <summary>Gets or sets all occurrences, including unmounted nodes and containers.</summary>
    [Parameter] public NodeModel[] Nodes { get; set; }

    /// <summary>Gets or sets all connections with their model-space paths.</summary>
    [Parameter] public BaseLinkModel[] Links { get; set; }

    /// <summary>Gets or sets the complete presentation bounds.</summary>
    [Parameter] public Rectangle Bounds { get; set; }
}
