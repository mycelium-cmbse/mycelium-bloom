@using Blazor.Diagrams.Core.Models
@using BlazorBlueprint.Icons.Lucide.Components
@using SysML2.NET.Core.Core.Types


<g class="part-svg @(this.Node.Selected ? "part-svg--selected" : "")" data-element-id="@this.Part.ElementId">
    <title>@this.Part.Name</title>
    <rect class="part-svg__body" width="@SvgNumber(this.Node.Size.Width)" height="@SvgNumber(this.Node.Size.Height)" rx="6" />
    <path class="part-svg__header" d="@this.HeaderPath" />
    <svg x="8" y="4" width="12" height="12"><LucideIcon Name="component" Size="12" aria-hidden="true" /></svg>
    <text class="part-svg__kind" x="27" y="14">«part»</text>
    <text class="part-svg__name" x="8" y="32">@(string.IsNullOrEmpty(this.Part.Name) ? this.Part.DetailStatus ?? "Loading…" : this.Part.Name)</text>
    @for (var index = 0; index < this.Part.Attributes.Length; index++)
    {
        <g><text class="part-svg__attribute @(index == 0 ? "part-svg__attribute--leading" : "")" x="8" y="@(54 + index * 16)">@this.Part.Attributes[index]</text></g>
    }
    <rect class="part-svg__outline" width="@SvgNumber(this.Node.Size.Width)" height="@SvgNumber(this.Node.Size.Height)" rx="6" />
    @foreach (var port in this.Node.Ports)
    {
        var presentation = this.Part.Ports.Single(item => item.ElementId == port.Id);
        <g class="part-svg__port" data-port-id="@port.Id">
            <title>@presentation.Name</title>
            @if (presentation.Direction is { } direction && PortImages.TryGetValue(direction, out var image))
            {
                <image class="part-svg__port-direction" data-direction="@direction" href="@image"
                       x="@SvgNumber(port.MiddlePosition.X - this.Node.Position.X - 6)"
                       y="@SvgNumber(port.MiddlePosition.Y - this.Node.Position.Y - 6)" width="12" height="12" />
            }
            else
            {
                <rect x="@SvgNumber(port.Position.X - this.Node.Position.X)" y="@SvgNumber(port.Position.Y - this.Node.Position.Y)" width="8" height="8" />
            }
        </g>
    }
</g>

@code {
    private static readonly IReadOnlyDictionary<FeatureDirectionKind, string> PortImages =
        new Dictionary<FeatureDirectionKind, string>
        {
            [FeatureDirectionKind.In] = LoadPortImage("in"),
            [FeatureDirectionKind.Out] = LoadPortImage("out"),
            [FeatureDirectionKind.Inout] = LoadPortImage("inout")
        };

    /// <summary>Gets or sets the mounted library node.</summary>
    [Parameter] public NodeModel Node { get; set; }

    /// <summary>Gets the native node or container presentation.</summary>
    private Mycelium.Bloom.Model.Diagram.DiagramPart Part => this.Node switch
    {
        DiagramNodeModel node => node.Part,
        DiagramGroupModel group => group.Part,
        _ => throw new InvalidOperationException("Unsupported part renderer.")
    };

    /// <summary>Gets the header shape using model-space geometry.</summary>
    private string HeaderPath => FormattableString.Invariant(
        $"M6 0 H{this.Node.Size.Width - 6} Q{this.Node.Size.Width} 0 {this.Node.Size.Width} 6 V40 H0 V6 Q0 0 6 0");

    /// <summary>Formats native SVG scalar values independently of the circuit culture.</summary>
    private static string SvgNumber(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Embeds the approved glyph so rendered SVG has no external asset dependency.</summary>
    private static string LoadPortImage(string direction)
    {
        using var stream = typeof(PartSvg).Assembly.GetManifestResourceStream($"Mycelium.Bloom.Resources.Diagram.port-{direction}.svg")
            ?? throw new InvalidOperationException("Missing diagram port asset.");
        using var buffer = new MemoryStream();
        stream.CopyTo(buffer);
        return "data:image/svg+xml;base64," + Convert.ToBase64String(buffer.ToArray());
    }
}
