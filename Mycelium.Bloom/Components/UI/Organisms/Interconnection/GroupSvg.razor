@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Components.Renderers

<PartSvg Node="this.Group" />
<g transform="@string.Create(System.Globalization.CultureInfo.InvariantCulture, $"translate({-this.Group.Position.X} {-this.Group.Position.Y})")">
    @foreach (var child in this.Group.Children)
    {
        @if (child is GroupModel group)
        {
            <GroupRenderer @key="child.Id" Group="group" />
        }
        else
        {
            <NodeRenderer @key="child.Id" Node="child" />
        }
    }
</g>
