@using BlazorBlueprint.Primitives
@using Mycelium.Bloom.ViewModel.Organization
@inherits BloomReactiveInjectableComponentBase<IOrganizationHeaderViewModel>

@{
    RenderFragment organizationSegments =
        @<BbBreadcrumb Class="mb-crumbs" aria-label="Organization location"><BbBreadcrumbList>
            <BbBreadcrumbSeparator Class="mb-crumbs__separator">/</BbBreadcrumbSeparator>
            <BbBreadcrumbItem>
                <BbBreadcrumbLink Href="@(this.ViewModel.Presentation.OrganizationPath)" Class="mb-crumbs__crumb">
                    <LucideIcon Name="building-2" Size="12" StrokeWidth="1.75" role="presentation" aria-hidden="true" focusable="false" />
                    @(this.ViewModel.Presentation.OrganizationName)
                </BbBreadcrumbLink>
            </BbBreadcrumbItem>
            <BbBreadcrumbSeparator Class="mb-crumbs__separator">/</BbBreadcrumbSeparator>
            <BbBreadcrumbItem>
                <BbDropdownMenu>
                    <BbDropdownMenuTrigger AsChild="true">
                        <BbButton Variant="BlazorBlueprint.Components.ButtonVariant.Ghost" Class="mb-crumbs__crumb" aria-label="Organization section" title="Organization section">
                            <LucideIcon Name="@(this.ViewModel.Presentation.SectionIcon)" Size="12" StrokeWidth="1.75" role="presentation" aria-hidden="true" focusable="false" />
                            @(this.ViewModel.Presentation.SectionLabel)
                            <LucideIcon Name="chevron-down" Size="8" StrokeWidth="1.75" role="presentation" aria-hidden="true" focusable="false" />
                        </BbButton>
                    </BbDropdownMenuTrigger>
                    <BbDropdownMenuContent Class="mb-menu" Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Offset="6">
                        @foreach (var item in this.ViewModel.Presentation.SectionItems)
                        {
                            <BbDropdownMenuItem Href="@(item.Id)">
                                <LucideIcon Name="@(item.Icon)" Size="14" StrokeWidth="1.75" role="presentation" aria-hidden="true" focusable="false" />
                                @(item.Label)
                                @if (item.IsSelected)
                                {
                                    <span class="sr-only">Current page</span>
                                }
                            </BbDropdownMenuItem>
                        }
                    </BbDropdownMenuContent>
                </BbDropdownMenu>
            </BbBreadcrumbItem>
        </BbBreadcrumbList></BbBreadcrumb>;

    RenderFragment accountSegment =
        @<BbBreadcrumb Class="mb-crumbs" aria-label="Organization location"><BbBreadcrumbList>
            <BbBreadcrumbSeparator Class="mb-crumbs__separator">/</BbBreadcrumbSeparator>
            <BbBreadcrumbItem>
                <BbBreadcrumbPage Class="mb-crumbs__crumb">
                    <LucideIcon Name="user" Size="12" StrokeWidth="1.75" role="presentation" aria-hidden="true" focusable="false" />
                    Account
                </BbBreadcrumbPage>
            </BbBreadcrumbItem>
        </BbBreadcrumbList></BbBreadcrumb>;

    RenderFragment user =
        @<UserMenu DisplayName="@(this.ViewModel.Presentation.AccountName)"
                   Subtitle="@(this.ViewModel.Presentation.AccountEmail)"
                   Items="@(this.ViewModel.Presentation.AccountItems)"
                   ItemSelected="this.HandleItemSelectedAsync"
                   Compact="true" />;

    RenderFragment navigation = this.ViewModel.Presentation.Kind switch
    {
        OrganizationLocationKind.Organization => organizationSegments,
        OrganizationLocationKind.Account => accountSegment,
        _ => null
    };
}

<div class="mb-organization-header">
    <AppHeader Compact="true"
               AriaLabel="Bloom application header"
               NavigationAriaLabel="Page navigation"
               NavigationContent="@(navigation)"
               UserContent="@(this.ViewModel.Presentation.HasAccount ? user : null)">
        <BrandContent>
            <a class="mb-organization-header__brand" href="@(OrganizationRoutes.AccountPath)">
                <span class="mb-organization-header__mark"><BrandMark /></span>
                <span class="sr-only">Mycelium Bloom</span>
            </a>
        </BrandContent>
    </AppHeader>
</div>
