@using BlazorBlueprint.Icons.Lucide.Components
@using Mycelium.Bloom.Components.UI.Atoms.ProjectNameCell
@using Mycelium.Bloom.Components.UI.Atoms.StatusIndicator
@using Mycelium.Bloom.ViewModel.Organization
@inherits BloomReactiveComponentBase<IProjectsViewModel>

@{
    RenderFragment newProject =
        @<BbButton>
            <Icon>
                <LucideIcon Name="plus" Size="16" StrokeWidth="1.75" role="presentation" aria-hidden="true" focusable="false" />
            </Icon>
            <ChildContent>New project</ChildContent>
        </BbButton>;
}

@* The New project button does nothing yet: its dialog comes with a later issue. *@
<div class="@(this.BuildRootCssClass("mb-projects-view"))" @attributes="this.AdditionalAttributes">
    <PageHeader Title="Projects"
                Subtitle="@(this.ViewModel.Subtitle)"
                ActionsContent="@(this.ViewModel.CanCreateProject ? newProject : null)" />

    @* The filters stay while a reload fails, so that the user can change the search. *@
    @if (this.ViewModel.State is ProjectsListState.Ready or ProjectsListState.Error)
    {
        <div class="mb-projects-view__toolbar">
            <div class="mb-projects-view__search">
                <SearchInput @bind-Value="this.ViewModel.SearchText"
                             Id="projects-search"
                             Placeholder="Search projects…"
                             AriaLabel="Search projects"
                             ShowShortcut="false"
                             FullWidth="true" />
            </div>
            <ActionMenu IsSelectionMenu="true"
                        ShowChevron="true"
                        Items="@(this.ViewModel.StatusFilterItems)"
                        TriggerAriaLabel="@(this.ViewModel.StatusFilterLabel)"
                        TriggerTitle="Filter by status"
                        TriggerClass="mb-projects-view__filter"
                        ItemSelected="this.HandleStatusSelectedAsync">
                <TriggerContent>@(this.ViewModel.StatusFilterLabel)</TriggerContent>
            </ActionMenu>
            <ActionMenu IsSelectionMenu="true"
                        ShowChevron="true"
                        Items="@(this.ViewModel.ModeFilterItems)"
                        TriggerAriaLabel="@(this.ViewModel.ModeFilterLabel)"
                        TriggerTitle="Filter by mode"
                        TriggerClass="mb-projects-view__filter"
                        ItemSelected="this.HandleModeSelectedAsync">
                <TriggerContent>@(this.ViewModel.ModeFilterLabel)</TriggerContent>
            </ActionMenu>
        </div>
    }

    @switch (this.ViewModel.State)
    {
        case ProjectsListState.Loading:
            <div role="status" aria-live="polite" aria-busy="true">
                <BbSkeleton Width="100%" Height="320px" />
                <span class="sr-only">Loading</span>
            </div>
            break;
        case ProjectsListState.Ready:
            @* The table has no pager here: it shows every row of the page that the ViewModel asked for (at most 50), so its own page size follows the row count, and a page size of 0 is invalid. *@
            <BbDataTable TData="ProjectRowViewModel"
                         Data="@(this.ViewModel.Rows)"
                         ShowToolbar="false"
                         ShowPagination="false"
                         InitialPageSize="@(Math.Max(this.ViewModel.Rows.Count, 1))"
                         AriaLabel="Projects">
                <EmptyTemplate>
                    <BbEmpty Title="@(this.ViewModel.NoResultsTitle)"
                             Description="Clear the search, or widen the Status and Mode filters.">
                        <Icon>
                            <LucideIcon Name="search" Size="24" StrokeWidth="1.5" role="presentation" aria-hidden="true" focusable="false" />
                        </Icon>
                        <ChildContent>
                            <BbButton OnClick="this.HandleClearClickedAsync">Clear search and filters</BbButton>
                        </ChildContent>
                    </BbEmpty>
                </EmptyTemplate>
                <Columns>
                    <BbDataTableColumn TData="ProjectRowViewModel" TValue="string" Header="Project">
                        <CellTemplate>
                            <ProjectNameCell Name="@(context.Name)" Description="@(context.Description)" />
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ProjectRowViewModel" TValue="string" Header="Visibility">
                        <CellTemplate>
                            <span class="mb-projects-view__visibility">
                                <LucideIcon Name="@(context.VisibilityIcon)" Size="14" StrokeWidth="1.75" role="presentation" aria-hidden="true" focusable="false" />
                                @(context.VisibilityLabel)
                            </span>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ProjectRowViewModel" TValue="string" Header="Mode">
                        <CellTemplate>
                            <BbBadge Variant="BadgeVariant.Secondary"
                                     Class="@(context.IsConcurrentDesign ? "mb-projects-view__mode--concurrent" : string.Empty)">
                                @(context.ModeLabel)
                            </BbBadge>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ProjectRowViewModel" TValue="int" Header="Members" Property="@(row => row.MemberCount)" />
                    <BbDataTableColumn TData="ProjectRowViewModel" TValue="string" Header="Status">
                        <CellTemplate>
                            <StatusIndicator Label="@(context.StatusLabel)" State="@(context.LifecycleState)" />
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ProjectRowViewModel" TValue="string" Header="Updated" Property="@(row => row.UpdatedText)" CellClass="mb-projects-view__updated" />
                </Columns>
            </BbDataTable>

            <p class="mb-projects-view__showing" aria-live="polite">@(this.ViewModel.ShowingText)</p>
            break;
        case ProjectsListState.Empty:
            <BbEmpty Title="No projects yet"
                     Description="The projects of this organization will appear here.">
                <Icon>
                    <LucideIcon Name="folder-open" Size="24" StrokeWidth="1.5" role="presentation" aria-hidden="true" focusable="false" />
                </Icon>
                <ChildContent>
                    @(this.ViewModel.CanCreateProject ? newProject : null)
                </ChildContent>
            </BbEmpty>
            break;
        case ProjectsListState.Error:
            <p class="mb-projects-view__error" role="alert">@(this.ViewModel.ErrorMessage)</p>
            break;
    }
</div>
