<aside class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    <DetailPanelHeader
        Stereotype="@(this.Stereotype)"
        Title="@(this.Title)"
        QualifiedName="@(this.QualifiedName)"
        Owner="@(this.Owner)"
        OwnerColor="@(this.OwnerColor)"
        ShowCollapseButton="@(this.ShowCollapseButton)"
        OnCollapse="@(this.OnCollapse)"/>

    @if (this.Tabs.Count > 0)
    {
        <Tabs
            Items="@(this.Tabs)"
            ActiveValue="@(this.ActiveTab)"
            ActiveValueChanged="@(this.ActiveTabChanged)"
            FullWidth="true"/>
    }

    <div class="mb-detail-panel__content">
        @(this.ChildContent)
    </div>
</aside>
