@using BlazorBlueprint.Icons.Lucide.Components

@inherits BloomReactiveInjectableComponentBase<IElementSelectionService>

@{
    var presentation = this.GetPresentation();
}

<section class="@(this.GetCssClass())"
         aria-labelledby="@(this.headingId)"
         @attributes="this.AdditionalAttributes">
    <header class="mb-details-panel__header">
        <div class="mb-details-panel__heading-content">
            <h2 id="@(this.headingId)" class="mb-details-panel__title">
                Properties
            </h2>

            @if (presentation is not null)
            {
                <p class="mb-details-panel__element-name">
                    @(presentation.DisplayName)
                </p>
            }
        </div>

        @if (this.CloseRequested.HasDelegate)
        {
            <BbButton Type="BlazorBlueprint.Components.ButtonType.Button"
                      Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                      Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                      Class="mb-details-panel__close"
                      AriaLabel="Close details panel"
                      title="Close details panel"
                      OnClick="this.RequestCloseAsync">
                <LucideIcon Name="x"
                            Size="16"
                            StrokeWidth="1.75"
                            role="presentation"
                            aria-hidden="true"
                            focusable="false" />
            </BbButton>
        }
    </header>

    @if (presentation is null)
    {
        <p class="mb-details-panel__empty">
            Select an element to display its details.
        </p>
    }
    else
    {
        @foreach (var section in presentation.Sections)
        {
            <section class="mb-details-panel__section" aria-label="@section.Title">
                <h3 class="mb-details-panel__section-title">@section.Title</h3>
                @if (section.Properties.Count > 0)
                {
                    <dl class="mb-details-panel__properties">
                        @foreach (var property in section.Properties)
                        {
                            <div class="mb-details-panel__property">
                                <dt class="mb-details-panel__label">@property.Key</dt>
                                <dd class="mb-details-panel__value">@property.Value</dd>
                            </div>
                        }
                    </dl>
                }
                @foreach (var body in section.Paragraphs)
                {
                    <p class="mb-details-panel__documentation">@body</p>
                }
            </section>
        }
    }
</section>
