@using BlazorBlueprint.Icons.Lucide.Components
@using Mycelium.Bloom.ViewModel.DetailsPanel
@inherits BloomReactiveComponentBase<IDetailsPanelViewModel>

<section class="@(this.GetCssClass())" aria-labelledby="@(this.headingId)" @attributes="this.AdditionalAttributes">
    <header class="mb-details-panel__header">
        <span class="mb-details-panel__icon"><LucideIcon Name="align-left" Size="16" aria-hidden="true" /></span>
        <h2 id="@(this.headingId)" class="mb-details-panel__title">Properties</h2>
        @if (this.CloseRequested.HasDelegate)
        {
            <BbButton Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                      Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                      AriaLabel="Close Properties" title="Close Properties"
                      Class="mb-properties-close" data-testid="properties-close" OnClick="this.ClosePanel">
                <LucideIcon Name="x" Size="14" aria-hidden="true" />
            </BbButton>
        }
    </header>
    @if (this.ViewModel.Presentation is null)
    {
        <p class="mb-details-panel__empty">Select an element to display its details.</p>
    }
    else
    {
        <BbTabs Value="@this.activeTab" ValueChanged="this.ChangeTab" Class="mb-properties-tabs">
            <BbTabsList AriaLabel="Element detail sections" Class="mb-properties-tabs__list">
                @foreach (var tab in Tabs)
                {
                    <BbTabsTrigger Value="@tab" Class="mb-properties-tabs__trigger"
                                   aria-selected="@(this.activeTab == tab ? "true" : "false")">@tab</BbTabsTrigger>
                }
            </BbTabsList>
            @foreach (var tab in Tabs)
            {
                <BbTabsContent Value="@tab" Class="mb-properties-tabs__content">
                    @if (this.ViewModel.Presentation.ShowSelectionSummary)
                    {
                        <PropertiesSummary Presentation="this.ViewModel.Presentation" />
                    }
                    <PropertiesSections Sections="this.ViewModel.Presentation.DisplaySections" Tab="@tab"
                                        SelectedElement="this.ViewModel.Presentation.Element" InspectRequested="this.InspectElement" />
                </BbTabsContent>
            }
        </BbTabs>
        @if (this.ShowInBrowserRequested.HasDelegate)
        {
            <footer class="mb-details-panel__footer">
                <BbButton Size="BlazorBlueprint.Components.ButtonSize.Small" OnClick="this.ShowInBrowser">Show in Browser</BbButton>
            </footer>
        }
    }
</section>
