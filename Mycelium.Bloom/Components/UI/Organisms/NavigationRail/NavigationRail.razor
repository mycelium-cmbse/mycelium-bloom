@using BlazorBlueprint.Icons.Lucide.Components
@using BlazorBlueprint.Primitives
@using Mycelium.Bloom.ViewModel.NavigationRail

@inherits BloomReactiveComponentBase<INavigationRailViewModel>

@if (this.ViewModel is { } viewModel)
{
    <nav @attributes="this.AdditionalAttributes"
         class="@(this.GetCssClass())"
         aria-label="@(this.AriaLabel)"
         data-collapsed="@(this.IsVisuallyCollapsed ? "true" : "false")"
         data-layout-collapsed="@(this.IsLayoutCollapsed ? "true" : "false")"
         data-overlay-expanded="@(this.IsOverlayExpanded ? "true" : "false")"
         @onmouseenter="this.HandlePointerEntered"
         @onmouseleave="this.HandlePointerExited">
        <ul class="mb-navigation-rail__items">
            @for (var itemIndex = 0; itemIndex < viewModel.NavigationItems.Count; itemIndex++)
            {
                var item = viewModel.NavigationItems[itemIndex];

                @if (this.StartsNewGroup(itemIndex))
                {
                    var hasGroupLabel = !string.IsNullOrWhiteSpace(item.GroupLabel);

                    <li @key="(item.Id, true)"
                        class="@(hasGroupLabel
                                   ? "mb-navigation-rail__section-marker mb-navigation-rail__section-marker--named"
                                   : "mb-navigation-rail__section-marker")"
                        role="presentation">
                        <span class="mb-navigation-rail__divider" aria-hidden="true"></span>

                        @if (hasGroupLabel)
                        {
                            <span class="mb-navigation-rail__group-heading"
                                  aria-hidden="@(this.IsVisuallyCollapsed ? "true" : "false")">
                                <span class="mb-navigation-rail__group-heading-label"
                                      role="heading"
                                      aria-level="2">@(item.GroupLabel)</span>
                            </span>
                        }
                    </li>
                }

                <li @key="(item.Id, false)" class="mb-navigation-rail__item">
                    <BbButton Type="BlazorBlueprint.Components.ButtonType.Button"
                              Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                              Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                              Class="@(this.GetItemCssClass(item))"
                              AriaLabel="@(item.Label)"
                              title="@(this.GetItemTitle(item))"
                              aria-current="@(this.GetAriaCurrent(item))"
                              OnClick="() => this.SelectItem(item)">
                        <span class="mb-navigation-rail__icon-slot" aria-hidden="true">
                            <LucideIcon Name="@(item.IconName)"
                                        Size="16"
                                        StrokeWidth="1.75"
                                        Class="mb-navigation-rail__icon"
                                        role="presentation"
                                        aria-hidden="true"
                                        focusable="false" />
                        </span>
                        <span class="mb-navigation-rail__label">
                            <span class="mb-navigation-rail__label-text">@(item.Label)</span>
                        </span>
                    </BbButton>
                </li>
            }
        </ul>

        <div class="mb-navigation-rail__sidebar-control">
            <BbDropdownMenu Open="this.isSidebarControlMenuOpen"
                            OpenChanged="this.HandleSidebarControlMenuOpenChanged">
                <BbDropdownMenuTrigger AsChild="false"
                                       Class="mb-navigation-rail__collapse-toggle"
                                       aria-label="Navigation rail options"
                                       title="Navigation rail options">
                    <LucideIcon Name="@(this.IsLayoutCollapsed ? "panel-left-open" : "panel-left-close")"
                                Size="16"
                                StrokeWidth="1.75"
                                role="presentation"
                                aria-hidden="true"
                                focusable="false" />
                </BbDropdownMenuTrigger>

                <BbDropdownMenuContent Class="mb-navigation-rail__control-menu"
                                       Side="PopoverSide.Right"
                                       Align="PopoverAlign.End"
                                       Offset="4"
                                       Strategy="PositioningStrategy.Fixed">
                    <div class="mb-navigation-rail__control-menu-content">
                        <BbDropdownMenuLabel>Sidebar control</BbDropdownMenuLabel>

                        @foreach (var mode in PresentationModes)
                        {
                            <BbDropdownMenuItem Class="@(this.GetSidebarControlItemCssClass(mode))"
                                                CloseOnSelect="true"
                                                OnClick="_ => this.SetPresentationMode(mode)">
                                <Icon>
                                    <span class="mb-navigation-rail__control-selection" aria-hidden="true">
                                        @(this.IsPresentationModeSelected(mode) ? "\u2022" : string.Empty)
                                    </span>
                                </Icon>
                                <ChildContent>
                                    <span>@(GetPresentationModeLabel(mode))</span>

                                    @if (this.IsPresentationModeSelected(mode))
                                    {
                                        <span class="sr-only">Current selection</span>
                                    }
                                </ChildContent>
                            </BbDropdownMenuItem>
                        }
                    </div>
                </BbDropdownMenuContent>
            </BbDropdownMenu>
        </div>
    </nav>
}
