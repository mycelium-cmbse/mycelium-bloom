@inherits BloomComponentBase

<div @attributes="this.AdditionalAttributes" class="@this.BuildRootCssClass("diagram-package")">
    <div class="diagram-package-tab" tabindex="0" role="group" aria-label="Package name" @onwheel:stopPropagation="true">@this.Name</div>
    <div class="diagram-package-body" tabindex="0" role="group" aria-label="Package content" @onwheel:stopPropagation="true">@this.ChildContent</div>
</div>
