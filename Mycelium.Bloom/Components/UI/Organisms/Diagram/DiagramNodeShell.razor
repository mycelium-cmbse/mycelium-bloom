@inherits BloomComponentBase

<div @attributes="this.AdditionalAttributes" class="@this.BuildRootCssClass("mb-diagram-node", $"mb-diagram-node--{this.Kind.ToString().ToLowerInvariant()}")">
    <div class="diagram-node-content" tabindex="0" role="group" aria-label="Element content" @onwheel:stopPropagation="true">
        @this.Name
        @this.NestedView
        @this.Compartments
    </div>
    @this.LeftBoundary
    @this.RightBoundary
    @this.TopBoundary
    @this.BottomBoundary
</div>
