@inherits BloomComponentBase

<section @attributes="this.AdditionalAttributes" role="group" class="@this.BuildRootCssClass("diagram-compartment")" aria-label="@this.Presentation.Title">
    <div class="diagram-compartment-title"><em>@this.Presentation.Title</em></div>
    @if (this.GraphicalView is not null)
    {
        @this.GraphicalView
    }
    else
    {
        @foreach (var row in this.Presentation.Rows)
        {
            <div class="diagram-row">@row</div>
        }
        @if (this.Presentation.IsTruncated)
        {
            <div aria-label="More members">…</div>
        }
    }
</section>
