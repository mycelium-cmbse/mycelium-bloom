@inherits BloomComponentBase

<div @attributes="this.AdditionalAttributes" class="@this.BuildRootCssClass("diagram-toolbox")" role="toolbar" aria-label="Diagram tools" aria-orientation="horizontal">
    @for (var index = 0; index < this.ViewModel.Tools.Toolbox.Length; index++)
    {
        var placement = this.ViewModel.Tools.Toolbox[index];
        var tool = placement.Tool;
        var item = placement.Item;

        if (index > 0 && item.Group != this.ViewModel.Tools.Toolbox[index - 1].Item.Group)
        {
            <span class="diagram-toolbox-divider" aria-hidden="true"></span>
        }

        <button @key="placement" type="button" class="diagram-toolbox-tool" aria-label="@tool.Label"
                aria-pressed="@(placement == this.ViewModel.Tools.Active ? "true" : "false")" aria-keyshortcuts="@(item.Shortcut ?? tool.DefaultShortcut)"
                title="@(tool.Tooltip ?? tool.Label)" disabled="@(!this.ViewModel.Tools.CanActivate(placement))" @onclick="() => this.ViewModel.Tools.TryActivate(placement)">
            <LucideIcon Name="@tool.Icon" Size="16" aria-hidden="true" focusable="false" />
        </button>
    }
</div>
