@inherits BloomReactiveComponentBase<IDiagramViewModel>

<section style="@this.CanvasStyle" @onclick:stopPropagation="this.IsNested" @onpointerdown:stopPropagation="this.IsNested"
         @onpointermove:stopPropagation="this.IsNested" @onpointerup:stopPropagation="this.IsNested" @onwheel:stopPropagation="this.IsNested"
         @attributes="this.AdditionalAttributes" class="@this.BuildRootCssClass("general-diagram", this.IsNested ? "general-diagram--nested" : null)" data-tool="@this.ViewModel.Tools.Active?.Tool.Id" data-temporary-pan="@(this.ViewModel.Tools.Temporary is null ? null : "true")"
         data-capture-nested-input="@(this.ViewModel.Tools.Effective?.Tool.CapturesNestedInput == true ? "true" : null)"
         data-tool-cursor="@this.renderer?.Pointer.Cursor" role="group" aria-label="@(this.ViewModel.Projection.ViewName ?? "Diagram")">
    @if (!this.IsNested)
    {
        <div class="diagram-navigation">
            <DiagramToolbox ViewModel="this.ViewModel" />
            <ZoomControls MinimumZoom="@(DiagramViewport.MinimumZoom * 100)" MaximumZoom="@(DiagramViewport.MaximumZoom * 100)" Zoom="@(this.ViewModel.Viewport.Zoom * 100)" ZoomChanged="this.ChangeZoom" OnResetZoom="this.ResetZoom" OnFitToView="this.FitToView" Compact="true" />
        </div>
    }
    <div class="diagram-view-contents @(string.IsNullOrWhiteSpace(this.ViewModel.Projection.ViewName) ? "" : "diagram-view-contents--framed")">
        @if (this.ViewModel.Projection.ViewName is { Length: > 0 } name)
        {
            <div class="diagram-view-frame">«view» @name</div>
        }
        <div class="general-diagram-canvas" @onkeydown="this.KeyDown" @onkeyup="this.KeyUp" @onfocusout="this.FocusOut"
             @onpointercancel="this.PointerCancelled" @onlostpointercapture="this.PointerCancelled"
             @onkeydown:stopPropagation="this.IsNested" @onkeyup:stopPropagation="this.IsNested" @onfocusout:stopPropagation="this.IsNested"
             @onpointercancel:stopPropagation="this.IsNested" @onlostpointercapture:stopPropagation="this.IsNested">
            @if (this.renderer is not null)
            {
                <CascadingValue Value="this.renderer.Diagram" IsFixed="true" @key="this.renderer">
                    <CascadingValue Value="this.renderer.Pointer" IsFixed="true">
                        <DiagramCanvasHost AdditionalSvg="this.renderer.Pointer.Preview" @ref="this.host" />
                    </CascadingValue>
                </CascadingValue>
            }
        </div>
        @if (this.ViewModel.Projection.HasOmittedContent)
        {
            <div class="diagram-ellipsis" aria-label="Some content is not shown">...</div>
        }
        @if (this.ViewModel.Projection.Nodes.IsEmpty)
        {
            <p role="status">No elements in this diagram.</p>
        }
    </div>
</section>
