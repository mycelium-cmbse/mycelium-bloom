@inherits SelectableDiagramWidgetBase<DiagramNodeViewModel>

<div @attributes="this.AdditionalAttributes" class="@this.BuildRootCssClass("diagram-occurrence", this.ViewModel.IsSelected ? "diagram-occurrence--selected" : null)" style="@this.Size"
     data-occurrence-id="@this.Node.Id" data-element-id="@this.ViewModel.Presentation.Occurrence.Element.ElementId"
     role="group" aria-label="@this.ViewModel.Presentation.Name.Declaration">
    @this.SelectableSurface("button",
        [new("type", "button"), new("class", "mb-diagram-node-select"), new("aria-label", this.ViewModel.Presentation.Name.Declaration),
            new("aria-pressed", this.ViewModel.IsSelected.ToString().ToLowerInvariant())], forwardAdditionalAttributes: false)
    <CascadingValue Value="this.Node">
        <CascadingValue Value="this.ViewModel">
            <DynamicComponent Type="@this.Components.GetComponentType(this.ViewModel.Presentation.GetType())" Parameters="@this.GetComponentParameters()" />
        </CascadingValue>
    </CascadingValue>
    @if (this.ViewModel.IsSelected && this.ViewModel.Presentation.Occurrence.IsResizable)
    {
        <button type="button" class="diagram-resize-handle" data-diagram-resize="@this.Node.Id"
                aria-label="Resize @this.ViewModel.Presentation.Name.Declaration" aria-describedby="@this.ResizeHelpId"
                @onpointerdown="this.BeginResize" @onpointerdown:stopPropagation="true"
                @onkeydown="this.ResizeWithKeyboard" @onkeydown:preventDefault="true" @onclick:stopPropagation="true"></button>
        <span id="@this.ResizeHelpId" class="diagram-resize-help" aria-hidden="true">Use arrow keys to resize; hold Shift for one-pixel steps.</span>
    }
</div>
