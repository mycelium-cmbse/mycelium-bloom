@inherits BloomReactiveComponentBase<DiagramBoundaryViewModel>

<button @attributes="this.AdditionalAttributes" type="button" class="@this.BuildRootCssClass("diagram-boundary", $"diagram-boundary--{this.Presentation.Side.ToString().ToLowerInvariant()}")"
        style="@this.GetPosition()" title="@this.Presentation.Label" aria-label="@this.Presentation.Label" aria-pressed="@this.ViewModel.IsSelected.ToString().ToLowerInvariant()"
        @onclick="this.Select" @onclick:stopPropagation="true" @onkeydown="args => this.Pointer?.PrepareSpaceActivation(args, this.ViewModel)"
        @onkeyup:preventDefault="@(this.Pointer is not null)" @onblur="() => this.Pointer?.CancelSpaceActivation(this.ViewModel)">
    <span class="diagram-boundary-square" aria-hidden="true">@this.GetGlyph()</span>
    <span class="diagram-boundary-label">@this.Presentation.Label</span>
</button>
