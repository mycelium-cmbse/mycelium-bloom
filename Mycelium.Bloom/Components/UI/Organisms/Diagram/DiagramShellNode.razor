@inherits BloomComponentBase

<DiagramNodeShell Kind="this.Presentation.Kind">
    <Name><DiagramNameCompartment Presentation="this.Presentation.Name" /></Name>
    <NestedView>
        @if (this.Presentation.NestedView is { } nested)
        {
            <DiagramCanvas ViewModel="this.ViewModel.GetNestedView(nested)" IsNested="true" />
        }
    </NestedView>
    <Compartments>
        @for (var index = 0; index < this.Presentation.Compartments.Length; index++)
        {
            var compartment = this.Presentation.Compartments[index];
            @if (compartment.GraphicalView is { } graphical)
            {
                <DiagramCompartment Presentation="compartment">
                    <GraphicalView><DiagramCanvas ViewModel="this.ViewModel.GetNestedView(graphical)" IsNested="true" /></GraphicalView>
                </DiagramCompartment>
            }
            else
            {
                <DiagramCompartment Presentation="compartment" Rows="this.ViewModel.CompartmentRows[index]" />
            }
        }
    </Compartments>
    <LeftBoundary>@this.BoundaryFeatures(BoundarySide.Left)</LeftBoundary>
    <RightBoundary>@this.BoundaryFeatures(BoundarySide.Right)</RightBoundary>
    <TopBoundary>@this.BoundaryFeatures(BoundarySide.Top)</TopBoundary>
    <BottomBoundary>@this.BoundaryFeatures(BoundarySide.Bottom)</BottomBoundary>
</DiagramNodeShell>
