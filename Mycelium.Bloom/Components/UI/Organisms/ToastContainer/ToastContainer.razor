@inherits BloomComponentBase

@if (this.HasNotifications())
{
    <section class="@(this.GetCssClass())"
             aria-label="Notifications"
             @attributes="this.AdditionalAttributes">
        @foreach (var notification in this.Notifications)
        {
            <div @key="notification.Id" class="mb-toast-container__item">
                <NotificationToast Notification="notification" Dismissed="this.Dismissed" />
            </div>
        }
    </section>
}
