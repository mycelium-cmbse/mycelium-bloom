@inherits BloomComponentBase

@using BlazorBlueprint.Components

<ModalShell IsOpen="@(this.IsOpen)"
            IsOpenChanged="this.IsOpenChanged"
            Title="@(this.Title)"
            Description="@(this.Description)"
            FocusReturnTarget="@(this.FocusReturnTarget)"
            Size="ModalSize.Small"
            ShowCloseButton="false"
            CloseOnBackdropClick="false"
            Class="@(this.Class)"
            @attributes="this.AdditionalAttributes">
    <ChildContent>
        <span class="@(this.GetIndicatorCssClass())"
              role="@(this.IsActionInProgress() ? "status" : null)"
              aria-label="@(this.IsActionInProgress() ? "Confirmation in progress" : null)"
              aria-hidden="@(this.IsActionInProgress() ? null : "true")"
              tabindex="@(this.IsActionInProgress() ? "0" : null)">
            @(this.GetIndicatorText())
        </span>
    </ChildContent>

    <FooterContent>
        <BbButton Type="BlazorBlueprint.Components.ButtonType.Button"
                  Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                  Size="BlazorBlueprint.Components.ButtonSize.Small"
                  Disabled="@(this.IsActionInProgress())"
                  OnClick="this.HandleCancelAsync">
            @(this.CancelText)
        </BbButton>

        <BbButton Type="BlazorBlueprint.Components.ButtonType.Button"
                  Variant="@(this.GetConfirmButtonVariant())"
                  Size="BlazorBlueprint.Components.ButtonSize.Small"
                  Disabled="@(this.IsActionInProgress())"
                  Loading="@(this.IsActionInProgress())"
                  LoadingText="@(this.ConfirmText)"
                  aria-busy="@(this.IsActionInProgress() ? "true" : "false")"
                  OnClick="this.HandleConfirmAsync">
            @(this.ConfirmText)
        </BbButton>
    </FooterContent>
</ModalShell>
