@inherits BloomComponentBase

<ModalShell IsOpen="@(this.IsOpen)"
            IsOpenChanged="this.IsOpenChanged"
            Title="@(this.Title)"
            Description="@(this.Description)"
            FocusReturnTarget="@(this.FocusReturnTarget)"
            Size="ModalSize.Small"
            ShowCloseButton="false"
            CloseOnBackdropClick="false"
            Class="@(this.GetCssClass())"
            @attributes="this.AdditionalAttributes">
    <ChildContent>
        <div class="mb-confirm-dialog__body">
            <span class="@(this.GetIndicatorCssClass())" aria-hidden="true">
                @(this.GetIndicatorText())
            </span>
        </div>
    </ChildContent>

    <FooterContent>
        <div class="mb-confirm-dialog__footer">
            <button type="button"
                    class="mb-button mb-button--secondary mb-button--small"
                    disabled="@(this.IsActionInProgress())"
                    @onclick="this.HandleCancelAsync">
                @(this.CancelText)
            </button>

            <button type="button"
                    class="@(this.GetConfirmButtonCssClass())"
                    disabled="@(this.IsActionInProgress())"
                    aria-busy="@(this.IsActionInProgress() ? "true" : "false")"
                    @onclick="this.HandleConfirmAsync">
                @if (this.IsActionInProgress())
                {
                    <span class="mb-button__spinner" aria-hidden="true"></span>
                }

                <span class="mb-button__content">@(this.ConfirmText)</span>
            </button>
        </div>
    </FooterContent>
</ModalShell>
