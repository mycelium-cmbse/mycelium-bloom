@inherits BloomComponentBase

<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    <BbButton
        Type="BlazorBlueprint.Components.ButtonType.Button"
        Variant="@(this.GetBlueprintVariant())"
        Size="@(this.GetBlueprintSize())"
        Disabled="@(this.Disabled)"
        Loading="@(this.IsActionInProgress())"
        LoadingText="@(this.PrimaryText)"
        Class="mb-split-button__primary"
        OnClick="this.HandlePrimaryActionAsync"
        aria-busy="@(this.IsActionInProgress() ? "true" : "false")">
        @(this.PrimaryText)
    </BbButton>

    <ActionMenu
        Class="mb-split-button__actions"
        TriggerClass="mb-split-button__toggle"
        TriggerAriaLabel="@(this.MenuAriaLabel)"
        TriggerTitle="@(this.MenuAriaLabel)"
        Items="@(this.Items)"
        Disabled="@(this.IsDisabled())"
        ShowChevron="true"
        Alignment="ActionMenuAlignment.End"
        ItemSelected="this.HandleItemSelectedAsync" />
</div>
