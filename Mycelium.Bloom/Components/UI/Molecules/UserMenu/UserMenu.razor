@inherits BloomComponentBase

<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    <ActionMenu
        TriggerClass="mb-user-menu__trigger"
        TriggerAriaLabel="@(this.GetMenuAriaLabel())"
        TriggerTitle="@(this.GetMenuAriaLabel())"
        Items="@(this.Items)"
        Disabled="@(this.Disabled)"
        Alignment="ActionMenuAlignment.End"
        ItemSelected="this.HandleItemSelectedAsync">
        <TriggerContent>
            <span class="mb-user-menu__avatar-frame"
                  style="@(this.GetAvatarStyle())"
                  title="@(this.DisplayName)"
                  aria-hidden="true">
                <BlazorBlueprint.Components.BbAvatar
                    Size="BlazorBlueprint.Components.AvatarSize.Small"
                    Class="mb-user-menu__avatar">
                    <BlazorBlueprint.Components.BbAvatarFallback Class="mb-user-menu__avatar-fallback">
                        @(this.GetAvatarText())
                    </BlazorBlueprint.Components.BbAvatarFallback>
                </BlazorBlueprint.Components.BbAvatar>
            </span>

            @if (!this.Compact)
            {
                <span class="mb-user-menu__identity">
                    <span class="mb-user-menu__name" title="@this.DisplayName">@this.DisplayName</span>

                    @if (!string.IsNullOrWhiteSpace(this.Subtitle))
                    {
                        <span class="mb-user-menu__subtitle" title="@this.Subtitle">@this.Subtitle</span>
                    }
                </span>
            }
        </TriggerContent>
    </ActionMenu>
</div>
