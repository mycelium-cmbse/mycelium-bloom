@inherits BloomComponentBase

<header class="@(this.BuildRootCssClass("mb-page-header"))" @attributes="this.AdditionalAttributes">
    <div class="mb-page-header__text">
        <h1 class="mb-page-header__title leading-display-xl [font-weight:--theme(--font-weight-heading-md)]">@(this.Title)</h1>

        @if (!string.IsNullOrWhiteSpace(this.Subtitle))
        {
            <p class="mb-page-header__subtitle text-body-sm [font-weight:--theme(--font-weight-body-sm)]">@(this.Subtitle)</p>
        }
    </div>

    @if (this.ActionsContent is not null)
    {
        <div class="mb-page-header__actions">
            @(this.ActionsContent)
        </div>
    }
</header>
