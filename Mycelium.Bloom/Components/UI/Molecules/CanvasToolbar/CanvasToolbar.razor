@inherits BloomComponentBase

<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    <Toolbar AriaLabel="@(this.AriaLabel)"
             Compact="@(this.Compact)"
             AllowWrap="false"
             Class="mb-canvas-toolbar__toolbar">
        <ChildContent>
            @(this.ChildContent)
        </ChildContent>
    </Toolbar>
</div>
