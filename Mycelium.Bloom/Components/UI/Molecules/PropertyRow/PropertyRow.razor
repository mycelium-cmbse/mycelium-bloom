<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    <span class="mb-property-row__label">
        @(this.Label)
    </span>

    <div class="mb-property-row__value">
        @if (this.ValueContent != null)
        {
            @(this.ValueContent)
        }
        else
        {
            <span class="@(this.GetValueCssClass())">
                @(this.Value)
            </span>
        }
    </div>
</div>
