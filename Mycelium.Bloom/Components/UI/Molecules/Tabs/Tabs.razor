@inherits BloomComponentBase

@inject IJSRuntime JsRuntime

<div @ref="this.tabListElement" class="@(this.GetCssClass())" role="tablist" aria-orientation="horizontal" @attributes="this.AdditionalAttributes">
    @for (var index = 0; index < this.Items.Count; index++)
    {
        var itemIndex = index;
        var item = this.Items[itemIndex];
        var isActive = this.IsActive(item);

        <button
            @ref="this.tabElements[itemIndex]"
            type="button"
            class="@(this.GetTabClass(item))"
            role="tab"
            aria-selected="@(isActive ? "true" : "false")"
            tabindex="@(this.GetTabIndex(itemIndex))"
            disabled="@item.Disabled"
            @onkeydown="args => this.HandleTabKeyDownAsync(args, itemIndex)"
            @onclick="() => this.SelectTabAsync(item)">
            @item.Label
        </button>
    }
</div>
