@using BlazorBlueprint.Icons.Lucide.Components

@inherits BloomComponentBase

<article class="@(this.GetCssClass())"
         role="@(this.GetRole())"
         aria-live="@(this.GetAriaLive())"
         aria-atomic="true"
         @attributes="this.AdditionalAttributes">
    <span class="mb-notification-toast__marker" aria-hidden="true"></span>

    <div class="mb-notification-toast__content">
        <h2 class="mb-notification-toast__title">@(this.Notification.Title)</h2>

        @if (!string.IsNullOrWhiteSpace(this.Notification.Message))
        {
            <p class="mb-notification-toast__message">@(this.Notification.Message)</p>
        }
    </div>

    @if (this.Notification.IsDismissible)
    {
        <div class="mb-notification-toast__dismiss">
            <BlazorBlueprint.Components.BbButton
                Type="BlazorBlueprint.Components.ButtonType.Button"
                Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                AriaLabel="@(this.GetDismissLabel())"
                title="@(this.GetDismissLabel())"
                OnClick="this.HandleDismissAsync">
                <LucideIcon Name="x"
                            Size="16"
                            StrokeWidth="1.75"
                            role="presentation"
                            aria-hidden="true"
                            focusable="false" />
            </BlazorBlueprint.Components.BbButton>
        </div>
    }
</article>
