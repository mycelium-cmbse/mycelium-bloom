@inherits BloomComponentBase

<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    @if (this.IconContent is not null)
    {
        <div class="mb-empty-state__icon" aria-hidden="true">
            @(this.IconContent)
        </div>
    }

    <div class="mb-empty-state__content">
        <h2 class="mb-empty-state__title">@(this.Title)</h2>

        @if (!string.IsNullOrWhiteSpace(this.Description))
        {
            <p class="mb-empty-state__description">@(this.Description)</p>
        }
    </div>

    @if (this.ActionContent is not null)
    {
        <div class="mb-empty-state__actions">
            @(this.ActionContent)
        </div>
    }
</div>
