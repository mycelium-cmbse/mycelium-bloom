@using BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components

@inherits BloomComponentBase

<BbDialog Open="@(this.IsOpen)"
          OpenChanged="this.HandleDialogOpenChangedAsync">
    <BbDialogContent id="@(this.GetModalId())"
                     Class="@(this.GetCssClass())"
                     ShowClose="false"
                     CloseOnOverlayClick="@(this.CloseOnBackdropClick)"
                     aria-labelledby="@(this.HasTitle() ? this.GetTitleId() : null)"
                     aria-label="@(this.GetDialogLabel())"
                     aria-describedby="@(this.HasDescription() ? this.GetDescriptionId() : null)"
                     @attributes="this.AdditionalAttributes">
        @if (this.HasTitle() || this.HasDescription())
        {
            <BbDialogHeader Class="pr-8 text-left">
                @if (this.HasTitle())
                {
                    <BbDialogTitle As="h2" id="@(this.GetTitleId())">
                        @(this.Title)
                    </BbDialogTitle>
                }

                @if (this.HasDescription())
                {
                    <BbDialogDescription id="@(this.GetDescriptionId())">
                        @(this.Description)
                    </BbDialogDescription>
                }
            </BbDialogHeader>
        }

        @if (this.ShowCloseButton)
        {
            <BbDialogClose AsChild="true">
                <BbButton Type="BlazorBlueprint.Components.ButtonType.Button"
                          Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                          Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                          Class="absolute right-4 top-4"
                          AriaLabel="Close dialog"
                          title="Close dialog"
                          Disabled="@(this.isClosing)">
                    <LucideIcon Name="x"
                                Size="16"
                                StrokeWidth="1.75"
                                role="presentation"
                                aria-hidden="true"
                                focusable="false" />
                </BbButton>
            </BbDialogClose>
        }

        <div class="min-h-0 overflow-auto">
            @(this.ChildContent)
        </div>

        @if (this.FooterContent is not null)
        {
            <BbDialogFooter>
                @(this.FooterContent)
            </BbDialogFooter>
        }
    </BbDialogContent>
</BbDialog>
