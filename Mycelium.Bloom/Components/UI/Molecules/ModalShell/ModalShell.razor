@inherits BloomComponentBase

@if (this.IsOpen)
{
    <div class="mb-modal" role="presentation">
        <div class="mb-modal__backdrop"
             aria-hidden="true"
             @onclick="this.HandleBackdropClickAsync"></div>

        <section id="@(this.GetModalId())"
                 class="@(this.GetCssClass())"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@(this.HasDefaultTitle() ? this.GetTitleId() : null)"
                 aria-label="@(this.GetDialogLabel())"
                 aria-describedby="@(this.HasDefaultDescription() ? this.GetDescriptionId() : null)"
                 @onclick:stopPropagation="true"
                 @attributes="this.AdditionalAttributes">
            @if (this.HasHeader())
            {
                <header class="mb-modal__header">
                    @if (this.HeaderContent is not null)
                    {
                        <div class="mb-modal__custom-header">
                            @(this.HeaderContent)
                        </div>
                    }
                    else
                    {
                        <div class="mb-modal__heading">
                            @if (!string.IsNullOrWhiteSpace(this.Title))
                            {
                                <h2 id="@(this.GetTitleId())" class="mb-modal__title">@(this.Title)</h2>
                            }

                            @if (!string.IsNullOrWhiteSpace(this.Description))
                            {
                                <p id="@(this.GetDescriptionId())" class="mb-modal__description">@(this.Description)</p>
                            }
                        </div>
                    }

                    @if (this.ShowCloseButton)
                    {
                        <div class="mb-modal__close">
                            <IconButton AriaLabel="Close dialog"
                                        Title="Close"
                                        Disabled="@(this.isClosing)"
                                        OnClick="this.CloseAsync">
                                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M3.5 3.5L12.5 12.5M12.5 3.5L3.5 12.5"
                                          stroke="currentColor"
                                          stroke-linecap="round"
                                          stroke-width="1.5" />
                                </svg>
                            </IconButton>
                        </div>
                    }
                </header>
            }

            <div class="mb-modal__body">
                @(this.ChildContent)
            </div>

            @if (this.FooterContent is not null)
            {
                <footer class="mb-modal__footer">
                    @(this.FooterContent)
                </footer>
            }
        </section>
    </div>
}
