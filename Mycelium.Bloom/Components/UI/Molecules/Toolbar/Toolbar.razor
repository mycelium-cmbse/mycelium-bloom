@inherits BloomComponentBase

<div class="@(this.GetCssClass())" role="toolbar" aria-label="@(this.AriaLabel)" @attributes="this.AdditionalAttributes">
    @if (this.LeadingContent is not null)
    {
        <div class="mb-toolbar__leading">
            @(this.LeadingContent)
        </div>
    }

    @if (this.ChildContent is not null)
    {
        <div class="mb-toolbar__main">
            @(this.ChildContent)
        </div>
    }

    @if (this.TrailingContent is not null)
    {
        <div class="mb-toolbar__trailing">
            @(this.TrailingContent)
        </div>
    }
</div>
