@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Icons.Lucide.Components
@inherits BloomComponentBase

<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    <BbDropdownMenu>
        <BbDropdownMenuTrigger
            AsChild="false"
            type="button"
            Class="@(this.GetTriggerCssClass())"
            ActiveClass="mb-action-menu__trigger--open"
            style="@(this.IsTriggerDisabled() ? null : "cursor: pointer;")"
            title="@(this.TriggerTitle)"
            aria-label="@(this.TriggerAriaLabel)"
            aria-disabled="@(this.IsTriggerDisabled() ? "true" : null)"
            Disabled="@(this.IsTriggerDisabled())">
            @if (this.TriggerContent is not null)
            {
                <span class="mb-action-menu__trigger-content">
                    @(this.TriggerContent)
                </span>
            }
            else if (!this.ShowChevron)
            {
                <LucideIcon Name="ellipsis"
                            Size="16"
                            StrokeWidth="1.75"
                            role="presentation"
                            aria-hidden="true"
                            focusable="false" />
            }

            @if (this.TriggerContent is not null || this.ShowChevron)
            {
                <ChevronIcon Class="mb-action-menu__chevron" />
            }
        </BbDropdownMenuTrigger>

        <BbDropdownMenuContent
            Class="@(this.MenuClass)"
            Side="PopoverSide.Bottom"
            Align="@(this.GetPopoverAlignment())"
            Offset="6"
            MatchTriggerWidth="@(this.MatchTriggerWidth)">
            @foreach (var item in this.Items)
            {
                @if (item.SeparatorBefore)
                {
                    <BbDropdownMenuSeparator />
                }

                <BbDropdownMenuItem
                    Class="@(GetItemCssClass(item))"
                    Disabled="@(item.Disabled)"
                    CloseOnSelect="true"
                    OnClick="_ => this.HandleItemSelectedAsync(item)">
                    <Icon>
                        @if (item.Symbol.HasValue)
                        {
                            <LucideIcon Name="@(item.Symbol.Value.ToLucideName())"
                                        Size="16"
                                        StrokeWidth="1.75"
                                        role="presentation"
                                        aria-hidden="true"
                                        focusable="false" />
                        }
                        else if (!string.IsNullOrWhiteSpace(item.Icon))
                        {
                            <span class="mb-action-menu__item-symbol" aria-hidden="true">
                                @item.Icon
                            </span>
                        }
                    </Icon>

                    <ChildContent>
                        @if (!item.Disabled)
                        {
                            <span class="mb-action-menu__item-pointer-surface"
                                  role="presentation"
                                  aria-hidden="true"></span>
                        }

                        <span class="mb-action-menu__item-content">
                            <span class="mb-action-menu__item-label" title="@(item.Label)">
                                @(item.Label)
                            </span>

                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <span class="mb-action-menu__item-description"
                                      title="@(item.Description)">
                                    @(item.Description)
                                </span>
                            }

                            @if (item.Destructive)
                            {
                                <span class="sr-only">Destructive action</span>
                            }

                            @if (this.IsSelectionMenu && item.IsSelected)
                            {
                                <span class="sr-only">Current selection</span>
                            }
                        </span>

                        @if (this.IsSelectionMenu && item.IsSelected)
                        {
                            <span class="mb-action-menu__selection" aria-hidden="true">
                                <LucideIcon Name="check"
                                            Size="16"
                                            StrokeWidth="1.75"
                                            focusable="false" />
                            </span>
                        }
                    </ChildContent>
                </BbDropdownMenuItem>
            }
        </BbDropdownMenuContent>
    </BbDropdownMenu>
</div>
