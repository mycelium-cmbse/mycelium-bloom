<div
    @ref="this.RootElement"
    class="@(this.GetCssClass())"
    @onfocusin="this.HandleFocusIn"
    @onfocusout="this.HandleFocusOutAsync"
    @attributes="this.AdditionalAttributes">
    <button
        @ref="this.TriggerElement"
        type="button"
        class="@(this.GetTriggerClass())"
        title="@(this.TriggerTitle)"
        aria-label="@(this.TriggerAriaLabel)"
        aria-haspopup="menu"
        aria-expanded="@(this.IsOpen ? "true" : "false")"
        @onkeydown="this.HandleTriggerKeyDownAsync"
        @onclick="this.ToggleMenu">
        @if (!this.IsIconOnly)
        {
            <span class="mb-action-menu__trigger-text">
                @(this.TriggerText)
            </span>
        }

        <span class="mb-action-menu__trigger-icon" aria-hidden="true">
            @(this.Icon)
        </span>
    </button>

    @if (this.IsOpen)
    {
        <div class="@(this.GetMenuClass())" role="menu">
            @for (var index = 0; index < this.Items.Count; index++)
            {
                var itemIndex = index;
                var item = this.Items[itemIndex];

                <button
                    @ref="this.ItemElements[itemIndex]"
                    type="button"
                    class="@(ActionMenuItemHelper.BuildItemCssClass(item, ItemCssClass))"
                    role="menuitem"
                    disabled="@(item.Disabled)"
                    @onkeydown="args => this.HandleItemKeyDownAsync(args, itemIndex)"
                    @onclick="() => this.SelectItemAsync(item)">
                    @if (!string.IsNullOrWhiteSpace(item.Icon))
                    {
                        <span class="mb-action-menu__item-icon" aria-hidden="true">
                            @item.Icon
                        </span>
                    }

                    <span class="mb-action-menu__item-content">
                        <span class="mb-action-menu__item-label">
                            @item.Label
                        </span>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <span class="mb-action-menu__item-description">
                                @item.Description
                            </span>
                        }
                    </span>
                </button>
            }
        </div>
    }
</div>
