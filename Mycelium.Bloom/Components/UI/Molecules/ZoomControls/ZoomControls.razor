@inherits BloomComponentBase

<div class="@(this.GetCssClass())" @attributes="this.AdditionalAttributes">
    <Toolbar AriaLabel="@(this.AriaLabel)"
             Compact="@(this.Compact)"
             AllowWrap="false"
             Class="mb-zoom-controls__toolbar">
        <ChildContent>
            <IconButton AriaLabel="Zoom out"
                        Title="Zoom out"
                        Disabled="@(this.IsZoomOutDisabled())"
                        OnClick="this.HandleZoomOutAsync">
                <span aria-hidden="true">−</span>
            </IconButton>

            @if (this.ShowZoomValue)
            {
                <output class="mb-zoom-controls__value" aria-label="Current zoom">
                    @(this.GetFormattedZoom())
                </output>
            }

            <IconButton AriaLabel="Zoom in"
                        Title="Zoom in"
                        Disabled="@(this.IsZoomInDisabled())"
                        OnClick="this.HandleZoomInAsync">
                <span aria-hidden="true">+</span>
            </IconButton>

            <IconButton AriaLabel="Reset zoom"
                        Title="Reset zoom"
                        Disabled="@(this.Disabled)"
                        OnClick="this.HandleResetZoomAsync">
                <span aria-hidden="true">1:1</span>
            </IconButton>

            <IconButton AriaLabel="Fit to view"
                        Title="Fit to view"
                        Disabled="@(this.Disabled)"
                        OnClick="this.HandleFitToViewAsync">
                <span aria-hidden="true">⛶</span>
            </IconButton>
        </ChildContent>
    </Toolbar>
</div>
