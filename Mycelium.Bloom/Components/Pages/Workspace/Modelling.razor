@page "/workspace/modeling"
@layout WorkspaceLayout
@using BlazorBlueprint.Icons.Lucide.Components
@using Mycelium.Bloom.Components.UI.Organisms.EditorWorkspace

<PageTitle>Mycelium - Bloom</PageTitle>

@using Mycelium.Bloom.Components.UI.Organisms.Diagram

<div class="mb-main-workspace" data-testid="main-workspace">
    <h1 class="sr-only">Modelling</h1>

    <EditorWorkspace ViewModel="this.WorkspaceEditorViewModel"
                     InitialGroupWeights="this.initialGroupWeights"
                     TabClosed="this.HandleTabClosed"
                     AriaLabel="Workspace editors">
        <TabLeadingContent Context="tab">
            @if (this.GetEditorTabIconName(tab) is { Length: > 0 } iconName)
            {
                <span data-testid="workspace-editor-tab-icon"
                      data-tab-id="@(tab.Id)"
                      data-icon-name="@(iconName)">
                    <LucideIcon Name="@(iconName)"
                                Size="14"
                                StrokeWidth="1.75"
                                role="presentation"
                                aria-hidden="true"
                                focusable="false" />
                </span>
            }
        </TabLeadingContent>

        <AddTabControl Context="groupId">
            <div class="mb-editor-workspace__add-tab-menu" data-group-id="@(groupId)" data-testid="editor-workspace-add-tab-menu">
                <BbDropdownMenu>
                    <BbDropdownMenuTrigger AsChild="false" type="button" Class="mb-editor-workspace__add-tab" title="Add tab" aria-label="@(this.GetAddTabAriaLabel(groupId))">
                        <LucideIcon Name="plus" Size="14" StrokeWidth="1.16667" role="presentation" aria-hidden="true" focusable="false" />
                    </BbDropdownMenuTrigger>
                    <BbDropdownMenuContent Class="mb-menu" Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Offset="6">
                        @foreach (var editorType in this.GetAddTabEditorTypes())
                        {
                            <BbDropdownMenuItem CloseOnSelect="true" OnClick="_ => this.HandleAddTabActionSelected(groupId, editorType.ActionId)">
                                <Icon>
                                    <LucideIcon Name="@(editorType.Symbol.ToLucideName())" Size="16" StrokeWidth="1.75" role="presentation" aria-hidden="true" focusable="false" />
                                </Icon>
                                <ChildContent>@(editorType.Label)</ChildContent>
                            </BbDropdownMenuItem>
                        }
                    </BbDropdownMenuContent>
                </BbDropdownMenu>
            </div>
        </AddTabControl>

        <EditorContent Context="tab">
            @if (this.diagrams.TryGetValue(tab.Id, out var diagram))
            {
                <DynamicComponent @key="tab.Id" Type="diagram.Descriptor.ComponentType" Parameters="diagram.Parameters" />
            }
            else if (IsProjectBrowserTab(tab))
            {
                @if (this.TryGetProjectBrowserViewModel(tab, out var projectBrowserViewModel))
                {
                    <ProjectBrowser @key="tab.Id"
                                    ViewModel="projectBrowserViewModel"
                                    FollowInspection="@(this.IsInspectionBrowser(projectBrowserViewModel))"
                                    SelectedNodeChanged="this.HandleBrowserSelectionAsync"
                                    data-testid="workspace-project-browser"
                                    data-tab-id="@(tab.Id)" />
                }
                else
                {
                    <div class="mb-main-workspace__editor-placeholder"
                         role="status"
                         data-testid="workspace-project-browser-unavailable"
                         data-tab-id="@(tab.Id)">
                        <strong>Project Browser unavailable</strong>
                        <span>This editor instance could not be composed.</span>
                    </div>
                }
            }
            else
            {
                <div class="mb-main-workspace__editor-placeholder"
                     data-testid="workspace-editor-placeholder"
                     data-tab-id="@(tab.Id)">
                    <strong>@(tab.Title)</strong>
                    <span>Feature content will be composed here.</span>
                </div>
            }
        </EditorContent>
    </EditorWorkspace>
</div>
