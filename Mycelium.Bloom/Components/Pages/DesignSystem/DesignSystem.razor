@page "/design-system"
@using Mycelium.Bloom.Components.UI.Molecules.DetailPanelHeader
@using Mycelium.Bloom.Components.UI.Molecules.Modal

<PageTitle>Bloom Design System</PageTitle>

<div style="min-height: 100vh; padding: 32px; background: var(--mb-color-background);">
    <header style="max-width: 1280px; margin: 0 auto 24px; display: flex; flex-direction: column; gap: 8px;">
        <p class="mb-text-label-xs" style="color: var(--mb-color-text-muted);">
            Internal verification
        </p>

        <h1 class="mb-text-display-lg" style="color: var(--mb-color-text-primary);">
            Bloom Design System
        </h1>

        <p class="mb-text-body-md" style="max-width: 760px; color: var(--mb-color-text-secondary);">
            Reusable UI components shown with Mycelium Bloom workspace, SysML, model sync, and Fabric connection sample data.
        </p>
    </header>

    <main style="max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px;">
        <Panel Padding="PanelPadding.Large">
            <SectionHeader Label="Foundations"/>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <h2 class="mb-text-heading-sm" style="color: var(--mb-color-text-primary);">
                        Typography
                    </h2>

                    @foreach (var typographySample in this.TypographySamples)
                    {
                        <p class="@(typographySample.CssClass)" style="color: @(typographySample.Color);">
                            @(typographySample.Text)
                        </p>
                    }
                </div>

                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <h2 class="mb-text-heading-sm" style="color: var(--mb-color-text-primary);">
                        Color chips
                    </h2>

                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        @foreach (var chip in this.FoundationColorChips)
                        {
                            <Chip Variant="@(chip.Variant)" Color="@(chip.Color)">
                                @(chip.Label)
                            </Chip>
                        }
                    </div>
                </div>
            </div>
        </Panel>

        <Panel Padding="PanelPadding.Large">
            <SectionHeader Label="Atoms"/>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">Button</h2>

                    <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                        <Button Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Commit</Button>
                        <Button Variant="ButtonVariant.Secondary">Compare</Button>
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Large">Inspect</Button>
                        <Button Variant="ButtonVariant.Danger">Reject</Button>
                        <Button Variant="ButtonVariant.Primary" IsLoading="true">Model sync</Button>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">IconButton</h2>

                    <div style="display: flex; gap: 8px; align-items: center;">
                        <IconButton AriaLabel="Refresh model" Title="Refresh model">R</IconButton>
                        <IconButton AriaLabel="Pin detail panel" Title="Pin detail panel">P</IconButton>
                        <IconButton AriaLabel="Open notifications" Title="Open notifications">!</IconButton>
                        <IconButton AriaLabel="Disabled workspace action" Title="Disabled workspace action" Disabled="true">x</IconButton>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">Chip</h2>

                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        <Chip>Default</Chip>
                        <Chip Variant="ChipVariant.Success">Validated</Chip>
                        <Chip Variant="ChipVariant.Warning">Pending review</Chip>
                        <Chip Variant="ChipVariant.Danger">Conflict</Chip>
                        <Chip Variant="ChipVariant.Info">Allocated</Chip>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">Avatar</h2>

                    <div style="display: flex; gap: 8px; align-items: center;">
                        <Avatar Text="PA" Title="Project Admin" Size="AvatarSize.Small"/>
                        <Avatar Text="AL" Title="AOCS Lead" BackgroundColor="var(--mb-color-collaborator-c10)"/>
                        <Avatar Text="FS" Title="Fabric Sync" Size="AvatarSize.Large" BackgroundColor="var(--mb-color-brand-700)"/>
                        <Avatar Text="+3" Title="3 more collaborators" Variant="AvatarVariant.More"/>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">SearchInput</h2>

                    <SearchInput
                        @bind-Value="this.SearchText"
                        Placeholder="Search Spacecraft, AOCS, or ReactionWheelAssembly"
                        FullWidth="true"
                        Id="design-system-search"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">Skeleton</h2>

                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <Skeleton Lines="3"/>

                        <div style="display: flex; align-items: center; gap: 12px;">
                            <Skeleton Variant="SkeletonVariant.Circle"/>

                            <div style="display: flex; flex-direction: column; gap: 8px; min-width: 0; flex: 1 1 auto;">
                                <Skeleton Width="50%"/>
                                <Skeleton Width="72%"/>
                            </div>
                        </div>

                        <Skeleton Variant="SkeletonVariant.Rectangle" Height="84px"/>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">Panel</h2>

                    <Panel Padding="PanelPadding.Small">
                        <p class="mb-text-body-sm" style="color: var(--mb-color-text-secondary);">
                            Compact reusable surface for workspace sections.
                        </p>
                    </Panel>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <SectionHeader Label="SectionHeader">
                        <Actions>
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small">Edit</Button>
                        </Actions>
                    </SectionHeader>

                    <p class="mb-text-body-sm" style="margin-top: 12px; color: var(--mb-color-text-secondary);">
                        Section label with right-aligned action content.
                    </p>
                </Panel>
            </div>
        </Panel>

        <Panel Padding="PanelPadding.Large">
            <SectionHeader Label="Molecules"/>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">Breadcrumbs</h2>

                    <Breadcrumbs Items="this.Breadcrumbs"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">Tabs</h2>

                    <Tabs Items="this.DetailTabs" @bind-ActiveValue="this.ActiveDetailTab" FullWidth="true"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">PropertyRow</h2>

                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <PropertyRow Label="Qualified name" Value="Spacecraft::AOCS::ReactionWheelAssembly" IsMonospace="true"/>
                        <PropertyRow Label="Owner" Variant="PropertyRowVariant.Inline">
                            <ValueContent>
                                <Chip Variant="ChipVariant.Ownership" Color="var(--mb-color-ownership-aocs)">AOCS</Chip>
                            </ValueContent>
                        </PropertyRow>
                        <PropertyRow Label="Fabric connection" Value="Model sync ready"/>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.None">
                    <Toolbar HasBottomBorder="true">
                        <StartContent>
                            <strong class="mb-text-label-md">Toolbar</strong>
                        </StartContent>
                        <ChildContent>
                            <StatusIndicator Variant="StatusIndicatorVariant.Success" Label="Saved"/>
                        </ChildContent>
                        <EndContent>
                            <IconButton AriaLabel="Undo change" Title="Undo change">U</IconButton>
                            <IconButton AriaLabel="Redo change" Title="Redo change">R</IconButton>
                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Run</Button>
                        </EndContent>
                    </Toolbar>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">ActionMenu</h2>

                    <div style="display: flex; gap: 12px; align-items: center;">
                        <ActionMenu Items="this.ActionItems" TriggerText="Element actions" IsIconOnly="false" Icon="v" Placement="ActionMenuPlacement.BottomStart"/>
                        <ActionMenu Items="this.ActionItems" TriggerAriaLabel="Open compact element actions" TriggerTitle="Open compact element actions"/>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">SplitButton</h2>

                    <SplitButton Text="Run analysis" Items="this.ActionItems" Variant="ButtonVariant.Primary"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">ProjectSwitcher</h2>

                    <ProjectSwitcher
                        Items="this.ProjectSwitcherItems"
                        @bind-SelectedProjectId="this.SelectedProjectId"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">UserMenu</h2>

                    <UserMenu
                        UserName="Project Admin"
                        UserInitials="PA"
                        UserEmail="project.admin@example.invalid"
                        UserRole="Project Admin"
                        Items="this.UserMenuItems"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">ZoomControls</h2>

                    <ZoomControls
                        ZoomPercentage="this.CanvasZoomPercentage"
                        ZoomPercentageChanged="this.HandleCanvasZoomPercentageChanged"
                        FitToView="this.HandleCanvasFitToView"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">DetailPanelHeader</h2>

                    <DetailPanelHeader
                        Stereotype="part def"
                        Title="ReactionWheelAssembly"
                        QualifiedName="Spacecraft::AOCS::ReactionWheelAssembly"
                        Owner="AOCS"
                        OwnerColor="var(--mb-color-ownership-aocs)"
                        ShowCollapseButton="false"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">ModalShell</h2>

                    <p class="mb-text-body-sm" style="margin-bottom: 12px; color: var(--mb-color-text-secondary);">
                        Dialog shell for reviewing model changes before committing them to the shared workspace.
                    </p>

                    <Button Variant="ButtonVariant.Secondary" OnClick="this.OpenSampleModal">
                        Open modal
                    </Button>

                    <ModalShell
                        @bind-IsOpen="this.IsSampleModalOpen"
                        Title="Review pending model changes"
                        Description="Confirm the selected SysML updates before committing them to the shared workspace."
                        Size="ModalSize.Medium">
                        <ChildContent>
                            <div style="display: flex; flex-direction: column; gap: 12px;">
                                <PropertyRow Label="Package" Value="Spacecraft::AOCS" IsMonospace="true"/>
                                <PropertyRow Label="Changed elements" Value="3"/>
                                <PropertyRow Label="Validation" Variant="PropertyRowVariant.Inline">
                                    <ValueContent>
                                        <StatusIndicator Variant="StatusIndicatorVariant.Warning" Label="1 warning"/>
                                    </ValueContent>
                                </PropertyRow>
                            </div>
                        </ChildContent>
                        <FooterContent>
                            <Button Variant="ButtonVariant.Secondary" OnClick="this.CloseSampleModal">Cancel</Button>
                            <Button Variant="ButtonVariant.Primary" OnClick="this.CloseSampleModal">Commit changes</Button>
                        </FooterContent>
                    </ModalShell>
                </Panel>
            </div>
        </Panel>

        <Panel Padding="PanelPadding.Large">
            <SectionHeader Label="Organisms"/>

            <div style="display: flex; flex-direction: column; gap: 20px;">
                <Panel Padding="PanelPadding.None" OverflowHidden="true">
                    <AppHeader
                        Title="Mycelium Bloom"
                        Subtitle="Spacecraft workspace"
                        SearchValue="this.HeaderSearchText"
                        SearchValueChanged="value => this.HeaderSearchText = value"
                        SearchPlaceholder="Search Spacecraft"
                        UserName="Project Admin"
                        UserInitials="PA">
                        <BrandContent>
                            <div class="mb-app-header__brand-mark">
                                M
                            </div>

                            <ProjectSwitcher
                                Items="this.ProjectSwitcherItems"
                                @bind-SelectedProjectId="this.SelectedProjectId"/>
                        </BrandContent>
                        <ActionsContent>
                            <CollaboratorStack Items="this.CollaboratorStackItems" MaxVisible="3"/>
                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Share</Button>
                        </ActionsContent>
                    </AppHeader>
                </Panel>

                <Panel Padding="PanelPadding.None" OverflowHidden="true">
                    <CanvasToolbar
                        BreadcrumbItems="this.CanvasBreadcrumbs"
                        BreadcrumbSelected="this.HandleCanvasBreadcrumbSelected"
                        ActiveTool="this.ActiveCanvasTool"
                        ActiveToolChanged="this.HandleActiveCanvasToolChanged"
                        ZoomPercentage="this.CanvasZoomPercentage"
                        ZoomPercentageChanged="this.HandleCanvasZoomPercentageChanged"
                        FitToView="this.HandleCanvasFitToView">
                        <EndContent>
                            <CollaboratorStack Items="this.CollaboratorStackItems" MaxVisible="3"/>
                        </EndContent>
                    </CanvasToolbar>
                </Panel>

                <div style="display: grid; grid-template-columns: minmax(260px, 1fr) minmax(320px, 1.2fr); gap: 20px;">
                    <Panel Padding="PanelPadding.None" OverflowHidden="true">
                        <Toolbar HasBottomBorder="true">
                            <StartContent>
                                <strong class="mb-text-label-md">ModelTree</strong>
                            </StartContent>
                            <EndContent>
                                <IconButton AriaLabel="Filter model tree" Title="Filter model tree">?</IconButton>
                            </EndContent>
                        </Toolbar>

                        <ModelTree
                            Items="this.ModelTreeItems"
                            @bind-ActiveItemId="this.ActiveTreeItemId"
                            ExpandAllByDefault="true"/>
                    </Panel>

                    <DetailPanel
                        Stereotype="part def"
                        Title="ReactionWheelAssembly"
                        QualifiedName="Spacecraft::AOCS::ReactionWheelAssembly"
                        Owner="AOCS"
                        OwnerColor="var(--mb-color-ownership-aocs)"
                        Tabs="this.DetailTabs"
                        @bind-ActiveTab="this.ActiveDetailTab"
                        ShowCollapseButton="false">
                        <ChildContent>
                            <PropertyRow Label="Lifecycle" Variant="PropertyRowVariant.Inline">
                                <ValueContent>
                                    <Chip Variant="ChipVariant.Lifecycle" Color="var(--mb-color-lifecycle-review)">In review</Chip>
                                </ValueContent>
                            </PropertyRow>
                            <PropertyRow Label="Allocated requirement" Value="REQ-ADCS-042" IsMonospace="true"/>
                            <PropertyRow Label="Reviewer" Value="Project Admin"/>
                        </ChildContent>
                    </DetailPanel>
                </div>

                <Panel Padding="PanelPadding.None" OverflowHidden="true" style="height: 280px;">
                    <Toolbar HasBottomBorder="true">
                        <StartContent>
                            <strong class="mb-text-label-md">ProjectBrowser</strong>
                        </StartContent>
                        <EndContent>
                            <StatusIndicator Variant="StatusIndicatorVariant.Success" Label="Loaded"/>
                        </EndContent>
                    </Toolbar>

                    <ProjectBrowser
                        ViewModel="this.ProjectBrowserViewModel"
                        SelectedNodeChanged="this.HandleProjectBrowserNodeSelectedAsync"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">DataTable</h2>

                    <DataTable Columns="this.TableColumns" Items="this.TableRows"/>
                </Panel>

                <Panel Padding="PanelPadding.None" OverflowHidden="true">
                    <StatusBar Items="this.StatusItems">
                        <StartContent>
                            <span>Spacecraft.sysml</span>
                        </StartContent>
                        <EndContent>
                            <span>Branch: review/aocs-reaction-wheel</span>
                        </EndContent>
                    </StatusBar>
                </Panel>

                <Panel Padding="PanelPadding.None" OverflowHidden="true">
                    <WorkspaceShell ShowLeftPanel="true" ShowRightPanel="true" style="height: 520px;">
                        <HeaderContent>
                            <AppHeader
                                Title="WorkspaceShell"
                                Subtitle="Integrated preview"
                                ShowSearch="false"
                                ShowUserAvatar="false">
                                <ActionsContent>
                                    <Button Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Commit</Button>
                                </ActionsContent>
                            </AppHeader>
                        </HeaderContent>
                        <LeftContent>
                            <ModelTree Items="this.ModelTreeItems" ActiveItemId="this.ActiveTreeItemId" ExpandAllByDefault="true"/>
                        </LeftContent>
                        <ChildContent>
                            <div style="height: 100%; padding: 16px;">
                                <CanvasToolbar
                                    BreadcrumbItems="this.CanvasBreadcrumbs"
                                    ActiveTool="this.ActiveCanvasTool"
                                    ZoomPercentage="this.CanvasZoomPercentage"
                                    FitToView="this.HandleCanvasFitToView"/>

                                <EmptyState Title="Diagram canvas" Description="Workspace preview area for AOCS blocks, constraints, allocations, and verification traces.">
                                    <IconContent>RW</IconContent>
                                    <ActionsContent>
                                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Open view</Button>
                                    </ActionsContent>
                                </EmptyState>
                            </div>
                        </ChildContent>
                        <RightContent>
                            <DetailPanel
                                Stereotype="constraint def"
                                Title="PointingAccuracy"
                                QualifiedName="Spacecraft::AOCS::PointingAccuracy"
                                Owner="AOCS"
                                Tabs="this.DetailTabs"
                                ActiveTab="properties"
                                ShowCollapseButton="false">
                                <ChildContent>
                                    <PropertyRow Label="Expression" Value="abs(error) &lt; 0.05 deg" IsMonospace="true"/>
                                    <PropertyRow Label="Source" Value="REQ-ADCS-011" IsMonospace="true"/>
                                </ChildContent>
                            </DetailPanel>
                        </RightContent>
                    </WorkspaceShell>
                </Panel>
            </div>
        </Panel>

        <Panel Padding="PanelPadding.Large">
            <SectionHeader Label="Feedback"/>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">StatusIndicator</h2>

                    <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                        @foreach (var statusSample in this.StatusIndicatorSamples)
                        {
                            <StatusIndicator Variant="@(statusSample.Variant)" Label="@(statusSample.Label)"/>
                        }
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">NotificationToast</h2>

                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <NotificationToast Notification="this.InfoToastNotification"/>
                        <NotificationToast Notification="this.SuccessToastNotification"/>
                        <NotificationToast Notification="this.WarningToastNotification"/>
                        <NotificationToast Notification="this.DangerToastNotification"/>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">ToastContainer</h2>

                    <ToastContainer
                        Notifications="this.SampleToastNotifications"
                        style="position: static; width: min(100%, 360px); max-width: 100%;"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">EmptyState</h2>

                    <EmptyState
                        Title="No verification cases selected"
                        Description="Select a verification package to inspect bound requirements and result traces.">
                        <IconContent>V</IconContent>
                        <ActionsContent>
                            <Button Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Create case</Button>
                            <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Browse library</Button>
                        </ActionsContent>
                    </EmptyState>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">LoadingState</h2>

                    <LoadingState
                        Title="Loading model elements"
                        Description="Fetching the latest workspace tree."/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">LoadingState with skeleton</h2>

                    <LoadingState
                        Title="Preparing properties"
                        Description="Building editable element fields."
                        ShowSpinner="false"
                        ShowSkeleton="true">
                        <SkeletonContent>
                            <Skeleton Lines="2"/>
                            <Skeleton Variant="SkeletonVariant.Rectangle" Height="64px"/>
                        </SkeletonContent>
                    </LoadingState>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">ConfirmDialog</h2>

                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="this.OpenDefaultConfirmDialog">
                            Default
                        </Button>
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="this.OpenWarningConfirmDialog">
                            Warning
                        </Button>
                        <Button Variant="ButtonVariant.Danger" Size="ButtonSize.Small" OnClick="this.OpenDangerConfirmDialog">
                            Danger
                        </Button>
                    </div>

                    <ConfirmDialog
                        IsOpen="this.IsDefaultConfirmDialogOpen"
                        IsOpenChanged="value => this.IsDefaultConfirmDialogOpen = value"
                        Title="Commit workspace changes"
                        Message="Commit the selected SysML updates to the shared workspace?"
                        ConfirmText="Commit"
                        Confirmed="this.HandleDefaultConfirmDialogConfirmed"
                        Cancelled="this.HandleConfirmDialogCancelled"/>

                    <ConfirmDialog
                        IsOpen="this.IsWarningConfirmDialogOpen"
                        IsOpenChanged="value => this.IsWarningConfirmDialogOpen = value"
                        Title="Continue with unresolved review"
                        Message="One requirement trace still needs owner confirmation. Continue anyway?"
                        ConfirmText="Continue"
                        Variant="ConfirmDialogVariant.Warning"
                        Confirmed="this.HandleWarningConfirmDialogConfirmed"
                        Cancelled="this.HandleConfirmDialogCancelled"/>

                    <ConfirmDialog
                        IsOpen="this.IsDangerConfirmDialogOpen"
                        IsOpenChanged="value => this.IsDangerConfirmDialogOpen = value"
                        Title="Delete model element"
                        Message="Delete ReactionWheelAssembly and remove its local relationships from this workspace?"
                        ConfirmText="Delete"
                        Variant="ConfirmDialogVariant.Danger"
                        Confirmed="this.HandleDangerConfirmDialogConfirmed"
                        Cancelled="this.HandleConfirmDialogCancelled"/>
                </Panel>
            </div>
        </Panel>

        <Panel Padding="PanelPadding.Large">
            <SectionHeader Label="Forms"/>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">Checkbox</h2>

                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <Checkbox
                            @bind-Checked="this.UncheckedCheckboxValue"
                            Label="Include derived relationships"
                            Id="design-system-checkbox-unchecked"/>

                        <Checkbox
                            @bind-Checked="this.CheckedCheckboxValue"
                            Label="Notify workspace participants"
                            Id="design-system-checkbox-checked"/>

                        <Checkbox
                            @bind-Checked="this.DisabledCheckboxValue"
                            Label="Update locked baseline"
                            Disabled="true"
                            Id="design-system-checkbox-disabled"/>

                        <Checkbox
                            @bind-Checked="this.DescribedCheckboxValue"
                            Label="Run validation before commit"
                            Description="Checks requirement traces, ownership, and package constraints."
                            Required="true"
                            Id="design-system-checkbox-description"/>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">Toggle</h2>

                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <Toggle
                            @bind-Checked="this.OffToggleValue"
                            Label="Live collaboration"
                            Id="design-system-toggle-off"/>

                        <Toggle
                            @bind-Checked="this.OnToggleValue"
                            Label="Auto-save workspace"
                            Id="design-system-toggle-on"/>

                        <Toggle
                            @bind-Checked="this.DisabledToggleValue"
                            Label="Protected branch"
                            Disabled="true"
                            Id="design-system-toggle-disabled"/>

                        <Toggle
                            @bind-Checked="this.StateTextToggleValue"
                            Label="Ownership enforcement"
                            Description="Blocks edits outside the active subsystem responsibility."
                            OnText="On"
                            OffText="Off"
                            Id="design-system-toggle-state-text"/>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">TextInput</h2>

                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <TextInput
                            @bind-Value="this.DefaultTextInputValue"
                            Placeholder="Element name"
                            Id="design-system-text-default"/>

                        <TextInput
                            @bind-Value="this.HelpTextInputValue"
                            Label="Package"
                            HelpText="Use the qualified namespace path."
                            Required="true"
                            Id="design-system-text-help"/>

                        <TextInput
                            @bind-Value="this.ErrorTextInputValue"
                            Label="Requirement ID"
                            ErrorText="Use hyphenated requirement IDs, for example REQ-ADCS-042."
                            Required="true"
                            Id="design-system-text-error"/>

                        <TextInput
                            @bind-Value="this.DisabledTextInputValue"
                            Label="Lifecycle state"
                            Disabled="true"
                            Id="design-system-text-disabled"/>

                        <TextInput
                            @bind-Value="this.AdornedTextInputValue"
                            Label="Pointing tolerance"
                            Type="number"
                            Id="design-system-text-adorned">
                            <StartContent>
                                +/-
                            </StartContent>
                            <EndContent>
                                deg
                            </EndContent>
                        </TextInput>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">TextArea</h2>

                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <TextArea
                            @bind-Value="this.DefaultTextAreaValue"
                            Placeholder="Review notes"
                            Id="design-system-text-area-default"/>

                        <TextArea
                            @bind-Value="this.HelpTextAreaValue"
                            Label="Review notes"
                            HelpText="Summarize the model change in one or two short paragraphs."
                            Required="true"
                            Id="design-system-text-area-help"/>

                        <TextArea
                            @bind-Value="this.ErrorTextAreaValue"
                            Label="Change rationale"
                            ErrorText="A rationale is required before requesting review."
                            Required="true"
                            Id="design-system-text-area-error"/>

                        <TextArea
                            @bind-Value="this.DisabledTextAreaValue"
                            Label="Baseline note"
                            Disabled="true"
                            Id="design-system-text-area-disabled"/>

                        <TextArea
                            @bind-Value="this.ReadOnlyTextAreaValue"
                            Label="Generated summary"
                            ReadOnly="true"
                            Id="design-system-text-area-readonly"/>

                        <TextArea
                            @bind-Value="this.CountedTextAreaValue"
                            Label="Reviewer message"
                            MaxLength="120"
                            ShowCharacterCount="true"
                            Rows="3"
                            Id="design-system-text-area-count"/>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">SelectInput</h2>

                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <SelectInput
                            @bind-Value="this.DefaultSelectInputValue"
                            Options="this.LifecycleSelectOptions"
                            Id="design-system-select-default"/>

                        <SelectInput
                            @bind-Value="this.HelpSelectInputValue"
                            Label="Subsystem owner"
                            Options="this.SubsystemSelectOptions"
                            Placeholder="Choose owner"
                            HelpText="Select the team responsible for the element."
                            Required="true"
                            Id="design-system-select-help"/>

                        <SelectInput
                            @bind-Value="this.ErrorSelectInputValue"
                            Label="Review owner"
                            Options="this.SubsystemSelectOptions"
                            ErrorText="External suppliers cannot own this review."
                            Required="true"
                            Id="design-system-select-error"/>

                        <SelectInput
                            @bind-Value="this.DisabledSelectInputValue"
                            Label="Access"
                            Options="this.AccessSelectOptions"
                            Disabled="true"
                            Id="design-system-select-disabled"/>

                        <SelectInput
                            @bind-Value="this.AdornedSelectInputValue"
                            Label="Domain"
                            Options="this.SubsystemSelectOptions"
                            Id="design-system-select-adorned">
                            <StartContent>
                                #
                            </StartContent>
                        </SelectInput>

                        <SelectInput
                            @bind-Value="this.SysmlSelectInputValue"
                            Label="SysML element"
                            Options="this.SysmlSelectOptions"
                            Id="design-system-select-sysml"/>
                    </div>
                </Panel>
            </div>
        </Panel>

        <Panel Padding="PanelPadding.Large">
            <SectionHeader Label="Collaboration"/>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">CollaboratorStack</h2>

                    <div style="display: flex; flex-direction: column; gap: 12px; align-items: flex-start;">
                        <CollaboratorStack Items="this.CollaboratorStackItems"/>
                        <CollaboratorStack Items="this.CollaboratorStackItems" MaxVisible="3"/>
                    </div>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">CommentThread</h2>

                    <CommentThread
                        Comments="this.CommentItems"
                        @bind-NewCommentValue="this.NewCommentValue"
                        CommentSubmitted="this.HandleCommentSubmitted"
                        CommentResolved="this.HandleCommentResolved"
                        CommentDeleted="this.HandleCommentDeleted"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">HistoryTimeline</h2>

                    <HistoryTimeline Items="this.HistoryTimelineItems"/>
                </Panel>

                <Panel Padding="PanelPadding.Medium">
                    <h2 class="mb-text-heading-xs" style="margin-bottom: 12px;">ActivityFeed</h2>

                    <ActivityFeed Items="this.ActivityFeedItems"/>
                </Panel>
            </div>
        </Panel>
    </main>
</div>
