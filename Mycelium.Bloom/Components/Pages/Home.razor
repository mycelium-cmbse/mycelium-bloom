@page "/"

<PageTitle>Mycelium - Bloom</PageTitle>

<WorkspaceShell style="height: calc(100vh - 32px); max-height: calc(100vh - 32px); min-height: 0;">
    <HeaderContent>
        <AppHeader
            Title="Mycelium Bloom"
            Subtitle="Quantities model workspace"
            SearchId="global-search"
            @bind-SearchValue="this.SearchText"
            SearchPlaceholder="Search model elements"
            EnableSearchShortcut="true"
            UserName="Project Admin"
            UserInitials="PA">
            <ActionsContent>
                <StatusIndicator Variant="StatusIndicatorVariant.Success" Label="Quantities loaded"/>
            </ActionsContent>
        </AppHeader>
    </HeaderContent>

    <LeftContent>
        <div style="height: 100%; max-height: 100%; min-height: 0; display: flex; flex-direction: column; overflow: hidden;">
            <Toolbar HasBottomBorder="true">
                <StartContent>
                    <strong class="mb-text-label-md">Model</strong>
                </StartContent>
                <ChildContent>
                    <StatusIndicator Variant="StatusIndicatorVariant.Info" Label="Quantities"/>
                </ChildContent>
                <EndContent>
                    <IconButton AriaLabel="Filter model" Title="Filter model">?</IconButton>
                </EndContent>
            </Toolbar>

            <div style="flex: 1 1 auto; height: 100%; max-height: 100%; min-height: 0; overflow: hidden;">
                <ProjectBrowser
                    ViewModel="this.ProjectBrowserViewModel"
                    SelectedNodeChanged="this.HandleProjectBrowserNodeSelectedAsync"/>
            </div>
        </div>
    </LeftContent>

    <ChildContent>
        <div style="height: 100%; min-height: 0; display: flex; flex-direction: column; gap: 16px; padding: 16px; overflow: auto;">
            <Panel Padding="PanelPadding.Medium">
                <SectionHeader Label="Workspace"/>

                <div style="margin-top: 16px;">
                    <p class="mb-text-label-xs" style="color: var(--mb-color-text-muted);">
                        Selected element
                    </p>

                    <p class="mb-text-heading-xs" style="margin-top: 4px; color: var(--mb-color-text-primary);">
                        @(this.SelectedModelElementName)
                    </p>
                </div>
            </Panel>

            <Panel Padding="PanelPadding.Medium">
                <LoadingState
                    Title="Workspace in progress"
                    Description="Project Browser integration is the active workspace prototype."
                    ShowSpinner="false"
                    ShowSkeleton="true">
                    <SkeletonContent>
                        <Skeleton Lines="2"/>
                        <Skeleton Variant="SkeletonVariant.Rectangle" Height="220px"/>
                    </SkeletonContent>
                </LoadingState>
            </Panel>
        </div>
    </ChildContent>

    <RightContent>
        <div style="height: 100%; min-height: 0; padding: 16px; overflow: auto;">
            <Panel Padding="PanelPadding.Medium">
                <SectionHeader Label="Details"/>

                <div style="margin-top: 16px;">
                    <EmptyState
                        Title="Details in progress"
                        Description="Element properties will use the selected Project Browser node.">
                        <IconContent>PB</IconContent>
                    </EmptyState>
                </div>
            </Panel>
        </div>
    </RightContent>
</WorkspaceShell>

<StatusBar Items="this.StatusItems">
    <StartContent>
        <span>Quantities.sysmlx</span>
    </StartContent>
    <EndContent>
        <span>Issue #8 Project Browser</span>
    </EndContent>
</StatusBar>
