@page "/"

<PageTitle>Mycelium - Bloom</PageTitle>

<div class="min-h-screen bg-(--mb-color-background) p-4 text-(--mb-color-text-primary)">
    <div class="mx-auto flex h-[calc(100vh-2rem)] min-h-0 max-w-7xl gap-4">
        <aside class="flex w-80 min-w-0 flex-col overflow-hidden rounded-lg border border-slate-200 bg-white">
            <header class="flex h-14 shrink-0 flex-col justify-center border-b border-slate-200 px-4">
                <h1 class="mb-text-heading-xs">
                    Project Browser
                </h1>
                <p class="mb-text-body-sm text-(--mb-color-text-muted)">
                    Quantities model
                </p>
            </header>

            <div class="min-h-0 flex-1">
                <ProjectBrowser
                    ViewModel="this.ProjectBrowserViewModel"
                    SelectedNodeChanged="this.HandleProjectBrowserNodeSelectedAsync"/>
            </div>
        </aside>

        <main class="flex min-w-0 flex-1 flex-col gap-4 overflow-auto rounded-lg border border-slate-200 bg-white p-4">
            <section>
                <p class="mb-text-label-xs text-(--mb-color-text-muted)">
                    Selected element
                </p>
                <h2 class="mb-text-heading-sm mt-1">
                    @(this.SelectedModelElementName)
                </h2>
            </section>

            <section class="rounded-lg border border-slate-200 p-4">
                <h3 class="mb-text-heading-xs">
                    Workspace
                </h3>
                <p class="mb-text-body-sm mt-2 text-(--mb-color-text-secondary)">
                    Element workspace content will use the selected Project Browser node.
                </p>
            </section>
        </main>
    </div>
</div>
