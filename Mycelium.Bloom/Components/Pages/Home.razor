@page "/"
@inherits ComponentBase

<PageTitle>Mycelium - Bloom</PageTitle>

<div class="min-h-screen bg-(--mb-color-background) p-4 text-(--mb-color-text-primary)">
    <div class="mx-auto h-[calc(100vh-2rem)] min-h-0 max-w-7xl">
        <WorkspaceShell>
            <LeftPanel>
                <div class="flex min-h-0 flex-col overflow-hidden" style="height: 100%;">
                    <header class="flex h-14 shrink-0 flex-col justify-center border-b border-slate-200 px-4">
                        <h1 class="mb-text-heading-xs">
                            Project Browser
                        </h1>
                        <p class="mb-text-body-sm text-(--mb-color-text-muted)">
                            Quantities model
                        </p>
                    </header>

                    <div class="min-h-0 flex-1">
                        <ProjectBrowser/>
                    </div>
                </div>
            </LeftPanel>

            <MainContent>
                <main class="flex min-w-0 flex-1 flex-col gap-4 overflow-auto p-4">
                    <section class="rounded-lg border border-slate-200 p-4">
                        <h2 class="mb-text-heading-xs">
                            Workspace
                        </h2>
                        <p class="mb-text-body-sm mt-2 text-(--mb-color-text-secondary)">
                            Element workspace content will use the selected element.
                        </p>
                    </section>
                </main>
            </MainContent>

            <RightPanel>
                <DetailsPanel Element="@this.ElementSelectionService.SelectedElement" />
            </RightPanel>
        </WorkspaceShell>
    </div>
</div>
