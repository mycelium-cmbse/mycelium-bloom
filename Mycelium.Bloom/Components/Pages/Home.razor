@page "/"

<PageTitle>Mycelium - Bloom</PageTitle>

<WorkspaceShell style="height: calc(100vh - 112px); min-height: 680px;">
    <HeaderContent>
        <AppHeader
            Title="Mycelium Bloom"
            Subtitle="AuroraSat collaborative workspace"
            SearchId="global-search"
            @bind-SearchValue="this.SearchText"
            SearchPlaceholder="Search model elements"
            EnableSearchShortcut="true"
            UserName="Omrane Haj Mohamed"
            UserInitials="OH">
            <ActionsContent>
                <StatusIndicator Variant="StatusIndicatorVariant.Success" Label="Synced"/>
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Share</Button>
                <Button Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Commit</Button>
            </ActionsContent>
        </AppHeader>
    </HeaderContent>

    <LeftContent>
        <Toolbar HasBottomBorder="true">
            <StartContent>
                <strong class="mb-text-label-md">Model</strong>
            </StartContent>
            <ChildContent></ChildContent>
            <EndContent>
                <IconButton AriaLabel="Filter model" Title="Filter model">?</IconButton>
            </EndContent>
        </Toolbar>

        <div style="height: calc(100% - 45px); min-height: 0;">
            <ProjectBrowser
                ViewModel="this.ProjectBrowserViewModel"
                SelectedNodeChanged="this.SelectProjectBrowserNodeAsync"/>
        </div>
    </LeftContent>

    <ChildContent>
        <div style="height: 100%; display: flex; flex-direction: column; gap: 16px; padding: 16px; overflow: auto;">
            <Panel Padding="PanelPadding.Medium">
                <SectionHeader Label="Workspace"/>

                <div style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
                    <Panel Padding="PanelPadding.Small">
                        <p class="mb-text-label-xs" style="color: var(--mb-color-text-muted);">Package</p>
                        <p class="mb-text-heading-xs" style="color: var(--mb-color-text-primary);">AuroraSat</p>
                    </Panel>

                    <Panel Padding="PanelPadding.Small">
                        <p class="mb-text-label-xs" style="color: var(--mb-color-text-muted);">Selected</p>
                        <p class="mb-text-heading-xs" style="color: var(--mb-color-text-primary);">@(this.SelectedProjectBrowserNodeName)</p>
                    </Panel>

                    <Panel Padding="PanelPadding.Small">
                        <p class="mb-text-label-xs" style="color: var(--mb-color-text-muted);">Review</p>
                        <p class="mb-text-heading-xs" style="color: var(--mb-color-text-primary);">2 pending</p>
                    </Panel>
                </div>
            </Panel>

            <Panel Padding="PanelPadding.Medium">
                <SectionHeader Label="Requirement Trace"/>

                <div style="margin-top: 16px;">
                    <DataTable Columns="this.TableColumns" Items="this.TableRows"/>
                </div>
            </Panel>

            <Panel Padding="PanelPadding.Medium">
                <EmptyState
                    Title="Diagram canvas prototype"
                    Description="This workspace area is reserved for the interactive model view as the app prototype evolves.">
                    <IconContent>[]</IconContent>
                    <ActionsContent>
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Open block view</Button>
                    </ActionsContent>
                </EmptyState>
            </Panel>
        </div>
    </ChildContent>

    <RightContent>
        <DetailPanel
            Stereotype="part"
            Title="AttitudeController"
            QualifiedName="AuroraSat::ADCS::AttitudeController"
            Owner="AOCS"
            OwnerColor="var(--mb-color-ownership-aocs)"
            Tabs="this.DetailTabs"
            @bind-ActiveTab="this.ActiveDetailTab">
            <ChildContent>
                <PropertyRow Label="Lifecycle" Variant="PropertyRowVariant.Inline">
                    <ValueContent>
                        <Chip Variant="ChipVariant.Lifecycle" Color="var(--mb-color-lifecycle-review)">In review</Chip>
                    </ValueContent>
                </PropertyRow>
                <PropertyRow Label="Allocated requirement" Value="REQ-ADCS-042" IsMonospace="true"/>
                <PropertyRow Label="Owner" Value="AOCS"/>
                <PropertyRow Label="Modified by" Value="Omrane Haj Mohamed"/>
            </ChildContent>
        </DetailPanel>
    </RightContent>
</WorkspaceShell>

<StatusBar Items="this.StatusItems">
    <StartContent>
        <span>AuroraSat.sysml</span>
    </StartContent>
    <EndContent>
        <span>Branch: review/adcs-controller</span>
    </EndContent>
</StatusBar>
