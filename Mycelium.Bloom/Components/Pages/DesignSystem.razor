@page "/design-system"

@using BlazorBlueprint.Icons.Lucide.Components
@using Mycelium.Bloom.Components.UI.Organisms.NavigationRail

<PageTitle>Bloom Design System</PageTitle>

<div class="mb-design-system">
    <header class="mb-design-system__page-header">
        <div class="mb-design-system__header-copy">
            <p class="mb-design-system__eyebrow">Development reference</p>
            <h1>Bloom design system</h1>
            <p class="mb-design-system__intro">
                Interactive examples of the reusable components available to Bloom application developers.
            </p>
        </div>

        <div class="mb-design-system__header-actions">
            <BbBadge
                Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                Class="mb-design-system__badge mb-design-system__badge--info">
                Local sample data
            </BbBadge>

            <div class="mb-design-system__theme-control"
                 role="group"
                 aria-label="Preview color theme">
                <button type="button"
                        class="@(this.GetThemeButtonCssClass("light"))"
                        aria-pressed="@(this.GetThemeAriaPressed("light"))"
                        @onclick='() => this.SetThemeAsync("light")'>
                    Light
                </button>
                <button type="button"
                        class="@(this.GetThemeButtonCssClass("dark"))"
                        aria-pressed="@(this.GetThemeAriaPressed("dark"))"
                        @onclick='() => this.SetThemeAsync("dark")'>
                    Dark
                </button>
            </div>
        </div>

        <nav class="mb-design-system__section-nav" aria-label="Design system sections">
            <a href="/design-system#foundation-heading">01 Foundation</a>
            <a href="/design-system#atoms-heading">02 Atoms</a>
            <a href="/design-system#molecules-heading">03 Molecules</a>
            <a href="/design-system#organisms-heading">04 Organisms</a>
            <a href="/design-system#workspace-heading">05 Workspace</a>
        </nav>
    </header>

    <section class="mb-design-system__section" data-section="foundation" aria-labelledby="foundation-heading">
        <div class="mb-design-system__section-heading">
            <p class="mb-design-system__section-index">01</p>
            <div>
                <h2 id="foundation-heading">Foundation</h2>
                <p>Typography, surfaces, color, radius, and spacing rendered from Bloom design variables.</p>
            </div>
        </div>

        <div class="mb-design-system__grid mb-design-system__grid--foundation">
            <article class="mb-design-system__example">
                <header class="mb-design-system__example-heading">
                    <h3>Typography</h3>
                    <p>Compact hierarchy for engineering workspaces.</p>
                </header>

                <div class="mb-design-system__typography">
                    <p class="mb-design-system__type-display">Workspace overview</p>
                    <p class="mb-design-system__type-heading">System architecture</p>
                    <p class="mb-design-system__type-body">Body text presents dense technical information without losing readability.</p>
                    <p class="mb-design-system__type-label">PROPERTY LABEL</p>
                    <code>part def Payload</code>
                </div>
            </article>

            <article class="mb-design-system__example">
                <header class="mb-design-system__example-heading">
                    <h3>Surfaces</h3>
                    <p>Neutral layers with subtle borders and a restrained accent.</p>
                </header>

                <div class="mb-design-system__surface-row">
                    <div class="mb-design-system__surface mb-design-system__surface--background">Background</div>
                    <div class="mb-design-system__surface mb-design-system__surface--surface">Surface</div>
                    <div class="mb-design-system__surface mb-design-system__surface--muted">Muted</div>
                    <div class="mb-design-system__surface mb-design-system__surface--accent">Accent</div>
                </div>
            </article>

            <article class="mb-design-system__example">
                <header class="mb-design-system__example-heading">
                    <h3>Spacing and radius</h3>
                    <p>A compact sample of the shared four-pixel scale.</p>
                </header>

                <div class="mb-design-system__spacing-list" aria-label="Spacing scale examples">
                    <span class="mb-design-system__spacing mb-design-system__spacing--one">4</span>
                    <span class="mb-design-system__spacing mb-design-system__spacing--two">8</span>
                    <span class="mb-design-system__spacing mb-design-system__spacing--three">12</span>
                    <span class="mb-design-system__spacing mb-design-system__spacing--four">16</span>
                    <span class="mb-design-system__spacing mb-design-system__spacing--six">24</span>
                </div>
            </article>
        </div>
    </section>

    <section class="mb-design-system__section" data-section="atoms" aria-labelledby="atoms-heading">
        <div class="mb-design-system__section-heading">
            <p class="mb-design-system__section-index">02</p>
            <div>
                <h2 id="atoms-heading">Atoms</h2>
                <p>Small controls and presentation primitives used throughout Bloom.</p>
            </div>
        </div>

        <div class="mb-design-system__grid">
            <article class="mb-design-system__example" data-component="avatar">
                <header class="mb-design-system__example-heading">
                    <h3>Blueprint avatars</h3>
                    <p>Initials and collaborator overflow at every supported size.</p>
                </header>

                <div class="mb-design-system__inline-group">
                    <span class="mb-design-system__avatar-frame"
                          style="--mb-design-system-avatar-background: var(--mb-color-collaborator-c06)"
                          title="Alex Lee">
                        <BbAvatar
                            Size="BlazorBlueprint.Components.AvatarSize.Small"
                            Class="mb-design-system__avatar mb-design-system__avatar--compact">
                            <BbAvatarFallback Class="mb-design-system__avatar-fallback">
                                AL
                            </BbAvatarFallback>
                        </BbAvatar>
                    </span>
                    <span class="mb-design-system__avatar-frame"
                          style="--mb-design-system-avatar-background: var(--mb-color-collaborator-c08)"
                          title="Morgan Ortiz">
                        <BbAvatar
                            Size="BlazorBlueprint.Components.AvatarSize.Small"
                            Class="mb-design-system__avatar">
                            <BbAvatarFallback Class="mb-design-system__avatar-fallback">
                                MO
                            </BbAvatarFallback>
                        </BbAvatar>
                    </span>
                    <span class="mb-design-system__avatar-frame"
                          style="--mb-design-system-avatar-background: var(--mb-color-collaborator-c10)"
                          title="Sam Kim">
                        <BbAvatar
                            Size="BlazorBlueprint.Components.AvatarSize.Default"
                            Class="mb-design-system__avatar">
                            <BbAvatarFallback Class="mb-design-system__avatar-fallback">
                                SK
                            </BbAvatarFallback>
                        </BbAvatar>
                    </span>
                    <span class="mb-design-system__avatar-frame mb-design-system__avatar-frame--more"
                          title="Four more collaborators">
                        <BbAvatar
                            Size="BlazorBlueprint.Components.AvatarSize.Small"
                            Class="mb-design-system__avatar">
                            <BbAvatarFallback Class="mb-design-system__avatar-fallback">
                                +4
                            </BbAvatarFallback>
                        </BbAvatar>
                    </span>
                </div>
            </article>

            <article class="mb-design-system__example" data-component="button">
                <header class="mb-design-system__example-heading">
                    <h3>Button</h3>
                    <p>Variants, sizes, progress, disabled state, and optional icons.</p>
                </header>

                <div class="mb-design-system__stack">
                    <div class="mb-design-system__inline-group">
                        <BbButton>Primary</BbButton>
                        <BbButton Variant="BlazorBlueprint.Components.ButtonVariant.Secondary">Secondary</BbButton>
                        <BbButton Variant="BlazorBlueprint.Components.ButtonVariant.Ghost">Ghost</BbButton>
                        <BbButton Variant="BlazorBlueprint.Components.ButtonVariant.Destructive">Danger</BbButton>
                    </div>
                    <div class="mb-design-system__inline-group">
                        <BbButton Size="BlazorBlueprint.Components.ButtonSize.Small">Small</BbButton>
                        <BbButton>Default</BbButton>
                        <BbButton Size="BlazorBlueprint.Components.ButtonSize.Large">Large</BbButton>
                        <BbButton Disabled="true">Disabled</BbButton>
                        <BbButton Loading="true" LoadingText="Loading">Loading</BbButton>
                    </div>
                    <div class="mb-design-system__inline-group">
                        <BbButton Variant="BlazorBlueprint.Components.ButtonVariant.Secondary">
                            <Icon>
                                <LucideIcon Name="plus"
                                            Size="16"
                                            StrokeWidth="1.75"
                                            role="presentation"
                                            aria-hidden="true"
                                            focusable="false" />
                            </Icon>
                            <ChildContent>Add element</ChildContent>
                        </BbButton>
                        <BbButton
                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                            IconPosition="BlazorBlueprint.Components.IconPosition.End">
                            <Icon>
                                <LucideIcon Name="arrow-right"
                                            Size="16"
                                            role="presentation"
                                            aria-hidden="true"
                                            focusable="false" />
                            </Icon>
                            <ChildContent>Continue</ChildContent>
                        </BbButton>
                    </div>
                </div>
            </article>

            <article class="mb-design-system__example" data-component="chip">
                <header class="mb-design-system__example-heading">
                    <h3>Blueprint badges</h3>
                    <p>Status, ownership, lifecycle, and custom-color labels.</p>
                </header>

                <div class="mb-design-system__inline-group">
                    <BbBadge
                        Variant="BlazorBlueprint.Components.BadgeVariant.Secondary"
                        Class="mb-design-system__badge">
                        Default
                    </BbBadge>
                    <BbBadge
                        Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                        Class="mb-design-system__badge mb-design-system__badge--info">
                        Info
                    </BbBadge>
                    <BbBadge
                        Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                        Class="mb-design-system__badge mb-design-system__badge--success">
                        Success
                    </BbBadge>
                    <BbBadge
                        Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                        Class="mb-design-system__badge mb-design-system__badge--warning">
                        Warning
                    </BbBadge>
                    <BbBadge
                        Variant="BlazorBlueprint.Components.BadgeVariant.Destructive"
                        Class="mb-design-system__badge">
                        Danger
                    </BbBadge>
                    <BbBadge
                        Variant="BlazorBlueprint.Components.BadgeVariant.Secondary"
                        Class="mb-design-system__badge">
                        <span class="mb-design-system__badge-dot"
                              style="background: var(--mb-color-ownership-aocs)"
                              aria-hidden="true"></span>
                        AOCS
                    </BbBadge>
                    <BbBadge
                        Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                        Class="mb-design-system__badge mb-design-system__badge--lifecycle">
                        <span class="mb-design-system__badge-dot"
                              style="background: var(--mb-color-lifecycle-review)"
                              aria-hidden="true"></span>
                        In review
                    </BbBadge>
                </div>
            </article>

            <article class="mb-design-system__example" data-component="icon-button">
                <header class="mb-design-system__example-heading">
                    <h3>Blueprint icon buttons</h3>
                    <p>Accessible icon-only actions in enabled and disabled states.</p>
                </header>

                <div class="mb-design-system__inline-group">
                    <BbButton
                        Type="BlazorBlueprint.Components.ButtonType.Button"
                        Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                        Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                        AriaLabel="Add model element"
                        title="Add model element">
                        <LucideIcon Name="plus"
                                    Size="16"
                                    StrokeWidth="1.75"
                                    role="presentation"
                                    aria-hidden="true"
                                    focusable="false" />
                    </BbButton>
                    <BbButton
                        Type="BlazorBlueprint.Components.ButtonType.Button"
                        Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                        Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                        AriaLabel="Edit selection"
                        title="Edit selection">
                        <LucideIcon Name="pencil"
                                    Size="16"
                                    StrokeWidth="1.75"
                                    role="presentation"
                                    aria-hidden="true"
                                    focusable="false" />
                    </BbButton>
                    <BbButton
                        Type="BlazorBlueprint.Components.ButtonType.Button"
                        Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                        Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                        AriaLabel="Remove selection"
                        title="Remove selection">
                        <LucideIcon Name="x"
                                    Size="16"
                                    StrokeWidth="1.75"
                                    role="presentation"
                                    aria-hidden="true"
                                    focusable="false" />
                    </BbButton>
                    <BbButton
                        Type="BlazorBlueprint.Components.ButtonType.Button"
                        Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                        Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                        AriaLabel="Unavailable action"
                        title="Unavailable action"
                        Disabled="true">
                        <LucideIcon Name="ellipsis"
                                    Size="16"
                                    StrokeWidth="1.75"
                                    role="presentation"
                                    aria-hidden="true"
                                    focusable="false" />
                    </BbButton>
                </div>
            </article>

            <article class="mb-design-system__example" data-component="card">
                <header class="mb-design-system__example-heading">
                    <h3>Blueprint cards</h3>
                    <p>Direct styled surfaces with local content composition.</p>
                </header>

                <div class="mb-design-system__panel-grid">
                    <BbCard
                        Class="mb-design-system__card mb-design-system__card--compact">
                        <p class="mb-design-system__compact-copy">Small padding for dense supporting content.</p>
                    </BbCard>
                    <BbCard Class="mb-design-system__card">
                        <div class="mb-design-system__section-header">
                            <span class="mb-design-system__section-header-label">Properties</span>
                            <div class="mb-design-system__section-header-actions">
                                <BbBadge
                                    Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                                    Class="mb-design-system__badge mb-design-system__badge--info">
                                    12
                                </BbBadge>
                            </div>
                        </div>
                        <p class="mb-design-system__compact-copy">Header and content composed inside the default panel.</p>
                    </BbCard>
                </div>
            </article>

            <article class="mb-design-system__example" data-component="search-input">
                <header class="mb-design-system__example-heading">
                    <h3>SearchInput</h3>
                    <p>Empty, populated, disabled, live-bound, and per-instance shortcut states.</p>
                </header>

                <div class="mb-design-system__form-grid">
                    <div>
                        <span class="mb-design-system__state-label">Empty</span>
                        <SearchInput Id="showcase-search-empty" Placeholder="Search elements" ShowShortcut="false" FullWidth="true" />
                    </div>
                    <div>
                        <span class="mb-design-system__state-label">Interactive</span>
                        <SearchInput Id="showcase-search-input" Value="@this.SearchValue" ValueChanged="this.HandleSearchValueChanged" ShowShortcut="false" FullWidth="true" />
                    </div>
                    <div>
                        <span class="mb-design-system__state-label">Disabled</span>
                        <SearchInput Id="showcase-search-disabled" Value="requirements" Disabled="true" ShowShortcut="false" FullWidth="true" />
                    </div>
                    <div class="mb-design-system__shortcut-example">
                        <span class="mb-design-system__state-label">Live Ctrl/Cmd+K shortcut stack</span>
                        <SearchInput Id="showcase-search-shortcut"
                                     Value="@this.PrimaryShortcutSearchValue"
                                     ValueChanged="this.HandlePrimaryShortcutSearchValueChanged"
                                     Placeholder="Primary shortcut target"
                                     EnableShortcut="true"
                                     FullWidth="true" />

                        @if (this.SecondaryShortcutSearchVisible)
                        {
                            <SearchInput Id="showcase-search-shortcut-secondary"
                                         Value="@this.SecondaryShortcutSearchValue"
                                         ValueChanged="this.HandleSecondaryShortcutSearchValueChanged"
                                         Placeholder="Newest shortcut target"
                                         EnableShortcut="true"
                                         FullWidth="true" />
                        }

                        <BbButton
                            id="toggle-secondary-shortcut-search"
                            Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                            Size="BlazorBlueprint.Components.ButtonSize.Small"
                            Class="mb-design-system__shortcut-toggle"
                            OnClick="this.ToggleSecondaryShortcutSearch">
                            @(this.SecondaryShortcutSearchVisible ? "Remove newest target" : "Restore newest target")
                        </BbButton>
                    </div>
                </div>
                <p id="search-input-result" class="mb-design-system__result">Current search: @this.SearchValue</p>
                <p id="search-shortcut-result" class="mb-design-system__result">
                    Ctrl/Cmd+K target: @(this.SecondaryShortcutSearchVisible ? "secondary (newest)" : "primary (restored)")
                </p>
            </article>

            <article class="mb-design-system__example" data-component="section-header-composition">
                <header class="mb-design-system__example-heading">
                    <h3>Section header composition</h3>
                    <p>Ordinary semantic markup with optional supporting actions.</p>
                </header>

                <div class="mb-design-system__stack">
                    <div class="mb-design-system__section-header">
                        <span class="mb-design-system__section-header-label">Relationships</span>
                    </div>
                    <div class="mb-design-system__section-header">
                        <span class="mb-design-system__section-header-label">Owned elements</span>
                        <div class="mb-design-system__section-header-actions">
                            <BbButton
                                Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                Size="BlazorBlueprint.Components.ButtonSize.Small">
                                Add
                            </BbButton>
                        </div>
                    </div>
                </div>
            </article>

            <article class="mb-design-system__example" data-component="skeleton">
                <header class="mb-design-system__example-heading">
                    <h3>Blueprint skeletons</h3>
                    <p>Text, circle, rectangle, multiple lines, and custom dimensions.</p>
                </header>

                <div class="mb-design-system__skeleton-layout">
                    <BbSkeleton
                        Shape="BlazorBlueprint.Components.SkeletonShape.Circular"
                        Width="40px"
                        Height="40px" />
                    <div class="mb-design-system__skeleton-copy"
                         role="status"
                         aria-label="Loading content"
                         aria-busy="true">
                        <BbSkeleton Width="100%" Height="12px" />
                        <BbSkeleton Width="100%" Height="12px" />
                        <BbSkeleton Width="72%" Height="12px" />
                    </div>
                    <BbSkeleton Width="96px" Height="56px" />
                </div>
            </article>

            <article class="mb-design-system__example mb-design-system__example--wide" data-component="text-input">
                <header class="mb-design-system__example-heading">
                    <h3>Blueprint text inputs</h3>
                    <p>Labels, guidance, validation, access states, adornments, and live binding.</p>
                </header>

                <div class="mb-design-system__form-grid">
                    <FieldShell ControlId="showcase-text-input"
                                Label="Element name"
                                HelpText="Use a concise engineering name."
                                HelpTextId="showcase-text-input-help"
                                Required="true">
                        <BbInputGroup Class="mb-design-system__input-group">
                            <BbInputGroupAddon
                                Align="BlazorBlueprint.Components.InputGroupAlign.InlineStart">
                                <span aria-hidden="true">#</span>
                            </BbInputGroupAddon>
                            <BbInputGroupInput
                                Id="showcase-text-input"
                                Value="@this.TextInputValue"
                                ValueChanged="this.HandleTextInputValueChanged"
                                UpdateTiming="BlazorBlueprint.Components.UpdateTiming.Immediate"
                                Required="true"
                                AriaDescribedBy="showcase-text-input-help" />
                            <BbInputGroupAddon
                                Align="BlazorBlueprint.Components.InputGroupAlign.InlineEnd">
                                <LucideIcon Name="check"
                                            Size="16"
                                            StrokeWidth="1.75"
                                            role="presentation"
                                            aria-hidden="true"
                                            focusable="false" />
                            </BbInputGroupAddon>
                        </BbInputGroup>
                    </FieldShell>
                    <FieldShell ControlId="showcase-text-placeholder" Label="Owner">
                        <BbInputGroup Class="mb-design-system__input-group">
                            <BbInputGroupInput
                                Id="showcase-text-placeholder"
                                Placeholder="Select an owner"
                                UpdateTiming="BlazorBlueprint.Components.UpdateTiming.Immediate" />
                        </BbInputGroup>
                    </FieldShell>
                    <FieldShell ControlId="showcase-text-error"
                                Label="Identifier"
                                ErrorText="Use letters, numbers, and hyphens only."
                                ErrorTextId="showcase-text-error-error">
                        <BbInputGroup Class="mb-design-system__input-group">
                            <BbInputGroupInput
                                Id="showcase-text-error"
                                Value="invalid value"
                                UpdateTiming="BlazorBlueprint.Components.UpdateTiming.Immediate"
                                AriaInvalid="true"
                                AriaDescribedBy="showcase-text-error-error" />
                        </BbInputGroup>
                    </FieldShell>
                    <FieldShell ControlId="showcase-text-disabled"
                                Label="Generated ID"
                                Disabled="true">
                        <BbInputGroup Class="mb-design-system__input-group">
                            <BbInputGroupInput
                                Id="showcase-text-disabled"
                                Value="SYS-042"
                                UpdateTiming="BlazorBlueprint.Components.UpdateTiming.Immediate"
                                Disabled="true" />
                        </BbInputGroup>
                    </FieldShell>
                    <FieldShell ControlId="showcase-text-readonly"
                                Label="Qualified name"
                                ReadOnly="true">
                        <BbInputGroup
                            Class="mb-design-system__input-group mb-design-system__input-group--readonly">
                            <BbInputGroupInput
                                Id="showcase-text-readonly"
                                Value="Platform::Thermal"
                                UpdateTiming="BlazorBlueprint.Components.UpdateTiming.Immediate"
                                readonly="true" />
                        </BbInputGroup>
                    </FieldShell>
                </div>
                <p id="text-input-result" class="mb-design-system__result">Current value: @this.TextInputValue</p>
            </article>

            <article class="mb-design-system__example" data-component="select-input">
                <header class="mb-design-system__example-heading">
                    <h3>SelectInput</h3>
                    <p>Custom listbox states, long and disabled options, validation, and independent controlled instances.</p>
                </header>

                <div class="mb-design-system__stack">
                    <SelectInput Id="showcase-select-default"
                                 Label="Default state"
                                 Placeholder="Choose a state"
                                 Options="this.SelectOptions" />
                    <div class="mb-design-system__form-grid">
                        <SelectInput Id="showcase-select-input" Label="Primary lifecycle state" Placeholder="Choose a state" Options="this.SelectOptions" Value="@this.SelectValue" ValueChanged="this.HandleSelectValueChanged" />
                        <SelectInput Id="showcase-select-secondary" Label="Independent lifecycle state" Placeholder="Choose a state" Options="this.SelectOptions" Value="@this.SecondarySelectValue" ValueChanged="this.HandleSecondarySelectValueChanged" />
                    </div>
                    <div class="mb-design-system__inline-group">
                        <BbButton
                            Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                            Size="BlazorBlueprint.Components.ButtonSize.Small"
                            data-testid="set-primary-select-open"
                            OnClick="this.SetPrimarySelectToOpen">
                            Set primary to Open
                        </BbButton>
                        <BbButton
                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                            Size="BlazorBlueprint.Components.ButtonSize.Small"
                            data-testid="reset-primary-select"
                            OnClick="this.ResetPrimarySelect">
                            Reset primary
                        </BbButton>
                    </div>
                    <SelectInput Id="showcase-select-error" Label="Review state" Placeholder="Choose a state" Options="this.SelectOptions" ErrorText="A lifecycle state is required." Required="true" />
                    <SelectInput Id="showcase-select-disabled" Label="Locked state" Options="this.SelectOptions" Value="archived" Disabled="true" />
                </div>
                <p id="select-input-result" class="mb-design-system__result">Selected values: @this.SelectValue / @this.SecondarySelectValue</p>
            </article>

            <article class="mb-design-system__example" data-component="text-area">
                <header class="mb-design-system__example-heading">
                    <h3>TextArea</h3>
                    <p>Help, optional character count, validation, disabled, read-only, and bound-value states.</p>
                </header>

                <div class="mb-design-system__stack">
                    <TextArea Id="showcase-text-area" Label="Review note" Value="@this.TextAreaValue" ValueChanged="this.HandleTextAreaValueChanged" HelpText="Keep the note focused on the selected element." Rows="3" MaxLength="160" ShowCharacterCount="true" />
                    <TextArea Id="showcase-text-area-error" Label="Required rationale" ErrorText="Provide a rationale before continuing." Rows="2" />
                    <div class="mb-design-system__form-grid">
                        <TextArea Id="showcase-text-area-disabled" Label="Disabled" Value="Unavailable" Disabled="true" Rows="2" />
                        <TextArea Id="showcase-text-area-readonly" Label="Read-only" Value="Approved baseline" ReadOnly="true" Rows="2" />
                    </div>
                </div>
                <p id="text-area-result" class="mb-design-system__result">Current note: @this.TextAreaValue</p>
            </article>

            <article class="mb-design-system__example" data-component="checkbox">
                <header class="mb-design-system__example-heading">
                    <h3>Checkbox</h3>
                    <p>Checked, unchecked, disabled, descriptive, and live-bound states.</p>
                </header>

                <div class="mb-design-system__stack">
                    <Checkbox Id="showcase-checkbox" Label="Show inherited members" HelpText="Includes properties inherited from parent definitions." Checked="@this.CheckboxChecked" CheckedChanged="this.HandleCheckboxChanged" />
                    <Checkbox Id="showcase-checkbox-unchecked" Label="Include archived elements" />
                    <Checkbox Id="showcase-checkbox-disabled" Label="Protected baseline" Checked="true" Disabled="true" />
                </div>
                <p id="checkbox-result" class="mb-design-system__result">Inherited members: @(this.CheckboxChecked ? "shown" : "hidden")</p>
            </article>

            <article class="mb-design-system__example" data-component="toggle">
                <header class="mb-design-system__example-heading">
                    <h3>Blueprint switches</h3>
                    <p>Checked, unchecked, optional state text, disabled, descriptive, and live-bound states.</p>
                </header>

                <div class="mb-design-system__stack">
                    <label class="mb-design-system__switch" for="showcase-toggle">
                        <BbSwitch
                            Id="showcase-toggle"
                            Checked="@this.ToggleChecked"
                            CheckedChanged="this.HandleToggleChanged"
                            Size="BlazorBlueprint.Components.SwitchSize.Small"
                            AriaLabel="Live collaboration"
                            AriaDescribedBy="showcase-toggle-description" />
                        <span class="mb-design-system__switch-state" aria-hidden="true">
                            @(this.ToggleChecked ? "Active" : "Paused")
                        </span>
                        <span class="mb-design-system__switch-content">
                            <span class="mb-design-system__switch-label">Live collaboration</span>
                            <span id="showcase-toggle-description" class="mb-design-system__switch-description">
                                Display collaborator presence in this workspace.
                            </span>
                        </span>
                    </label>
                    <label class="mb-design-system__switch" for="showcase-toggle-checked">
                        <BbSwitch
                            Id="showcase-toggle-checked"
                            Checked="true"
                            Size="BlazorBlueprint.Components.SwitchSize.Small"
                            AriaLabel="Automatic layout" />
                        <span class="mb-design-system__switch-content">
                            <span class="mb-design-system__switch-label">Automatic layout</span>
                        </span>
                    </label>
                    <label class="mb-design-system__switch mb-design-system__switch--disabled"
                           for="showcase-toggle-disabled">
                        <BbSwitch
                            Id="showcase-toggle-disabled"
                            Checked="true"
                            Disabled="true"
                            Size="BlazorBlueprint.Components.SwitchSize.Small"
                            AriaLabel="Protected branch"
                            AriaDescribedBy="showcase-toggle-disabled-description" />
                        <span class="mb-design-system__switch-content">
                            <span class="mb-design-system__switch-label">Protected branch</span>
                            <span id="showcase-toggle-disabled-description"
                                  class="mb-design-system__switch-description">
                                Controlled by project policy.
                            </span>
                        </span>
                    </label>
                </div>
                <p id="toggle-result" class="mb-design-system__result">Live collaboration: @(this.ToggleChecked ? "on" : "off")</p>
            </article>
        </div>
    </section>

    <section class="mb-design-system__section" data-section="molecules" aria-labelledby="molecules-heading">
        <div class="mb-design-system__section-heading">
            <p class="mb-design-system__section-index">03</p>
            <div>
                <h2 id="molecules-heading">Molecules</h2>
                <p>Composed controls for navigation, feedback, menus, and modal workflows.</p>
            </div>
        </div>

        <div class="mb-design-system__grid">
            <article class="mb-design-system__example mb-design-system__example--wide" data-component="tabs">
                <header class="mb-design-system__example-heading">
                    <h3>Tabs</h3>
                    <p>Controlled selection, roving tabindex, arrow navigation, Home, End, and a disabled destination.</p>
                </header>

                <div class="mb-design-system__tabs-gallery">
                    <div class="mb-design-system__tabs-example">
                        <span class="mb-design-system__state-label">Automatic horizontal tabs</span>
                        <BbTabs
                            Value="@this.ActiveTabValue"
                            ValueChanged="this.HandleTabChanged"
                            Orientation="BlazorBlueprint.Primitives.Tabs.TabsOrientation.Horizontal"
                            ActivationMode="BlazorBlueprint.Primitives.Tabs.TabsActivationMode.Automatic"
                            Class="mb-design-system__tabs"
                            data-testid="tabs-horizontal">
                            <BlazorBlueprint.Primitives.Tabs.BbTabsList
                                class="mb-design-system__tabs-list"
                                aria-label="Element detail sections">
                                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger
                                    Value="overview"
                                    class="mb-design-system__tabs-trigger"
                                    aria-selected='@(GetTabAriaSelected(this.ActiveTabValue, "overview"))'>
                                    Overview
                                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
                                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger
                                    Value="properties"
                                    class="mb-design-system__tabs-trigger"
                                    aria-selected='@(GetTabAriaSelected(this.ActiveTabValue, "properties"))'>
                                    Properties
                                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
                                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger
                                    Value="relationships"
                                    class="mb-design-system__tabs-trigger"
                                    aria-selected='@(GetTabAriaSelected(this.ActiveTabValue, "relationships"))'>
                                    Cross-domain relationships and allocations
                                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
                                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger
                                    Value="history"
                                    Disabled="true"
                                    class="mb-design-system__tabs-trigger"
                                    aria-selected='@(GetTabAriaSelected(this.ActiveTabValue, "history"))'
                                    aria-disabled="true">
                                    History
                                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
                            </BlazorBlueprint.Primitives.Tabs.BbTabsList>

                            <BbTabsContent
                                Value="overview"
                                Class="mb-design-system__tabs-content">
                                <div class="mb-design-system__tab-panel">
                                    <strong>Overview panel</strong>
                                    <span>Summary information for the selected element.</span>
                                </div>
                            </BbTabsContent>
                            <BbTabsContent
                                Value="properties"
                                Class="mb-design-system__tabs-content">
                                <div class="mb-design-system__tab-panel">
                                    <strong>Properties panel</strong>
                                    <span>Editable values remain controlled by the page.</span>
                                </div>
                            </BbTabsContent>
                            <BbTabsContent
                                Value="relationships"
                                Class="mb-design-system__tabs-content">
                                <div class="mb-design-system__tab-panel">
                                    <strong>Relationships panel</strong>
                                    <span>Long labels remain contained by the compact tab list.</span>
                                </div>
                            </BbTabsContent>
                            <BbTabsContent
                                Value="history"
                                Class="mb-design-system__tabs-content">
                                <div class="mb-design-system__tab-panel">
                                    <strong>History panel</strong>
                                    <span>This disabled destination cannot be selected.</span>
                                </div>
                            </BbTabsContent>
                        </BbTabs>
                        <div class="mb-design-system__tabs-controls">
                            <BbButton
                                Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                                Size="BlazorBlueprint.Components.ButtonSize.Small"
                                OnClick='() => this.HandleTabChanged("overview")'>
                                Select overview externally
                            </BbButton>
                        </div>
                        <p id="tabs-result" class="mb-design-system__result">Selected tab: @this.ActiveTabValue</p>
                    </div>

                    <div class="mb-design-system__tabs-example">
                        <span class="mb-design-system__state-label">Manual vertical tabs</span>
                        <BbTabs
                            Value="@this.ActiveReviewTabValue"
                            ValueChanged="this.HandleReviewTabChanged"
                            Orientation="BlazorBlueprint.Primitives.Tabs.TabsOrientation.Vertical"
                            ActivationMode="BlazorBlueprint.Primitives.Tabs.TabsActivationMode.Manual"
                            Class="mb-design-system__tabs mb-design-system__tabs--vertical"
                            data-testid="tabs-vertical">
                            <BlazorBlueprint.Primitives.Tabs.BbTabsList
                                class="mb-design-system__tabs-list mb-design-system__tabs-list--vertical"
                                aria-label="Element review sections">
                                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger
                                    Value="summary"
                                    class="mb-design-system__tabs-trigger"
                                    aria-selected='@(GetTabAriaSelected(this.ActiveReviewTabValue, "summary"))'>
                                    Summary
                                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
                                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger
                                    Value="verification"
                                    class="mb-design-system__tabs-trigger"
                                    aria-selected='@(GetTabAriaSelected(this.ActiveReviewTabValue, "verification"))'>
                                    Verification
                                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
                                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger
                                    Value="traceability"
                                    class="mb-design-system__tabs-trigger"
                                    aria-selected='@(GetTabAriaSelected(this.ActiveReviewTabValue, "traceability"))'>
                                    Traceability across subsystem boundaries
                                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
                                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger
                                    Value="archive"
                                    Disabled="true"
                                    class="mb-design-system__tabs-trigger"
                                    aria-selected='@(GetTabAriaSelected(this.ActiveReviewTabValue, "archive"))'
                                    aria-disabled="true">
                                    Archive
                                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
                            </BlazorBlueprint.Primitives.Tabs.BbTabsList>

                            <BbTabsContent
                                Value="summary"
                                Class="mb-design-system__tabs-content">
                                <div class="mb-design-system__tab-panel">
                                    <strong>Summary panel</strong>
                                    <span>Manual activation separates focus movement from selection.</span>
                                </div>
                            </BbTabsContent>
                            <BbTabsContent
                                Value="verification"
                                Class="mb-design-system__tabs-content">
                                <div class="mb-design-system__tab-panel">
                                    <strong>Verification panel</strong>
                                    <span>Verification evidence for the selected element.</span>
                                </div>
                            </BbTabsContent>
                            <BbTabsContent
                                Value="traceability"
                                Class="mb-design-system__tabs-content">
                                <div class="mb-design-system__tab-panel">
                                    <strong>Traceability panel</strong>
                                    <span>Cross-workspace relationships remain readable.</span>
                                </div>
                            </BbTabsContent>
                            <BbTabsContent
                                Value="archive"
                                Class="mb-design-system__tabs-content">
                                <div class="mb-design-system__tab-panel">
                                    <strong>Archive panel</strong>
                                    <span>This disabled destination cannot be selected.</span>
                                </div>
                            </BbTabsContent>
                        </BbTabs>
                        <div class="mb-design-system__tabs-controls">
                            <BbButton
                                Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                                Size="BlazorBlueprint.Components.ButtonSize.Small"
                                OnClick='() => this.HandleReviewTabChanged("summary")'>
                                Select summary externally
                            </BbButton>
                        </div>
                        <p id="vertical-tabs-result" class="mb-design-system__result">
                            Selected review tab: @this.ActiveReviewTabValue
                        </p>
                    </div>
                </div>
            </article>

            <article class="mb-design-system__example" data-component="loading-state">
                <header class="mb-design-system__example-heading">
                    <h3>Loading composition</h3>
                    <p>Spinner, title, description, custom content, and skeleton area.</p>
                </header>

                <div class="mb-design-system__loading-state"
                     role="status"
                     aria-live="polite"
                     aria-busy="true">
                    <span class="mb-design-system__loading-spinner" aria-hidden="true"></span>
                    <div class="mb-design-system__loading-content">
                        <h2>Loading architecture</h2>
                        <p>Mapping local element relationships.</p>
                    </div>
                    <BbBadge
                        Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                        Class="mb-design-system__badge mb-design-system__badge--info">
                        Local operation
                    </BbBadge>
                    <div class="mb-design-system__loading-skeleton" aria-hidden="true">
                        <BbSkeleton Width="100%" Height="12px" />
                        <BbSkeleton Width="72%" Height="12px" />
                        <BbSkeleton Width="100%" Height="48px" />
                    </div>
                </div>
            </article>

            <article class="mb-design-system__example" data-component="empty-state">
                <header class="mb-design-system__example-heading">
                    <h3>Blueprint empty state</h3>
                    <p>Direct styled content with optional icon and action composition.</p>
                </header>

                <BbEmpty
                    Title="No relationships"
                    Description="Connect this element to show its dependencies.">
                    <Icon><span aria-hidden="true">◇</span></Icon>
                    <ChildContent>
                        <BbButton
                            Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                            Size="BlazorBlueprint.Components.ButtonSize.Small">
                            Add relationship
                        </BbButton>
                    </ChildContent>
                </BbEmpty>
            </article>

            <article class="mb-design-system__example" data-component="modal-shell">
                <header class="mb-design-system__example-heading">
                    <h3>ModalShell</h3>
                    <p>Interactive small and wide shells with header, body, footer, and backdrop closing.</p>
                </header>

                <div class="mb-design-system__inline-group">
                    <button
                        @ref="this.CompactModalTrigger"
                        type="button"
                        id="open-compact-modal"
                        class="mb-design-system__dialog-trigger"
                        @onclick="() => this.OpenModal(ModalSize.Small, this.CompactModalTrigger)">
                        Open compact modal
                    </button>
                    <button
                        @ref="this.WideModalTrigger"
                        type="button"
                        id="open-wide-modal"
                        class="mb-design-system__dialog-trigger mb-design-system__dialog-trigger--secondary"
                        @onclick="() => this.OpenModal(ModalSize.Wide, this.WideModalTrigger)">
                        Open wide modal
                    </button>
                </div>
                <p id="modal-result" class="mb-design-system__result">
                    @this.LastModalAction. State changes: @this.ModalStateChangeCount. Close callbacks: @this.ModalCloseCallbackCount.
                </p>
            </article>

            <article class="mb-design-system__example" data-component="confirm-dialog">
                <header class="mb-design-system__example-heading">
                    <h3>ConfirmDialog</h3>
                    <p>Default, warning, and danger confirmation workflows.</p>
                </header>

                <div class="mb-design-system__inline-group">
                    <button
                        @ref="this.DefaultConfirmDialogTrigger"
                        type="button"
                        id="open-default-confirm"
                        class="mb-design-system__dialog-trigger mb-design-system__dialog-trigger--secondary"
                        @onclick="() => this.OpenConfirmDialog(ConfirmDialogVariant.Default, this.DefaultConfirmDialogTrigger)">
                        Default
                    </button>
                    <button
                        @ref="this.WarningConfirmDialogTrigger"
                        type="button"
                        id="open-warning-confirm"
                        class="mb-design-system__dialog-trigger mb-design-system__dialog-trigger--secondary"
                        @onclick="() => this.OpenConfirmDialog(ConfirmDialogVariant.Warning, this.WarningConfirmDialogTrigger)">
                        Warning
                    </button>
                    <button
                        @ref="this.DangerConfirmDialogTrigger"
                        type="button"
                        id="open-danger-confirm"
                        class="mb-design-system__dialog-trigger mb-design-system__dialog-trigger--danger"
                        @onclick="() => this.OpenConfirmDialog(ConfirmDialogVariant.Danger, this.DangerConfirmDialogTrigger)">
                        Danger
                    </button>
                    <button
                        @ref="this.LoadingConfirmDialogTrigger"
                        type="button"
                        id="open-loading-confirm"
                        class="mb-design-system__dialog-trigger mb-design-system__dialog-trigger--secondary"
                        @onclick="() => this.OpenConfirmDialog(ConfirmDialogVariant.Default, this.LoadingConfirmDialogTrigger, true)">
                        Loading
                    </button>
                </div>
                <p id="confirm-result" class="mb-design-system__result">Latest result: @this.LastConfirmationAction</p>
            </article>

            <article class="mb-design-system__example mb-design-system__example--wide" data-component="breadcrumbs">
                <header class="mb-design-system__example-heading">
                    <h3>Blueprint breadcrumbs</h3>
                    <p>Direct interactive, disabled, and current destinations.</p>
                </header>

                <nav aria-label="Showcase hierarchy">
                    <ol class="flex flex-wrap items-center gap-1.5 break-words text-sm text-muted-foreground sm:gap-2.5">
                        <BbBreadcrumbList AutoSeparator="true">
                            <BbBreadcrumbItem>
                                <BbButton
                                    Type="BlazorBlueprint.Components.ButtonType.Button"
                                    Variant="BlazorBlueprint.Components.ButtonVariant.Link"
                                    Size="BlazorBlueprint.Components.ButtonSize.Small"
                                    Class="h-auto p-0 font-normal"
                                    OnClick='() => this.HandleBreadcrumbSelected("Workspace")'>
                                    Workspace
                                </BbButton>
                            </BbBreadcrumbItem>
                            <BbBreadcrumbItem>
                                <BbButton
                                    Type="BlazorBlueprint.Components.ButtonType.Button"
                                    Variant="BlazorBlueprint.Components.ButtonVariant.Link"
                                    Size="BlazorBlueprint.Components.ButtonSize.Small"
                                    Class="h-auto p-0 font-normal"
                                    OnClick='() => this.HandleBreadcrumbSelected("Projects")'>
                                    Projects
                                </BbButton>
                            </BbBreadcrumbItem>
                            <BbBreadcrumbItem>
                                <BbButton
                                    Type="BlazorBlueprint.Components.ButtonType.Button"
                                    Variant="BlazorBlueprint.Components.ButtonVariant.Link"
                                    Size="BlazorBlueprint.Components.ButtonSize.Small"
                                    Class="h-auto p-0 font-normal"
                                    Disabled="true">
                                    Restricted
                                </BbButton>
                            </BbBreadcrumbItem>
                            <BbBreadcrumbItem>
                                <BbBreadcrumbPage>Architecture</BbBreadcrumbPage>
                            </BbBreadcrumbItem>
                        </BbBreadcrumbList>
                    </ol>
                </nav>
                <p id="breadcrumbs-result" class="mb-design-system__result">Latest selection: @this.LastBreadcrumbSelection</p>
            </article>

            <article class="mb-design-system__example mb-design-system__example--wide" data-component="toolbar">
                <header class="mb-design-system__example-heading">
                    <h3>Toolbar composition</h3>
                    <p>Direct semantic grouping of leading context, actions, and trailing status.</p>
                </header>

                <div class="mb-design-system__toolbar"
                     role="toolbar"
                     aria-label="Element editing tools">
                    <div class="mb-design-system__toolbar-leading">
                        <BbBadge
                            Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                            Class="mb-design-system__badge mb-design-system__badge--lifecycle">
                            <span class="mb-design-system__badge-dot"
                                  style="background: var(--mb-color-lifecycle-open)"
                                  aria-hidden="true"></span>
                            Open
                        </BbBadge>
                    </div>
                    <div class="mb-design-system__toolbar-main">
                        <BbButton Size="BlazorBlueprint.Components.ButtonSize.Small">Save</BbButton>
                        <BbButton
                            Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                            Size="BlazorBlueprint.Components.ButtonSize.Small">
                            Validate
                        </BbButton>
                        <BbButton
                            Type="BlazorBlueprint.Components.ButtonType.Button"
                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                            Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                            AriaLabel="Undo latest edit"
                            title="Undo latest edit">
                            <LucideIcon Name="undo-2"
                                        Size="16"
                                        StrokeWidth="1.75"
                                        role="presentation"
                                        aria-hidden="true"
                                        focusable="false" />
                        </BbButton>
                    </div>
                    <div class="mb-design-system__toolbar-trailing">
                        <span class="mb-design-system__toolbar-status">Saved locally</span>
                    </div>
                </div>
            </article>

            <article class="mb-design-system__example mb-design-system__example--wide" data-component="action-menu">
                <header class="mb-design-system__example-heading">
                    <h3>ActionMenu</h3>
                    <p>Start/end alignment, stable icon columns, disabled and destructive states, and long labels.</p>
                </header>

                <div class="mb-design-system__menu-alignment-grid">
                    <div class="mb-design-system__menu-sample">
                        <span class="mb-design-system__state-label">Start aligned</span>
                        <ActionMenu data-testid="action-menu-primary" Items="this.ActionMenuItems" TriggerAriaLabel="Open start-aligned showcase actions" TriggerTitle="Start-aligned actions" Alignment="ActionMenuAlignment.Start" ItemSelected="this.HandleActionMenuItemSelected" />
                    </div>
                    <div class="mb-design-system__menu-sample mb-design-system__menu-sample--end">
                        <span class="mb-design-system__state-label">End aligned at the region edge</span>
                        <ActionMenu data-testid="action-menu-secondary" Items="this.ActionMenuItems" TriggerAriaLabel="Open end-aligned showcase actions" TriggerTitle="End-aligned actions" Alignment="ActionMenuAlignment.End" ItemSelected="this.HandleActionMenuItemSelected">
                            <TriggerContent><span>Actions</span></TriggerContent>
                        </ActionMenu>
                    </div>
                </div>
                <p id="action-menu-result" class="mb-design-system__result">Latest action: @this.LastMenuAction. Selection count: @this.ActionMenuSelectionCount</p>
            </article>

            <article class="mb-design-system__example" data-component="split-button">
                <header class="mb-design-system__example-heading">
                    <h3>SplitButton</h3>
                    <p>Normal, disabled, and loading connected controls with inherited menu behavior.</p>
                </header>

                <div class="mb-design-system__stack">
                    <SplitButton data-testid="split-button-normal" PrimaryText="Save" Items="this.SplitButtonItems" PrimaryAction="this.HandleSplitButtonPrimaryAction" ItemSelected="this.HandleSplitButtonItemSelected" MenuAriaLabel="Open save options" />
                    <SplitButton data-testid="split-button-secondary" PrimaryText="Export" Items="this.SplitButtonItems" ItemSelected="this.HandleSplitButtonItemSelected" MenuAriaLabel="Open export options" />
                    <SplitButton data-testid="split-button-disabled" PrimaryText="Unavailable" Items="this.SplitButtonItems" Disabled="true" MenuAriaLabel="Unavailable save options" />
                    <SplitButton data-testid="split-button-loading" PrimaryText="Saving" Items="this.SplitButtonItems" IsLoading="true" MenuAriaLabel="Loading save options" />
                </div>
                <p id="split-button-result" class="mb-design-system__result">Latest action: @this.LastSplitButtonAction</p>
            </article>

            <article class="mb-design-system__example" data-component="user-menu">
                <header class="mb-design-system__example-heading">
                    <h3>UserMenu</h3>
                    <p>Local identity presentation, normal and destructive actions, and compact mode.</p>
                </header>

                <div class="mb-design-system__inline-group mb-design-system__menu-row">
                    <UserMenu data-testid="user-menu-primary" DisplayName="Alex Morgan" Subtitle="alex@example.test" AvatarText="AM" Items="this.UserMenuItems" ItemSelected="this.HandleUserMenuItemSelected" />
                    <UserMenu data-testid="user-menu-secondary" DisplayName="Sam Lee" Subtitle="sam@example.test" AvatarText="SL" Items="this.UserMenuItems" Compact="true" ItemSelected="this.HandleUserMenuItemSelected" />
                </div>
                <p id="user-menu-result" class="mb-design-system__result">Latest action: @this.LastUserMenuAction</p>
            </article>

            <article class="mb-design-system__example mb-design-system__example--wide" data-component="project-switcher">
                <header class="mb-design-system__example-heading">
                    <h3>ProjectSwitcher</h3>
                    <p>Controlled local project choices, a disabled project, and independent instances.</p>
                </header>

                <div class="mb-design-system__switcher-grid">
                    <ProjectSwitcher data-testid="project-switcher-primary" Items="this.ProjectItems" SelectedProjectId="@this.PrimaryProjectId" SelectedProjectIdChanged="this.HandlePrimaryProjectChanged" AriaLabel="Select primary showcase project" />
                    <ProjectSwitcher data-testid="project-switcher-secondary" Items="this.ProjectItems" SelectedProjectId="@this.SecondaryProjectId" SelectedProjectIdChanged="this.HandleSecondaryProjectChanged" AriaLabel="Select secondary showcase project" />
                </div>
                <p id="project-switcher-result" class="mb-design-system__result">Latest selection: @this.LastProjectSelection</p>
            </article>
        </div>
    </section>

    <section class="mb-design-system__section" data-section="organisms" aria-labelledby="organisms-heading">
        <div class="mb-design-system__section-heading">
            <p class="mb-design-system__section-index">04</p>
            <div>
                <h2 id="organisms-heading">Organisms</h2>
                <p>Application-level compositions demonstrated without services or production data.</p>
            </div>
        </div>

        <div class="mb-design-system__grid">
            <article class="mb-design-system__example mb-design-system__example--wide" data-component="project-browser-future">
                <header class="mb-design-system__example-heading">
                    <h3>ProjectBrowser</h3>
                    <p>Reserved for a future feature showcase because the production component requires loaded SysML model data.</p>
                </header>

                <BbEmpty
                    Title="Not included in this showcase"
                    Description="A future scenario can provide an isolated loaded-model fixture without coupling this page to production loading." />
            </article>
        </div>
    </section>

    <section class="mb-design-system__section" data-section="workspace" aria-labelledby="workspace-heading">
        <div class="mb-design-system__section-heading">
            <p class="mb-design-system__section-index">05</p>
            <div>
                <h2 id="workspace-heading">Workspace</h2>
                <p>Composable layout regions and canvas controls for compact engineering workspaces.</p>
            </div>
        </div>

        <div class="mb-design-system__grid">
            <article id="navigation-rail-preview"
                     class="mb-design-system__example mb-design-system__example--wide"
                     data-component="navigation-rail">
                <header class="mb-design-system__example-heading">
                    <h3>NavigationRail</h3>
                    <p>Representative preview destinations with controlled selection and Expanded, Collapsed, and Expand on hover presentation modes.</p>
                </header>

                <div class="mb-design-system__navigation-rail-stage">
                    <NavigationRail ViewModel="this.NavigationRailPreviewViewModel"
                                    AriaLabel="Navigation rail preview" />
                </div>

                <p id="navigation-rail-preview-result" class="mb-design-system__result">
                    Selected: @this.NavigationRailPreviewViewModel.SelectedItemId.
                    Presentation: @this.NavigationRailPreviewViewModel.PresentationMode.
                </p>
            </article>

            <article class="mb-design-system__example mb-design-system__example--wide" data-component="app-header">
                <header class="mb-design-system__example-heading">
                    <h3>AppHeader</h3>
                    <p>Product identity, project context, search, actions, account content, and compact composition.</p>
                </header>

                <div class="mb-design-system__workspace-header-stack">
                    <AppHeader AriaLabel="Showcase application header">
                        <BrandContent>
                            <span class="mb-design-system__brand-mark" aria-hidden="true">B</span>
                            <strong>Bloom</strong>
                        </BrandContent>
                        <NavigationContent>
                            <BbButton
                                Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                Size="BlazorBlueprint.Components.ButtonSize.Small">
                                Projects
                            </BbButton>
                        </NavigationContent>
                        <ContextContent><span class="mb-design-system__workspace-context">Architecture</span></ContextContent>
                        <ProjectContent>
                            <ProjectSwitcher Items="this.ProjectItems"
                                             SelectedProjectId="@this.WorkspaceProjectId"
                                             SelectedProjectIdChanged="this.HandleWorkspaceProjectChanged"
                                             AriaLabel="Select header showcase project" />
                        </ProjectContent>
                        <CenterContent>
                            <SearchInput Id="workspace-header-search"
                                         Value="@this.WorkspaceSearchValue"
                                         ValueChanged="this.HandleWorkspaceSearchValueChanged"
                                         Placeholder="Search workspace"
                                         ShowShortcut="false"
                                         FullWidth="true" />
                        </CenterContent>
                        <ActionsContent>
                            <BbButton
                                Type="BlazorBlueprint.Components.ButtonType.Button"
                                Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                                AriaLabel="Share workspace"
                                title="Share workspace"
                                OnClick="this.HandleShareWorkspace">
                                <LucideIcon Name="share-2"
                                            Size="16"
                                            StrokeWidth="1.75"
                                            role="presentation"
                                            aria-hidden="true"
                                            focusable="false" />
                            </BbButton>
                            <BbButton
                                Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                                Size="BlazorBlueprint.Components.ButtonSize.Small"
                                OnClick="this.HandleValidateWorkspace">
                                Validate
                            </BbButton>
                        </ActionsContent>
                        <UserContent>
                            <UserMenu DisplayName="Alex Morgan"
                                      AvatarText="AM"
                                      Items="this.UserMenuItems"
                                      Compact="true"
                                      ItemSelected="this.HandleUserMenuItemSelected" />
                        </UserContent>
                    </AppHeader>

                    <AppHeader Compact="true" AriaLabel="Compact showcase application header">
                        <BrandContent><strong>Bloom compact</strong></BrandContent>
                        <ContextContent>
                            <BbBadge
                                Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                                Class="mb-design-system__badge mb-design-system__badge--info">
                                Review
                            </BbBadge>
                        </ContextContent>
                        <ActionsContent>
                            <BbButton
                                Type="BlazorBlueprint.Components.ButtonType.Button"
                                Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                                AriaLabel="Open compact header action"
                                title="Open compact header action"
                                OnClick="this.HandleCompactHeaderAction">
                                <LucideIcon Name="ellipsis"
                                            Size="16"
                                            StrokeWidth="1.75"
                                            role="presentation"
                                            aria-hidden="true"
                                            focusable="false" />
                            </BbButton>
                        </ActionsContent>
                    </AppHeader>
                </div>
                <p id="app-header-result" class="mb-design-system__result">
                    Search: @this.WorkspaceSearchValue. Latest action: @this.LastWorkspaceAction
                </p>
            </article>

            <article class="mb-design-system__example" data-component="canvas-toolbar">
                <header class="mb-design-system__example-heading">
                    <h3>Canvas toolbar composition</h3>
                    <p>Direct horizontal and vertical semantic tool groups.</p>
                </header>

                <div class="mb-design-system__canvas-toolbar-gallery">
                    <div class="mb-design-system__canvas-toolbar"
                         role="toolbar"
                         aria-label="Horizontal canvas tools"
                         aria-orientation="horizontal">
                        <BbButton
                            Type="BlazorBlueprint.Components.ButtonType.Button"
                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                            Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                            Class='@(this.GetCanvasToolbarToolCssClass("Select"))'
                            AriaLabel="Select element"
                            title="Select element"
                            aria-pressed='@(this.GetCanvasToolbarToolAriaPressed("Select"))'
                            OnClick='() => this.HandleCanvasToolbarToolChanged("Select")'>
                            <LucideIcon Name="mouse-pointer-2"
                                        Size="16"
                                        StrokeWidth="1.75"
                                        role="presentation"
                                        aria-hidden="true"
                                        focusable="false" />
                        </BbButton>
                        <BbButton
                            Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                            Size="BlazorBlueprint.Components.ButtonSize.Small"
                            OnClick='() => this.HandleCanvasToolbarAction("Connect")'>
                            Connect
                        </BbButton>
                        <BbButton
                            Type="BlazorBlueprint.Components.ButtonType.Button"
                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                            Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                            Class='@(this.GetCanvasToolbarToolCssClass("Note"))'
                            AriaLabel="Add note"
                            title="Add note"
                            aria-pressed='@(this.GetCanvasToolbarToolAriaPressed("Note"))'
                            OnClick='() => this.HandleCanvasToolbarToolChanged("Note")'>
                            <LucideIcon Name="sticky-note"
                                        Size="16"
                                        StrokeWidth="1.75"
                                        role="presentation"
                                        aria-hidden="true"
                                        focusable="false" />
                        </BbButton>
                    </div>

                    <div class="mb-design-system__canvas-toolbar mb-design-system__canvas-toolbar--vertical"
                         role="toolbar"
                         aria-label="Vertical canvas tools"
                         aria-orientation="vertical">
                        <BbButton
                            Type="BlazorBlueprint.Components.ButtonType.Button"
                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                            Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                            Class='@(this.GetCanvasToolbarToolCssClass("Move"))'
                            AriaLabel="Move canvas"
                            title="Move canvas"
                            aria-pressed='@(this.GetCanvasToolbarToolAriaPressed("Move"))'
                            OnClick='() => this.HandleCanvasToolbarToolChanged("Move")'>
                            <LucideIcon Name="move"
                                        Size="16"
                                        StrokeWidth="1.75"
                                        role="presentation"
                                        aria-hidden="true"
                                        focusable="false" />
                        </BbButton>
                        <BbButton
                            Type="BlazorBlueprint.Components.ButtonType.Button"
                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                            Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                            Class='@(this.GetCanvasToolbarToolCssClass("Center"))'
                            AriaLabel="Center selection"
                            title="Center selection"
                            aria-pressed='@(this.GetCanvasToolbarToolAriaPressed("Center"))'
                            OnClick='() => this.HandleCanvasToolbarToolChanged("Center")'>
                            <LucideIcon Name="focus"
                                        Size="16"
                                        StrokeWidth="1.75"
                                        role="presentation"
                                        aria-hidden="true"
                                        focusable="false" />
                        </BbButton>
                    </div>
                </div>
                <p id="canvas-toolbar-result" class="mb-design-system__result">Latest tool: @this.LastCanvasToolbarAction</p>
            </article>

            <article class="mb-design-system__example" data-component="zoom-controls">
                <header class="mb-design-system__example-heading">
                    <h3>ZoomControls</h3>
                    <p>Controlled zoom value with minimum, maximum, reset, and fit-to-view actions.</p>
                </header>

                <ZoomControls Zoom="@this.WorkspaceZoom"
                              ZoomChanged="this.HandleWorkspaceZoomChanged"
                              MinimumZoom="50"
                              MaximumZoom="150"
                              ZoomStep="25"
                              OnResetZoom="this.HandleResetWorkspaceZoom"
                              OnFitToView="this.HandleFitWorkspaceToView"
                              Compact="true" />
                <p id="zoom-controls-result" class="mb-design-system__result">@this.LastZoomAction</p>
            </article>

            <article class="mb-design-system__example mb-design-system__example--wide" data-component="status-bar">
                <header class="mb-design-system__example-heading">
                    <h3>StatusBar</h3>
                    <p>Leading state, long central information, and keyboard-accessible trailing actions.</p>
                </header>

                <StatusBar AriaLabel="Standalone showcase status" Compact="true">
                    <LeadingContent>
                        <BbBadge
                            Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                            Class="mb-design-system__badge mb-design-system__badge--success">
                            Ready
                        </BbBadge>
                    </LeadingContent>
                    <ChildContent>
                        <span>
                            Selected interface path: Platform / Thermal control / Radiator assembly / Temperature sensor allocation
                        </span>
                    </ChildContent>
                    <TrailingContent>
                        <span>125, 84</span>
                        <BbButton
                            Type="BlazorBlueprint.Components.ButtonType.Button"
                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                            Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                            AriaLabel="Open status details"
                            title="Open status details"
                            OnClick="this.HandleStatusDetails">
                            <LucideIcon Name="info"
                                        Size="16"
                                        StrokeWidth="1.75"
                                        role="presentation"
                                        aria-hidden="true"
                                        focusable="false" />
                        </BbButton>
                    </TrailingContent>
                </StatusBar>
                <p id="status-bar-result" class="mb-design-system__result">@this.LastStatusAction</p>
            </article>

            <article class="mb-design-system__example mb-design-system__example--wide" data-component="workspace-shell">
                <header class="mb-design-system__example-heading">
                    <h3>WorkspaceShell</h3>
                    <p>Independent header, panel, canvas, status, overlay, visibility, and scrolling regions.</p>
                </header>

                <div class="mb-design-system__inline-group">
                    <BbButton
                        id="toggle-workspace-left-panel"
                        Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                        Size="BlazorBlueprint.Components.ButtonSize.Small"
                        OnClick="this.ToggleWorkspaceLeftPanel">
                        @(this.WorkspaceLeftPanelVisible ? "Hide left panel" : "Show left panel")
                    </BbButton>
                    <BbButton
                        id="toggle-workspace-right-panel"
                        Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
                        Size="BlazorBlueprint.Components.ButtonSize.Small"
                        OnClick="this.ToggleWorkspaceRightPanel">
                        @(this.WorkspaceRightPanelVisible ? "Hide right panel" : "Show right panel")
                    </BbButton>
                </div>

                <div class="mb-design-system__workspace-shell-frame">
                    <WorkspaceShell AriaLabel="Showcase model workspace"
                                    LeftPanelVisible="@this.WorkspaceLeftPanelVisible"
                                    RightPanelVisible="@this.WorkspaceRightPanelVisible"
                                    LeftPanelAriaLabel="Sample element navigation"
                                    MainContentAriaLabel="Sample model canvas"
                                    RightPanelAriaLabel="Sample element details">
                        <Header>
                            <AppHeader Compact="true" AriaLabel="Workspace shell sample header">
                                <BrandContent><strong>Bloom</strong></BrandContent>
                                <ContextContent><span>Orbital Platform / Architecture</span></ContextContent>
                                <ActionsContent>
                                    <BbBadge
                                        Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                                        Class="mb-design-system__badge mb-design-system__badge--info">
                                        Local sample
                                    </BbBadge>
                                </ActionsContent>
                            </AppHeader>
                        </Header>
                        <LeftPanel>
                            <div class="mb-design-system__workspace-panel-content">
                                <strong>Model elements</strong>
                                @foreach (var item in this.WorkspaceNavigationItems)
                                {
                                    <button type="button" class="mb-design-system__workspace-row">@item</button>
                                }
                            </div>
                        </LeftPanel>
                        <MainContent>
                            <div class="mb-design-system__canvas-sample">
                                <div class="mb-design-system__canvas-toolbar-position">
                                     <div class="mb-design-system__canvas-toolbar"
                                          role="toolbar"
                                          aria-label="Workspace shell canvas tools"
                                          aria-orientation="horizontal">
                                        <BbButton
                                            Type="BlazorBlueprint.Components.ButtonType.Button"
                                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                            Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                                            Class="mb-design-system__canvas-toolbar-action"
                                            AriaLabel="Select shell element"
                                            title="Select shell element">
                                            <LucideIcon Name="mouse-pointer-2"
                                                        Size="16"
                                                        StrokeWidth="1.75"
                                                        role="presentation"
                                                        aria-hidden="true"
                                                        focusable="false" />
                                        </BbButton>
                                        <BbButton
                                            Type="BlazorBlueprint.Components.ButtonType.Button"
                                            Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                            Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                                            Class="mb-design-system__canvas-toolbar-action"
                                            AriaLabel="Connect shell elements"
                                            title="Connect shell elements">
                                            <LucideIcon Name="link-2"
                                                        Size="16"
                                                        StrokeWidth="1.75"
                                                        role="presentation"
                                                        aria-hidden="true"
                                                        focusable="false" />
                                        </BbButton>
                                    </div>
                                </div>
                                <div class="mb-design-system__diagram-node mb-design-system__diagram-node--primary">
                                    <strong>Vehicle</strong>
                                    <span>part definition</span>
                                </div>
                                <div class="mb-design-system__diagram-connector" aria-hidden="true"></div>
                                <div class="mb-design-system__diagram-node mb-design-system__diagram-node--secondary">
                                    <strong>Thermal control</strong>
                                    <span>subsystem</span>
                                </div>
                                <div class="mb-design-system__canvas-zoom-position">
                                    <ZoomControls Zoom="@this.WorkspaceZoom"
                                                  ZoomChanged="this.HandleWorkspaceZoomChanged"
                                                  MinimumZoom="50"
                                                  MaximumZoom="150"
                                                  ZoomStep="25"
                                                  OnResetZoom="this.HandleResetWorkspaceZoom"
                                                  OnFitToView="this.HandleFitWorkspaceToView"
                                                  Compact="true" />
                                </div>
                            </div>
                        </MainContent>
                        <RightPanel>
                            <div class="mb-design-system__workspace-panel-content">
                                <strong>Properties</strong>
                                @foreach (var item in this.WorkspacePropertyItems)
                                {
                                    <div class="mb-design-system__property-row">
                                        <span>@item</span>
                                        <strong>Sample value</strong>
                                    </div>
                                }
                            </div>
                        </RightPanel>
                        <StatusBar>
                            <Mycelium.Bloom.Components.UI.Organisms.StatusBar.StatusBar Compact="true" AriaLabel="Workspace shell sample status">
                                <LeadingContent>
                                    <BbBadge
                                        Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                                        Class="mb-design-system__badge mb-design-system__badge--success">
                                        Ready
                                    </BbBadge>
                                </LeadingContent>
                                <ChildContent><span>2 elements selected</span></ChildContent>
                                <TrailingContent><span>@this.WorkspaceZoom%</span></TrailingContent>
                            </Mycelium.Bloom.Components.UI.Organisms.StatusBar.StatusBar>
                        </StatusBar>
                        <OverlayContent>
                            <div class="mb-design-system__workspace-overlay-note">
                                <BbBadge
                                    Variant="BlazorBlueprint.Components.BadgeVariant.Outline"
                                    Class="mb-design-system__badge mb-design-system__badge--warning">
                                    Review sample
                                </BbBadge>
                            </div>
                        </OverlayContent>
                    </WorkspaceShell>
                </div>
                <p id="workspace-shell-result" class="mb-design-system__result">
                    Left panel: @(this.WorkspaceLeftPanelVisible ? "shown" : "hidden").
                    Right panel: @(this.WorkspaceRightPanelVisible ? "shown" : "hidden").
                </p>
            </article>

            <article class="mb-design-system__example mb-design-system__example--wide"
                     data-component="workspace-shell-optional-regions">
                <header class="mb-design-system__example-heading">
                    <h3>WorkspaceShell optional regions</h3>
                    <p>Independent compact instances prove omitted regions and the below-45rem pane switcher without adding nested main landmarks.</p>
                </header>

                <div class="mb-design-system__workspace-variants">
                    <div>
                        <span class="mb-design-system__state-label">Center only</span>
                        <div class="mb-design-system__workspace-variant-frame">
                            <WorkspaceShell AriaLabel="Center-only workspace"
                                            MainContentAriaLabel="Center-only model surface">
                                <MainContent>
                                    <div class="mb-design-system__workspace-variant-content">No header, panels, or status</div>
                                </MainContent>
                            </WorkspaceShell>
                        </div>
                    </div>

                    <div>
                        <span class="mb-design-system__state-label">Header and left panel</span>
                        <div class="mb-design-system__workspace-variant-frame">
                            <WorkspaceShell AriaLabel="Header and left-panel workspace"
                                            LeftPanelAriaLabel="Compact navigation"
                                            MainContentAriaLabel="Compact model surface">
                                <Header>
                                    <AppHeader Compact="true" AriaLabel="Compact optional-region header">
                                        <BrandContent><strong>Bloom</strong></BrandContent>
                                        <ContextContent><span>Header present</span></ContextContent>
                                    </AppHeader>
                                </Header>
                                <LeftPanel>
                                    <div class="mb-design-system__workspace-variant-content">Left panel</div>
                                </LeftPanel>
                                <MainContent>
                                    <div class="mb-design-system__workspace-variant-content">No right panel or status</div>
                                </MainContent>
                            </WorkspaceShell>
                        </div>
                    </div>

                    <div class="mb-design-system__workspace-variant--narrow">
                        <span class="mb-design-system__state-label">Narrow right panel and status</span>
                        <div class="mb-design-system__workspace-variant-frame">
                            <WorkspaceShell AriaLabel="Narrow optional-region workspace"
                                            MainContentAriaLabel="Narrow model surface"
                                            RightPanelAriaLabel="Narrow details">
                                <MainContent>
                                    <div class="mb-design-system__workspace-variant-content">No header or left panel</div>
                                </MainContent>
                                <RightPanel>
                                    <div class="mb-design-system__workspace-variant-content">Details</div>
                                </RightPanel>
                                <StatusBar>
                                    <Mycelium.Bloom.Components.UI.Organisms.StatusBar.StatusBar
                                        Compact="true"
                                        AriaLabel="Narrow workspace status">
                                        <ChildContent><span>Ready</span></ChildContent>
                                    </Mycelium.Bloom.Components.UI.Organisms.StatusBar.StatusBar>
                                </StatusBar>
                            </WorkspaceShell>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>

<ModalShell Id="showcase-modal"
            IsOpen="@this.ModalOpen"
            IsOpenChanged="this.HandleModalOpenChanged"
            OnClose="this.HandleModalClosed"
            FocusReturnTarget="@this.ModalFocusReturnTarget"
            Title="Inspect local component state"
            Description="This dialog uses deterministic page-owned data."
            Size="@this.ActiveModalSize"
            CloseOnBackdropClick="true">
    <ChildContent>
        <p class="mb-design-system__modal-copy">
            The modal body can compose any reusable Bloom controls without adding routing, services, or business logic.
        </p>
        <FieldShell ControlId="showcase-modal-field"
                    Label="Modal field"
                    ReadOnly="true">
            <BbInputGroup
                Class="mb-design-system__input-group mb-design-system__input-group--readonly">
                <BbInputGroupInput
                    Id="showcase-modal-field"
                    Value="Sample value"
                    UpdateTiming="BlazorBlueprint.Components.UpdateTiming.Immediate"
                    readonly="true" />
            </BbInputGroup>
        </FieldShell>
    </ChildContent>
    <FooterContent>
        <BbButton
            Variant="BlazorBlueprint.Components.ButtonVariant.Secondary"
            Size="BlazorBlueprint.Components.ButtonSize.Small"
            OnClick="this.CloseModal">
            Close
        </BbButton>
        <BbButton
            Size="BlazorBlueprint.Components.ButtonSize.Small"
            OnClick="this.CloseModal">
            Apply locally
        </BbButton>
    </FooterContent>
</ModalShell>

<ConfirmDialog IsOpen="@this.ConfirmDialogOpen"
               IsOpenChanged="this.HandleConfirmDialogOpenChanged"
               FocusReturnTarget="@this.ConfirmDialogFocusReturnTarget"
               Title="Confirm showcase action"
               Description="This action only updates local display state."
               Variant="@this.ActiveConfirmDialogVariant"
               IsConfirming="@this.ConfirmDialogIsConfirming"
               ConfirmText="Confirm action"
               CancelText="Cancel action"
               Confirmed="this.HandleConfirmed"
               Cancelled="this.HandleCancelled" />
