@using BlazorBlueprint.Primitives.Services
@inherits LayoutComponentBase

@* The layout hands the location to the organization context on every navigation. The portal host is required by
   the menus of the header. *@
<div class="mb-organization-layout">
    <OrganizationHeader />

    <main class="mb-organization-layout__main">
        <OrganizationContextView>
            @(this.Body)
        </OrganizationContextView>
    </main>
</div>

<BbPortalHost />
