@using BlazorBlueprint.Icons.Lucide.Components

<div class="mb-nav-menu">
    <div class="mb-nav-menu__brand">
        <a class="mb-nav-menu__brand-link" href="">
            <span class="mb-nav-menu__brand-mark" aria-hidden="true">
                <BrandMark />
            </span>
            <span>Mycelium - Bloom</span>
        </a>

        <button type="button"
                class="mb-nav-menu__toggle"
                aria-label="@(this.IsExpanded ? "Close primary navigation" : "Open primary navigation")"
                aria-expanded="@(this.IsExpanded ? "true" : "false")"
                aria-controls="bloom-primary-navigation"
                @onclick="this.ToggleNavigation">
            <LucideIcon Name="@(this.IsExpanded ? "x" : "menu")"
                        Size="16"
                        StrokeWidth="1.75"
                        Class="mb-nav-menu__icon"
                        role="presentation"
                        aria-hidden="true"
                        focusable="false" />
        </button>
    </div>

    <nav id="bloom-primary-navigation"
         class="@(this.GetLinksCssClass())"
         aria-label="Primary navigation">
        <NavLink
            class="mb-nav-menu__link"
            ActiveClass="mb-nav-menu__link--active"
            href=""
            Match="NavLinkMatch.All"
            @onclick="this.CloseNavigation">
            <LucideIcon Name="house"
                        Size="16"
                        StrokeWidth="1.75"
                        Class="mb-nav-menu__icon"
                        role="presentation"
                        aria-hidden="true"
                        focusable="false" />
            <span class="mb-nav-menu__label">Home</span>
        </NavLink>

        <NavLink
            class="mb-nav-menu__link"
            ActiveClass="mb-nav-menu__link--active"
            href="design-system"
            @onclick="this.CloseNavigation">
            <LucideIcon Name="grid-2x2"
                        Size="16"
                        StrokeWidth="1.75"
                        Class="mb-nav-menu__icon"
                        role="presentation"
                        aria-hidden="true"
                        focusable="false" />
            <span class="mb-nav-menu__label">Design System</span>
        </NavLink>

        <NavLink
            class="mb-nav-menu__link"
            ActiveClass="mb-nav-menu__link--active"
            href="ModelLoaderTest"
            @onclick="this.CloseNavigation">
            <LucideIcon Name="file-text"
                        Size="16"
                        StrokeWidth="1.75"
                        Class="mb-nav-menu__icon"
                        role="presentation"
                        aria-hidden="true"
                        focusable="false" />
            <span class="mb-nav-menu__label">Model Loader Test</span>
        </NavLink>
    </nav>
</div>
