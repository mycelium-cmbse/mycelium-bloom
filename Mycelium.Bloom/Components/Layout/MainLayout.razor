@using BlazorBlueprint.Primitives.Services

@inherits LayoutComponentBase

<div class="mb-main-layout">
    <div class="mb-main-layout__frame">
        <aside class="mb-main-layout__navigation">
            <NavMenu/>
        </aside>

        <main class="mb-main-layout__content">
            <header class="mb-main-layout__header">
                <a
                    href="https://learn.microsoft.com/aspnet/core/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mb-main-layout__about-link">
                    About
                </a>
            </header>

            <article class="mb-main-layout__body">
                @(this.Body)
            </article>
        </main>
    </div>
</div>

<BbPortalHost/>

<div
    id="blazor-error-ui"
    data-nosnippet
    class="mb-main-layout__error">
    An unhandled error has occurred.

    <a href=".">
        Reload
    </a>

    <span class="dismiss">
        🗙
    </span>
</div>
