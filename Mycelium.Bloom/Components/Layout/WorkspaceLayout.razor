@using BlazorBlueprint.Primitives.Services
@using BlazorBlueprint.Icons.Lucide.Components
@using Mycelium.Bloom.Components.UI.Organisms.NavigationRail

@inherits LayoutComponentBase

<CascadingValue Value="this.UrlContextService" IsFixed="true">
<CascadingValue Name="PropertiesRequested" Value="@(EventCallback.Factory.Create(this, this.RevealProperties))" IsFixed="true">
<div class="mb-workspace-layout">
    <WorkspaceShell @ref="this.workspaceShell" FullApplication="true"
                    LeftPanelCollapsed="this.isNavigationCollapsed"
                    RightPanelCollapsed="this.LayoutState.PropertiesCollapsed"
                    RightPanelResizable="true"
                    RightPanelWidth="this.LayoutState.PropertiesWidth"
                    RightPanelWidthChanged="this.HandlePropertiesWidthChanged"
                    RightPanelFocusReturnId="@(this.propertiesToggleId)"
                    RightPanelResizeLabel="Resize Properties"
                    RightPanelTestId="properties-region"
                    AriaLabel="Bloom engineering workspace"
                    HeaderAriaLabel="Application header"
                    LeftPanelAriaLabel="Workspace navigation"
                    MainContentAriaLabel="Workspace content"
                    RightPanelAriaLabel="Properties"
                    StatusBarAriaLabel="Workspace status"
                    CompactLeftPanelLabel="Navigation"
                    CompactMainContentLabel="Content"
                    CompactRightPanelLabel="Properties"
                    role="main">
        <Header>
            <AppHeader Compact="true"
                       AriaLabel="Bloom application header"
                       style="height: 48px; min-height: 48px;">
                <BrandContent>
                    <div class="mb-workspace-layout__brand">
                        <span class="sr-only">Bloom workspace</span>
                        <BrandMark style="width: 22.2px;" />
                    </div>
                </BrandContent>

                <ActionsContent>
                    <BbButton Type="BlazorBlueprint.Components.ButtonType.Button"
                              Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                              Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                              AriaLabel="@(this.GetDetailsPanelToggleLabel())"
                              title="@(this.GetDetailsPanelToggleLabel())"
                              id="@(this.propertiesToggleId)"
                              data-testid="properties-collapse"
                              aria-expanded="@(!this.LayoutState.PropertiesCollapsed ? "true" : "false")"
                              OnClick="this.ToggleDetailsPanel">
                        <LucideIcon Name="@(this.GetDetailsPanelToggleIconName())"
                                    Size="16"
                                    StrokeWidth="1.75"
                                    role="presentation"
                                    aria-hidden="true"
                                    focusable="false" />
                    </BbButton>

                    <BbDarkModeToggle Variant="BlazorBlueprint.Components.ButtonVariant.Ghost"
                                      Size="BlazorBlueprint.Components.ButtonSize.IconSmall"
                                      ShowLabel="false" />
                </ActionsContent>
            </AppHeader>
        </Header>

        <LeftPanel>
            <NavigationRail ViewModel="this.NavigationViewModel"
                            LayoutCollapsedChanged="this.HandleNavigationLayoutCollapsedChanged" />
        </LeftPanel>

        <MainContent>
            @(this.Body)
        </MainContent>

        <RightPanel>
            <DetailsPanel @ref="this.propertiesPanel" data-testid="workspace-details-panel" />
        </RightPanel>

        <StatusBar>
            <Mycelium.Bloom.Components.UI.Organisms.StatusBar.StatusBar AriaLabel="Workspace status" />
        </StatusBar>
    </WorkspaceShell>
</div>

<BbPortalHost />

<div id="blazor-error-ui"
     data-nosnippet
     class="mb-workspace-layout__error">
    An unhandled error has occurred.

    <a href=".">
        Reload
    </a>

    <button type="button"
            class="dismiss"
            aria-label="Dismiss error notification">
        🗙
    </button>
</div>
</CascadingValue>
</CascadingValue>
